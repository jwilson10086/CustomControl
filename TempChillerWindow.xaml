<Window x:Class="GeneralControl.TempChillerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:GeneralControl.Controls"
        Title="Chiller Check" Width="900" Height="520" WindowStartupLocation="CenterScreen"
        Background="#0E1A2B">
    <Canvas>
        <controls:GcChiller IsRunning="True" SetTemp="7.0" ActualTemp="7.8" Canvas.Left="30" Canvas.Top="30" />
        <controls:GcChiller IsRunning="False" SetTemp="7.0" ActualTemp="15.5" Canvas.Left="320" Canvas.Top="30" />
        <controls:GcChiller IsRunning="True" IsFault="True" SetTemp="7.0" ActualTemp="26.8" Canvas.Left="610" Canvas.Top="30" />
    </Canvas>
</Window>