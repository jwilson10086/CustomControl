<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:CustomControl.Controls">

    <!--
        ================================================================
        文件说明：Themes\Controls\GlassToolTip.xaml
        GlassToolTip 提示气泡样式。

        依赖：GlassBrushes.xaml（画刷资源）。
        注意：ToolTip 渲染在独立的 Popup 中，
        需确保 Popup 的 AllowsTransparency=true，否则透明效果可能失效。
        ================================================================
    -->

    <Style TargetType="controls:GlassToolTip">
        <Setter Property="Foreground" Value="{DynamicResource GlassTextBrush}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:GlassToolTip">
                    <Border Background="#E8141A26"
                            BorderBrush="{DynamicResource GlassEdgeHighlightBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="10,6">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="10"
                                              ShadowDepth="3"
                                              Opacity="0.4"
                                              Color="#000814" />
                        </Border.Effect>
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
