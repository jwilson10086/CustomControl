<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:CustomControl.Controls">

    <!--
        ================================================================
        文件说明：Themes\Controls\GlassPanel.xaml
        GlassPanel 面板样式：最简单的毛玻璃容器。

        与 GlassCard 的区别：
        - 没有 Header 标题
        - 没有 IsElevated 凸起效果
        - 没有顶部高光层
        - 模板极简：一个 Border + 一个 ContentPresenter
        适用于简单的分组容器场景。

        依赖：GlassBrushes.xaml（画刷资源）。
        ================================================================
    -->

    <Style TargetType="controls:GlassPanel">
        <Setter Property="Background" Value="{DynamicResource GlassBackdropBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource GlassEdgeHighlightBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:GlassPanel">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
