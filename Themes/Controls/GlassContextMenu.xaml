<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:CustomControl.Controls">

    <!--
        ================================================================
        文件说明：Themes\Controls\GlassContextMenu.xaml
        GlassContextMenu 右键菜单样式。

        依赖：GlassBrushes.xaml（画刷资源）、MenuItem.xaml（菜单项样式）。
        注意：右键菜单渲染在独立的 Popup 中，
        需确保 AllowsTransparency=true 才能正确显示毛玻璃透明效果。
        ================================================================
    -->

    <Style TargetType="controls:GlassContextMenu">
        <Setter Property="Foreground" Value="{DynamicResource GlassTextBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:GlassContextMenu">
                    <Border Background="#E8141A26"
                            BorderBrush="{DynamicResource GlassEdgeHighlightBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="4">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="20"
                                              ShadowDepth="7"
                                              Opacity="0.5"
                                              Color="#000814" />
                        </Border.Effect>
                        <StackPanel IsItemsHost="True"
                                    KeyboardNavigation.DirectionalNavigation="Cycle" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
