<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:CustomControl.Controls">

    <!--
        ================================================================
        文件说明：Themes\Controls\GlassNumericBox.xaml
        GlassNumericBox 数字输入框样式。

        依赖：GlassBrushes.xaml（画刷资源）。
        结构：Border(输入框外观，与 GlassTextBox 一致)
              → Grid(两列) → [内嵌 TextBox + 步进按钮组]

        【内嵌 TextBox 为什么要自带模板？】
        模板里嵌套的原生 TextBox 若不重定义模板，
        会套用系统默认外观（白色背景、灰色边框），破坏毛玻璃风格。
        这里只保留 PART_ContentHost（文本渲染约定部件），
        其余视觉全部交给外层 Border。

        【RepeatButton】
        加减按钮使用 RepeatButton：按住可连发 Click（Delay/Interval 由默认值提供），
        对应 GlassNumericBox.StepValue 的连续步进。
        ================================================================
    -->

    <Style TargetType="controls:GlassNumericBox">
        <Setter Property="Background" Value="{DynamicResource GlassControlBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource GlassBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource GlassTextBrush}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="MinWidth" Value="120" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:GlassNumericBox">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="9"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <!-- 数值编辑区 -->
                                <ColumnDefinition Width="*" />
                                <!-- 步进按钮组 -->
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!--
                                内嵌 TextBox：只保留内容宿主，无自身外观。
                                背景透明让点击空白处也能聚焦输入。
                            -->
                            <TextBox x:Name="PART_TextBox"
                                     Grid.Column="0"
                                     Margin="12,6"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     CaretBrush="#C0FFFFFF"
                                     SelectionBrush="#5E42BDFF"
                                     Foreground="{TemplateBinding Foreground}"
                                     FontSize="{TemplateBinding FontSize}"
                                     HorizontalAlignment="Stretch"
                                     VerticalAlignment="Center"
                                     VerticalContentAlignment="Center">
                                <TextBox.Template>
                                    <ControlTemplate TargetType="TextBox">
                                        <ScrollViewer x:Name="PART_ContentHost"
                                                      Focusable="False"
                                                      HorizontalScrollBarVisibility="Hidden"
                                                      VerticalScrollBarVisibility="Hidden" />
                                    </ControlTemplate>
                                </TextBox.Template>
                            </TextBox>

                            <!-- 加减按钮组：上下排列的窄条 -->
                            <StackPanel Grid.Column="1"
                                        Margin="0,4,4,4"
                                        Orientation="Vertical">
                                <RepeatButton x:Name="PART_IncreaseButton"
                                              Width="26" Height="14"
                                              Delay="350" Interval="90"
                                              Cursor="Hand"
                                              Focusable="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border x:Name="BtnBg"
                                                    Background="#1FFFFFFF"
                                                    CornerRadius="5,5,0,0">
                                                <Path Data="M0,3 L3.5,0 L7,3"
                                                      Stroke="#B8FFFFFF"
                                                      StrokeThickness="1.4"
                                                      StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="BtnBg" Property="Background" Value="#33FFFFFF" />
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="BtnBg" Property="Background" Value="#4DFFFFFF" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                                <RepeatButton x:Name="PART_DecreaseButton"
                                              Width="26" Height="14"
                                              Margin="0,2,0,0"
                                              Delay="350" Interval="90"
                                              Cursor="Hand"
                                              Focusable="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border x:Name="BtnBg"
                                                    Background="#1FFFFFFF"
                                                    CornerRadius="0,0,5,5">
                                                <Path Data="M0,0 L3.5,3 L7,0"
                                                      Stroke="#B8FFFFFF"
                                                      StrokeThickness="1.4"
                                                      StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="BtnBg" Property="Background" Value="#33FFFFFF" />
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="BtnBg" Property="Background" Value="#4DFFFFFF" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- 悬停：边框变亮（与 GlassTextBox 一致） -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource GlassBorderHoverBrush}" />
                        </Trigger>
                        <!-- 焦点在内部 TextBox 上时：蓝色边框 + 投影 -->
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource GlassAccentBrush}" />
                            <Setter TargetName="Root" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect BlurRadius="10" ShadowDepth="1" Opacity="0.4" Color="#4D6FE8" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
