<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:CustomControl.Controls">

    <!--
        ================================================================
        文件说明：Themes\Controls\GlassProgressBar.xaml
        GlassProgressBar 进度条样式（支持确定/不确定两种模式）。

        依赖：GlassBrushes.xaml（画刷资源）。
        ================================================================
    -->

    <Style TargetType="controls:GlassProgressBar">
        <Setter Property="Height" Value="8" />
        <Setter Property="Foreground" Value="{DynamicResource GlassAccentBrush}" />
        <Setter Property="Background" Value="#26FFFFFF" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:GlassProgressBar">
                    <Border x:Name="Track"
                            Background="{TemplateBinding Background}"
                            CornerRadius="4"
                            ClipToBounds="True">
                        <Grid>
                            <Border x:Name="PART_Indicator"
                                    HorizontalAlignment="Left"
                                    CornerRadius="4"
                                    Background="{TemplateBinding Foreground}" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- 不确定模式：指示条半透明并循环滚动 -->
                        <Trigger Property="IsIndeterminate" Value="True">
                            <Setter TargetName="PART_Indicator" Property="Opacity" Value="0.6" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="PART_Indicator"
                                                         Storyboard.TargetProperty="Width"
                                                         From="60" To="260"
                                                         Duration="0:0:1.1" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
