<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:CustomControl.Controls">

    <!--
        ================================================================
        文件说明：Themes\Controls\GlassExpander.xaml
        GlassExpander 折叠面板样式（标题栏 + 可展开内容区）。

        依赖：GlassBrushes.xaml（画刷资源）。
        ================================================================
    -->

    <Style TargetType="controls:GlassExpander">
        <Setter Property="Foreground" Value="{DynamicResource GlassTextBrush}" />
        <Setter Property="Background" Value="{DynamicResource GlassBackdropBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource GlassEdgeHighlightBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:GlassExpander">
                    <Border Background="Transparent"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <!--
                                HeaderSite：标题栏切换按钮
                                IsChecked 双向绑定到控件的 IsExpanded，
                                点击标题即可展开/折叠。
                            -->
                            <ToggleButton x:Name="HeaderSite"
                                          Grid.Row="0"
                                          IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          Cursor="Hand"
                                          FocusVisualStyle="{x:Null}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent" Padding="14,11">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <ContentPresenter Content="{Binding Header, RelativeSource={RelativeSource TemplatedParent}}"
                                                                  VerticalAlignment="Center"
                                                                  TextElement.FontWeight="SemiBold"
                                                                  TextElement.FontSize="13" />
                                                <Path Grid.Column="1"
                                                      x:Name="ChevronDown"
                                                      Data="M 1 1 L 5 5 L 9 1"
                                                      Stroke="{DynamicResource GlassTextSecondaryBrush}"
                                                      StrokeThickness="1.8"
                                                      StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round"
                                                      VerticalAlignment="Center" />
                                                <Path Grid.Column="1"
                                                      x:Name="ChevronUp"
                                                      Data="M 1 5 L 5 1 L 9 5"
                                                      Stroke="{DynamicResource GlassTextSecondaryBrush}"
                                                      StrokeThickness="1.8"
                                                      StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round"
                                                      VerticalAlignment="Center"
                                                      Visibility="Collapsed" />
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Cursor" Value="Hand" />
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="ChevronDown" Property="Visibility" Value="Collapsed" />
                                                <Setter TargetName="ChevronUp" Property="Visibility" Value="Visible" />
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="False">
                                                <Setter TargetName="ChevronDown" Property="Visibility" Value="Visible" />
                                                <Setter TargetName="ChevronUp" Property="Visibility" Value="Collapsed" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="ExpandSite"
                                              Grid.Row="1"
                                              Margin="14,0,14,14"
                                              Visibility="Collapsed"
                                              Focusable="False" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="True">
                            <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
