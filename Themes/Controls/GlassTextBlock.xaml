<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:CustomControl.Controls">

    <!--
        ================================================================
        文件说明：Themes\Controls\GlassTextBlock.xaml
        GlassTextBlock 文本块样式（半透明白色正文）。

        依赖：GlassBrushes.xaml（画刷资源）。
        ================================================================
    -->

    <Style TargetType="controls:GlassTextBlock">
        <Setter Property="Foreground" Value="{DynamicResource GlassTextSecondaryBrush}" />
        <Setter Property="FontSize" Value="13" />
    </Style>

</ResourceDictionary>
