<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:CustomControl.Controls">

    <!--
        ================================================================
        文件说明：Themes\Controls\GlassCheckBox.xaml
        GlassCheckBox 复选框样式（支持三态：选中/未选中/不确定）。

        依赖：GlassBrushes.xaml（画刷资源）。
        ================================================================
    -->

    <Style TargetType="controls:GlassCheckBox">
        <Setter Property="Foreground" Value="{DynamicResource GlassTextBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:GlassCheckBox">
                    <StackPanel Orientation="Horizontal">
                        <Border x:Name="Box"
                                Width="20" Height="20"
                                CornerRadius="6"
                                Background="{DynamicResource GlassControlBrush}"
                                BorderBrush="{DynamicResource GlassBorderBrush}"
                                BorderThickness="1"
                                VerticalAlignment="Center">
                            <Grid>
                                <Path x:Name="CheckMark"
                                      Data="M 3.5 9.5 L 8 14 L 16.5 4.5"
                                      Stroke="White"
                                      StrokeThickness="2.2"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      Stretch="Uniform"
                                      Margin="3.5"
                                      Visibility="Collapsed" />
                                <Rectangle x:Name="IndeterminateBar"
                                           Width="10" Height="3"
                                           RadiusX="1.5" RadiusY="1.5"
                                           Fill="White"
                                           Visibility="Collapsed" />
                            </Grid>
                        </Border>
                        <ContentPresenter Margin="8,0,0,0"
                                          VerticalAlignment="Center"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource GlassControlHoverBrush}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource GlassBorderHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource GlassAccentBrush}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="#60FFFFFF" />
                            <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="{x:Null}">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource GlassControlHoverBrush}" />
                            <Setter TargetName="IndeterminateBar" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
