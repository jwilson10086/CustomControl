<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:CustomControl.Controls">

    <!--
        ================================================================
        文件说明：Themes\Controls\GlassToggleButton.xaml
        GlassToggleButton 切换按钮样式。

        依赖：GlassBrushes.xaml（画刷资源）。
        ================================================================
    -->

    <!--
        ===================== 切换按钮样式 =====================
        GlassToggleButton：可以切换开/关状态的按钮。
        与普通按钮的区别：多了 IsChecked 属性和对应的触发器。
        选中时背景变为蓝色强调色（GlassAccentBrush），直观表示"已开启"。
        典型用途：设置页面的开关、功能启用/禁用切换。
    -->
    <Style TargetType="controls:GlassToggleButton">
        <Setter Property="Background" Value="{DynamicResource GlassControlBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource GlassBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource GlassTextBrush}" />
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:GlassToggleButton">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="9">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- 悬停：使用悬停画刷 -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource GlassControlHoverBrush}" />
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource GlassBorderHoverBrush}" />
                        </Trigger>
                        <!--
                            IsChecked = True：选中状态
                            背景切换为蓝色强调色渐变，边框变为白色半透明。
                            这是切换按钮最关键的视觉状态，让用户一眼看出开关状态。
                        -->
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource GlassAccentBrush}" />
                            <Setter TargetName="Root" Property="BorderBrush" Value="#55FFFFFF" />
                        </Trigger>
                        <!-- 按下：整体透明度降到80%，提供按压反馈 -->
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Opacity" Value="0.8" />
                        </Trigger>
                        <!-- 禁用：降低透明度 -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
