<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:CustomControl.Controls">

    <!--
        ================================================================
        文件说明：Themes\Controls\GlassTank.xaml
        GlassTank 工业槽体 / 液位罐样式。

        依赖：GlassBrushes.xaml（画刷资源）。
        结构：Border(罐体，上直角下圆角) → Grid
              → [PART_Liquid(底部锚定液位块) + PART_Percent(百分比)]

        【液位高度】由代码后置（GlassTank.UpdateLevel）按 Level 百分比换算，
        并随控件 SizeChanged 自动重算。
        ================================================================
    -->

    <Style TargetType="controls:GlassTank">
        <Setter Property="Width" Value="90" />
        <Setter Property="Height" Value="120" />
        <!-- 默认液体画刷：强调色渐变（半透明，玻璃质感） -->
        <Setter Property="LiquidBrush">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#664FB6FF" Offset="0" />
                    <GradientStop Color="#8C8C7BFF" Offset="1" />
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:GlassTank">
                    <Border x:Name="Root"
                            Background="#1FFFFFFF"
                            BorderBrush="{DynamicResource GlassEdgeHighlightBrush}"
                            BorderThickness="1"
                            CornerRadius="6,6,14,14"
                            ClipToBounds="True"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <!-- 液位块：底部锚定，高度由代码控制 -->
                            <Border x:Name="PART_Liquid"
                                    VerticalAlignment="Bottom"
                                    Margin="1"
                                    CornerRadius="0,0,13,13"
                                    Background="{TemplateBinding LiquidBrush}" />

                            <!-- 百分比文字 -->
                            <TextBlock x:Name="PART_Percent"
                                       Text="0%"
                                       Foreground="#F2FFFFFF"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
