<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:CustomControl.Controls">

    <!--
        ================================================================
        文件说明：Themes\Controls\GlassCylinder.xaml
        GlassCylinder 工业气缸样式（侧视图）。

        依赖：GlassBrushes.xaml（画刷资源）。
        结构：Viewbox → 110x36 画布
              → [缸体 + 端盖 + 进气口 + 活塞组(PART_PistonGroup)]

        【活塞组】包含活塞头与活塞杆（刚性连接，物理上一起平移）。
        代码后置按 Extension 百分比设置 RenderTransform 平移量：
        - 0   = 缩回（杆几乎缩进缸体）
        - 100 = 完全伸出（大部分杆露在右端盖外）
        毛玻璃缸体是半透明的，活塞在内部清晰可见。
        ================================================================
    -->

    <Style TargetType="controls:GlassCylinder">
        <Setter Property="Width" Value="110" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:GlassCylinder">
                    <Viewbox Stretch="Uniform">
                        <Canvas Width="110" Height="36">
                            <!-- 活塞组：先画（位于缸体下层不可见部分会被玻璃体罩色） -->
                            <Canvas x:Name="PART_PistonGroup" Width="110" Height="36">
                                <Canvas.RenderTransform>
                                    <TranslateTransform X="0" Y="0" />
                                </Canvas.RenderTransform>
                                <!-- 活塞杆：从活塞一直延伸到右端外侧 -->
                                <Rectangle Canvas.Left="7" Canvas.Top="15"
                                           Width="54" Height="6"
                                           RadiusX="3" RadiusY="3"
                                           Fill="#D8FFFFFF" />
                                <!-- 活塞头 -->
                                <Rectangle Canvas.Left="0" Canvas.Top="7"
                                           Width="7" Height="22"
                                           RadiusX="2" RadiusY="2"
                                           Fill="#B8FFFFFF" />
                            </Canvas>

                            <!-- 缸体：半透明玻璃圆管 -->
                            <Rectangle Canvas.Left="2" Canvas.Top="4"
                                       Width="56" Height="28"
                                       RadiusX="5" RadiusY="5"
                                       Fill="#26FFFFFF"
                                       Stroke="{DynamicResource GlassEdgeHighlightBrush}"
                                       StrokeThickness="1.4" />

                            <!-- 左端盖 -->
                            <Rectangle Canvas.Left="2" Canvas.Top="2"
                                       Width="6" Height="32"
                                       RadiusX="2" RadiusY="2"
                                       Fill="#4DFFFFFF"
                                       Stroke="{DynamicResource GlassEdgeHighlightBrush}"
                                       StrokeThickness="1" />
                            <!-- 右端盖（带杆孔） -->
                            <Rectangle Canvas.Left="52" Canvas.Top="2"
                                       Width="6" Height="32"
                                       RadiusX="2" RadiusY="2"
                                       Fill="#4DFFFFFF"
                                       Stroke="{DynamicResource GlassEdgeHighlightBrush}"
                                       StrokeThickness="1" />

                            <!-- 进气口：左右各一 -->
                            <Rectangle Canvas.Left="12" Canvas.Top="30"
                                       Width="6" Height="4"
                                       RadiusX="1" RadiusY="1"
                                       Fill="#8CFFFFFF" />
                            <Rectangle Canvas.Left="42" Canvas.Top="30"
                                       Width="6" Height="4"
                                       RadiusX="1" RadiusY="1"
                                       Fill="#8CFFFFFF" />
                        </Canvas>
                    </Viewbox>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
