<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:CustomControl.Controls">

    <!--
        ================================================================
        文件说明：Themes\Controls\GlassPump.xaml
        GlassPump 工业泵样式（涡壳 + 叶轮符号）。

        【几何基准】（所有坐标以控件中心为基准，杜绝偏心）
        涡壳圆心 = 控件中心 (24,24)，半径 18（圆占 x/y 6~42）。
        吸入短管 x0~8、出口短管 x43~48，端面齐平控件左右边缘。
        出口三角 (38,19)(48,24)(38,29)：对称轴 y=24 过圆心，顶点抵右缘。

        【端口衔接】
        左右短管端面都画到控件边缘，相邻 GlassPipe 端点稍微伸入即可无缝搭接。

        【状态模型】
        - IsRunning=true：叶轮持续旋转，SpinDirection 决定正/反转；
          （ExitActions 停止故事板——否则停泵后动画不会停）
        - IsFault=true：红色警示；
        - OutletDirection：旋转 PART_Outlet 到 0/90/180/270 度。
        ================================================================
    -->

    <Style TargetType="controls:GlassPump">
        <Setter Property="Width" Value="48" />
        <Setter Property="Height" Value="48" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:GlassPump">
                    <!-- Stretch=Fill：Width/Height 直接控制内容长宽（组态编辑时拖宽拖高即时生效）；
                         Uniform 会等比限制，编辑器中"拉宽"看起来无效 -->
                    <Viewbox Stretch="Fill"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center">
                        <Canvas Width="48" Height="48">

                            <!-- 吸入口短管（固定左侧，端面齐平左缘，中心线 y=24） -->
                            <Rectangle Canvas.Left="0" Canvas.Top="21"
                                       Width="8" Height="6"
                                       Fill="#33FFFFFF" />

                            <!-- 叶轮组：三片直叶 + 中心毂（先叶片后毂盖根），
                                 全部绕涡壳圆心 (24,24) 旋转 -->
                            <Canvas x:Name="PART_Impeller" Width="48" Height="48" Opacity="0.45">
                                <Canvas.RenderTransform>
                                    <RotateTransform CenterX="24" CenterY="24" Angle="0" />
                                </Canvas.RenderTransform>
                                <!-- 三片叶先画：叶根距圆心3藏入毂下，叶尖距圆心14留出涡壳间隙 -->
                                <Rectangle Canvas.Left="22.5" Canvas.Top="10"
                                           Width="3" Height="11"
                                           RadiusX="1.5" RadiusY="1.5"
                                           Fill="#99FFFFFF" />
                                <!-- 旋转副本包一层同尺寸画布，使局部坐标与外层重合，
                                     RotateTransform 的 CenterX/CenterY 才是涡壳圆心 (24,24) -->
                                <Canvas Width="48" Height="48">
                                    <Canvas.RenderTransform>
                                        <RotateTransform CenterX="24" CenterY="24" Angle="120" />
                                    </Canvas.RenderTransform>
                                    <Rectangle Canvas.Left="22.5" Canvas.Top="10"
                                               Width="3" Height="11"
                                               RadiusX="1.5" RadiusY="1.5"
                                               Fill="#99FFFFFF" />
                                </Canvas>
                                <Canvas Width="48" Height="48">
                                    <Canvas.RenderTransform>
                                        <RotateTransform CenterX="24" CenterY="24" Angle="240" />
                                    </Canvas.RenderTransform>
                                    <Rectangle Canvas.Left="22.5" Canvas.Top="10"
                                               Width="3" Height="11"
                                               RadiusX="1.5" RadiusY="1.5"
                                               Fill="#99FFFFFF" />
                                </Canvas>
                                <!-- 中心毂最后绘制，盖住三处叶根，衔接无缝；圆心 (24,24) -->
                                <Ellipse Canvas.Left="20.5" Canvas.Top="20.5"
                                         Width="7" Height="7"
                                         Fill="#B8FFFFFF" />
                            </Canvas>

                            <!-- 涡壳：外圈玻璃圆，圆心 = 控件中心 (24,24) -->
                            <Ellipse x:Name="Volute"
                                     Canvas.Left="6" Canvas.Top="6"
                                     Width="36" Height="36"
                                     Fill="#1FFFFFFF"
                                     Stroke="{DynamicResource GlassEdgeHighlightBrush}"
                                     StrokeThickness="1.6" />

                            <!-- 排出口组：三角 + 短管，整体绕涡壳圆心 (24,24) 旋转（默认朝右） -->
                            <Canvas x:Name="PART_Outlet" Width="48" Height="48">
                                <Canvas.RenderTransform>
                                    <RotateTransform CenterX="24" CenterY="24" Angle="0" />
                                </Canvas.RenderTransform>
                                <!-- 三角：对称轴 y=24 过圆心，顶点 (48,24) 抵控件右缘 -->
                                <Polygon Points="38,19 48,24 38,29"
                                         Fill="#3DFFFFFF"
                                         Stroke="{DynamicResource GlassEdgeHighlightBrush}"
                                         StrokeThickness="1" />
                                <!-- 出口短管：端面画到 x=48，与右侧管路齐平搭接 -->
                                <Rectangle Canvas.Left="43" Canvas.Top="21"
                                           Width="5" Height="6"
                                           Fill="#33FFFFFF" />
                            </Canvas>
                        </Canvas>
                    </Viewbox>
                    <ControlTemplate.Triggers>
                        <!-- ===== 排出口方向：绕涡壳圆心 (24,24) 旋转出口组 ===== -->
                        <Trigger Property="OutletDirection" Value="Down">
                            <Setter TargetName="PART_Outlet" Property="RenderTransform">
                                <Setter.Value>
                                    <RotateTransform CenterX="24" CenterY="24" Angle="90" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="OutletDirection" Value="Left">
                            <Setter TargetName="PART_Outlet" Property="RenderTransform">
                                <Setter.Value>
                                    <RotateTransform CenterX="24" CenterY="24" Angle="180" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="OutletDirection" Value="Up">
                            <Setter TargetName="PART_Outlet" Property="RenderTransform">
                                <Setter.Value>
                                    <RotateTransform CenterX="24" CenterY="24" Angle="270" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>

                        <!-- ===== 运行：叶轮旋转（按 SpinDirection 选故事板，
                                 ExitActions 必须停止，否则停泵后仍在转） ===== -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsRunning" Value="True" />
                                <Condition Property="SpinDirection" Value="Clockwise" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="PART_Impeller" Property="Opacity" Value="1" />
                            <MultiTrigger.EnterActions>
                                <BeginStoryboard x:Name="SpinClockwise">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="PART_Impeller"
                                                         Storyboard.TargetProperty="RenderTransform.Angle"
                                                         From="0" To="360"
                                                         Duration="0:0:1.6" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiTrigger.EnterActions>
                            <MultiTrigger.ExitActions>
                                <StopStoryboard BeginStoryboardName="SpinClockwise" />
                            </MultiTrigger.ExitActions>
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsRunning" Value="True" />
                                <Condition Property="SpinDirection" Value="Counterclockwise" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="PART_Impeller" Property="Opacity" Value="1" />
                            <MultiTrigger.EnterActions>
                                <BeginStoryboard x:Name="SpinCounterClockwise">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="PART_Impeller"
                                                         Storyboard.TargetProperty="RenderTransform.Angle"
                                                         From="0" To="-360"
                                                         Duration="0:0:1.6" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiTrigger.EnterActions>
                            <MultiTrigger.ExitActions>
                                <StopStoryboard BeginStoryboardName="SpinCounterClockwise" />
                            </MultiTrigger.ExitActions>
                        </MultiTrigger>

                        <!-- 故障：红色警示 -->
                        <Trigger Property="IsFault" Value="True">
                            <Setter TargetName="Volute" Property="Fill" Value="#33E85555" />
                            <Setter TargetName="Volute" Property="Stroke" Value="#FF8080" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
