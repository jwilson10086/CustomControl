<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:CustomControl.Controls">

    <!--
        ================================================================
        文件说明：Themes\Controls\GlassFlowMeter.xaml
        GlassFlowMeter 流量计样式（Keyence 风格数显面板）。

        依赖：GlassBrushes.xaml（画刷资源）。
        结构：玻璃圆角面板（填满控件）
              → [标题行：FLOW 标签 + RUN 灯 PART_RunDot（流动时呼吸闪烁）
                 + 读数行：大字数值 + 单位（字号由代码后置按 ActualHeight 比例驱动，
                 任意长宽比下都跟随控件尺寸变化）
                 + 量程条：PART_Bar（ScaleX 由代码后置按 Value 设置）]

        【PART_Bar】RenderTransform 必须是 ScaleTransform，原点在左缘；
        模板密封会冻结它，代码后置已做 Clone 处理。
        ================================================================
    -->

    <Style TargetType="controls:GlassFlowMeter">
        <Setter Property="Width" Value="112" />
        <Setter Property="Height" Value="56" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:GlassFlowMeter">
                    <!-- 面板直接填满控件；字号由代码后置按 ActualHeight 比例驱动，
                         任意长宽比下文字都跟随控件尺寸 -->
                    <Border CornerRadius="10"
                            Background="#14FFFFFF"
                            BorderBrush="{DynamicResource GlassEdgeHighlightBrush}"
                            BorderThickness="1">
                        <Grid Margin="12,8,12,9">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- 标题行 -->
                            <Grid Grid.Row="0">
                                <TextBlock x:Name="PART_TitleText"
                                           Text="FLOW" FontSize="9" FontWeight="SemiBold"
                                           Foreground="#8CFFFFFF" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Ellipse Width="5" Height="5" Fill="#33FF8080" />
                                    <Ellipse x:Name="PART_RunDot"
                                             Width="6" Height="6" Margin="4,0,0,0"
                                             Fill="#35D07F" Opacity="0.25" />
                                </StackPanel>
                            </Grid>

                            <!-- 读数行：大字 + 单位 -->
                            <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                                <TextBlock x:Name="PART_ValueText"
                                           FontSize="18" FontWeight="Bold" Foreground="#E6FFFFFF"
                                           VerticalAlignment="Bottom"
                                           Text="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, StringFormat={}{0:0.#}}" />
                                <TextBlock x:Name="PART_UnitText"
                                           Margin="2,0,0,1" FontSize="10" Foreground="#8CFFFFFF"
                                           VerticalAlignment="Bottom"
                                           Text="{TemplateBinding Unit}" />
                            </StackPanel>

                            <!-- 量程条 -->
                            <Border Grid.Row="2" Height="4" Margin="0,0,0,0"
                                    CornerRadius="2" Background="#1FFFFFFF">
                                <Rectangle x:Name="PART_Bar"
                                           Fill="{DynamicResource GlassAccentBrush}"
                                           RadiusX="2" RadiusY="2"
                                           RenderTransformOrigin="0,0.5">
                                    <Rectangle.RenderTransform>
                                        <ScaleTransform ScaleX="0.02" />
                                    </Rectangle.RenderTransform>
                                </Rectangle>
                            </Border>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- 流动中：RUN 灯呼吸闪烁；停止时回到暗态 -->
                        <Trigger Property="IsFlowing" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="RunDotStoryboard">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="PART_RunDot"
                                                         Storyboard.TargetProperty="Opacity"
                                                         From="1" To="0.25"
                                                         AutoReverse="True"
                                                         Duration="0:0:0.8" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <StopStoryboard BeginStoryboardName="RunDotStoryboard" />
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
