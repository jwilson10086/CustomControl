<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        拟物 Neumorphism 主题 —— 基于 ui-ux-pro-max skill 规范
        双阴影: -5px -5px 15px 亮 / 5px 5px 15px 暗
        圆角: 14px
        渐变: linear-gradient(145deg, ...)
        配色: 柔和灰 #F5F5F5 / #E8E8E8
    -->

    <!--  主文字：纯黑  -->
    <SolidColorBrush x:Key="GcTextBrush" Color="#0F0F12" />
    <!--  次要文字  -->
    <SolidColorBrush x:Key="GcTextSecondaryBrush" Color="#4A4A52" />

    <!--  卡片背景：145° 渐变，左上亮→右下暗  -->
    <LinearGradientBrush x:Key="GcBackdropBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#F0F0F3" />
        <GradientStop Offset="0.5" Color="#E8E8EC" />
        <GradientStop Offset="1" Color="#E0E0E5" />
    </LinearGradientBrush>

    <!--  控件默认背景：凸起渐变  -->
    <LinearGradientBrush x:Key="GcControlBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#F0F0F3" />
        <GradientStop Offset="1" Color="#E6E6EA" />
    </LinearGradientBrush>

    <!--  悬停：提亮  -->
    <LinearGradientBrush x:Key="GcControlHoverBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#F8F8FB" />
        <GradientStop Offset="1" Color="#EEEEF2" />
    </LinearGradientBrush>

    <!--  按下：凹刻，反转渐变  -->
    <LinearGradientBrush x:Key="GcControlPressedBrush" StartPoint="1,1" EndPoint="0,0">
        <GradientStop Offset="0" Color="#DDDEE2" />
        <GradientStop Offset="1" Color="#E8E8EC" />
    </LinearGradientBrush>

    <!--  强调色：柔和蓝  -->
    <LinearGradientBrush x:Key="GcAccentBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#A8C8F0" />
        <GradientStop Offset="1" Color="#88AAE0" />
    </LinearGradientBrush>

    <!--  边框：柔和灰  -->
    <SolidColorBrush x:Key="GcBorderBrush" Color="#D8D8DD" />
    <!--  悬停边框  -->
    <SolidColorBrush x:Key="GcBorderHoverBrush" Color="#C0C0C8" />

    <!--  顶部高光  -->
    <LinearGradientBrush x:Key="GcTopHighlightBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#60FFFFFF" />
        <GradientStop Offset="0.3" Color="#20FFFFFF" />
        <GradientStop Offset="1" Color="#00FFFFFF" />
    </LinearGradientBrush>

    <!--  边缘高光：左上受光白、右下背光影  -->
    <LinearGradientBrush x:Key="GcEdgeHighlightBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#FFFFFF" />
        <GradientStop Offset="0.4" Color="#E8E8EC" />
        <GradientStop Offset="0.7" Color="#D0D0D5" />
        <GradientStop Offset="1" Color="#B8B8C0" />
    </LinearGradientBrush>

    <!--  ===================== 扩展令牌 =====================  -->

    <!--  阴影色：暗面（右下）  -->
    <SolidColorBrush x:Key="NeuShadowDark" Color="#A0A0A8" />
    <!--  阴影色：亮面（左上）  -->
    <SolidColorBrush x:Key="NeuShadowLight" Color="#FFFFFF" />

    <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />

</ResourceDictionary>
