<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:GeneralControl.Controls">

    <!--  拟物 DataGrid：凸起背景 + 凹刻行  -->

    <Style TargetType="controls:GcDataGrid">
        <Setter Property="Background" Value="{DynamicResource GcControlBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource GcTextBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="RowBackground" Value="Transparent" />
        <Setter Property="AlternatingRowBackground" Value="#08000000" />
        <Setter Property="HorizontalGridLinesBrush" Value="#12000000" />
        <Setter Property="VerticalGridLinesBrush" Value="#08000000" />
        <Setter Property="GridLinesVisibility" Value="Horizontal" />
        <Setter Property="HeadersVisibility" Value="All" />
        <Setter Property="CanUserAddRows" Value="False" />
        <Setter Property="CanUserDeleteRows" Value="False" />
        <Setter Property="CanUserResizeRows" Value="False" />
        <Setter Property="CanUserSortColumns" Value="True" />
        <Setter Property="AutoGenerateColumns" Value="True" />
        <Setter Property="RowHeaderWidth" Value="0" />
        <Setter Property="SelectionMode" Value="Single" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:GcDataGrid">
                    <Grid SnapsToDevicePixels="True">
                        <!--  暗面  -->
                        <Border Background="Transparent" CornerRadius="14">
                            <Border.Effect>
                                <DropShadowEffect
                                    BlurRadius="9"
                                    Direction="315"
                                    Opacity="0.45"
                                    RenderingBias="Quality"
                                    ShadowDepth="3"
                                    Color="#A0A0A8" />
                            </Border.Effect>
                        </Border>
                        <!--  亮面  -->
                        <Border Background="Transparent" CornerRadius="14">
                            <Border.Effect>
                                <DropShadowEffect
                                    BlurRadius="9"
                                    Direction="135"
                                    Opacity="0.6"
                                    RenderingBias="Quality"
                                    ShadowDepth="3"
                                    Color="#FFFFFF" />
                            </Border.Effect>
                        </Border>
                        <!--  背景  -->
                        <Border
                            Background="{TemplateBinding Background}"
                            ClipToBounds="True"
                            CornerRadius="14"
                            SnapsToDevicePixels="True" />
                        <Border
                            Background="{DynamicResource GcTopHighlightBrush}"
                            CornerRadius="14"
                            IsHitTestVisible="False"
                            SnapsToDevicePixels="True" />
                        <!--  内容  -->
                        <ScrollViewer
                            x:Name="DG_ScrollViewer"
                            Focusable="False"
                            SnapsToDevicePixels="True">
                            <ScrollViewer.Template>
                                <ControlTemplate TargetType="ScrollViewer">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Button
                                            Width="Auto"
                                            Command="SelectAll"
                                            Focusable="False"
                                            Visibility="Visible" />
                                        <DataGridColumnHeadersPresenter
                                            x:Name="PART_ColumnHeadersPresenter"
                                            Grid.Column="1"
                                            Visibility="Visible" />
                                        <ScrollContentPresenter
                                            x:Name="PART_ScrollContentPresenter"
                                            Grid.Row="1"
                                            Grid.ColumnSpan="2"
                                            CanContentScroll="{TemplateBinding CanContentScroll}"
                                            CanHorizontallyScroll="False"
                                            CanVerticallyScroll="False"
                                            Content="{TemplateBinding Content}"
                                            ContentStringFormat="{TemplateBinding ContentStringFormat}"
                                            ContentTemplate="{TemplateBinding ContentTemplate}" />
                                        <ScrollBar
                                            x:Name="PART_VerticalScrollBar"
                                            Grid.Row="1"
                                            Grid.Column="2"
                                            Maximum="{TemplateBinding ScrollableHeight}"
                                            Orientation="Vertical"
                                            Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"
                                            Value="{TemplateBinding VerticalOffset}" />
                                        <Grid Grid.Row="2" Grid.Column="1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <ScrollBar
                                                x:Name="PART_HorizontalScrollBar"
                                                Grid.Column="1"
                                                Maximum="{TemplateBinding ScrollableWidth}"
                                                Orientation="Horizontal"
                                                Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}"
                                                Value="{TemplateBinding HorizontalOffset}" />
                                        </Grid>
                                    </Grid>
                                </ControlTemplate>
                            </ScrollViewer.Template>
                            <ItemsPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                        </ScrollViewer>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.4" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--  DataGridColumnHeader  -->
    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Foreground" Value="{DynamicResource GcTextSecondaryBrush}" />
        <Setter Property="Background" Value="{DynamicResource GcControlBrush}" />
        <Setter Property="Padding" Value="12,9" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="BorderBrush" Value="#10000000" />
        <Setter Property="BorderThickness" Value="0,0,1,1" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridColumnHeader">
                    <Border
                        x:Name="Root"
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ContentPresenter
                                Grid.Column="0"
                                VerticalAlignment="Center"
                                ContentSource="Content"
                                SnapsToDevicePixels="True"
                                TextOptions.TextRenderingMode="ClearType" />
                            <Grid Grid.Column="1" Margin="6,0,0,0">
                                <Path
                                    x:Name="SortAsc"
                                    VerticalAlignment="Center"
                                    Data="M 0 5 L 4 0 L 8 5"
                                    SnapsToDevicePixels="True"
                                    Stroke="{DynamicResource GcAccentBrush}"
                                    StrokeEndLineCap="Round"
                                    StrokeStartLineCap="Round"
                                    StrokeThickness="1.6"
                                    Visibility="Collapsed" />
                                <Path
                                    x:Name="SortDesc"
                                    VerticalAlignment="Center"
                                    Data="M 0 0 L 4 5 L 8 0"
                                    SnapsToDevicePixels="True"
                                    Stroke="{DynamicResource GcAccentBrush}"
                                    StrokeEndLineCap="Round"
                                    StrokeStartLineCap="Round"
                                    StrokeThickness="1.6"
                                    Visibility="Collapsed" />
                            </Grid>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="#10000000" />
                        </Trigger>
                        <Trigger Property="SortDirection" Value="Ascending">
                            <Setter TargetName="SortAsc" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="SortDirection" Value="Descending">
                            <Setter TargetName="SortDesc" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  DataGridRow  -->
    <Style TargetType="DataGridRow">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource GcTextBrush}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#08000000" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="#15000000" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--  DataGridCell  -->
    <Style TargetType="DataGridCell">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource GcTextBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="12,7" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Border
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        SnapsToDevicePixels="True">
                        <ContentPresenter
                            VerticalAlignment="Center"
                            ContentSource="Content"
                            SnapsToDevicePixels="True"
                            TextOptions.TextRenderingMode="ClearType" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
