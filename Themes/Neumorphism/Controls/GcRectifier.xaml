<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:GeneralControl.Controls">

    <!--  Neumorphism 整流器面板样式  -->
    <Style TargetType="controls:GcRectifier">
        <Setter Property="Width" Value="260" />
        <Setter Property="Height" Value="226" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:GcRectifier">
                    <Border
                        Padding="12,10"
                        Background="#EBEEF0"
                        BorderBrush="#C6CBD1"
                        BorderThickness="1"
                        CornerRadius="12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!--  标题行  -->
                            <Grid Grid.Row="0" Margin="2,0,2,8">
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    FontWeight="Bold"
                                    Foreground="{DynamicResource GcTextBrush}"
                                    Text="整流器 RECTIFIER" />
                                <StackPanel
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal">
                                    <Ellipse
                                        x:Name="PART_AlarmDot"
                                        Width="9"
                                        Height="9"
                                        Margin="0,0,5,0"
                                        Fill="#9AA0A8" />
                                    <TextBlock
                                        Margin="0,0,10,0"
                                        FontSize="8.5"
                                        Foreground="{DynamicResource GcTextSecondaryBrush}"
                                        Text="报警" />
                                    <Ellipse
                                        x:Name="PART_PowerDot"
                                        Width="9"
                                        Height="9"
                                        Fill="#9AA0A8" />
                                    <TextBlock
                                        Margin="2,0,0,0"
                                        FontSize="8.5"
                                        Foreground="{DynamicResource GcTextSecondaryBrush}"
                                        Text="电源" />
                                </StackPanel>
                            </Grid>

                            <!--  设定行  -->
                            <Grid Grid.Row="1" Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Grid.Column="0"
                                    Margin="0,0,6,0"
                                    VerticalAlignment="Center"
                                    FontSize="9.5"
                                    Foreground="{DynamicResource GcTextSecondaryBrush}"
                                    Text="设定电压" />
                                <controls:GcNumericBox
                                    Grid.Column="1"
                                    Height="24"
                                    DecimalPlaces="1"
                                    Increment="1"
                                    Maximum="400"
                                    Minimum="0"
                                    Value="{Binding SetVoltage, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" />
                                <TextBlock
                                    Grid.Column="2"
                                    Margin="10,0,6,0"
                                    VerticalAlignment="Center"
                                    FontSize="9.5"
                                    Foreground="{DynamicResource GcTextSecondaryBrush}"
                                    Text="设定电流" />
                                <controls:GcNumericBox
                                    Grid.Column="3"
                                    Height="24"
                                    DecimalPlaces="1"
                                    Increment="0.5"
                                    Maximum="50"
                                    Minimum="0"
                                    Value="{Binding SetCurrent, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" />
                            </Grid>

                            <!--  当前值行  -->
                            <Border
                                Grid.Row="2"
                                Margin="0,6,0,2"
                                Padding="8,5"
                                Background="#F4F5F6"
                                BorderBrush="#C6CBD1"
                                BorderThickness="0.8"
                                CornerRadius="6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock
                                            FontSize="8"
                                            Foreground="{DynamicResource GcTextSecondaryBrush}"
                                            Text="当前电压" />
                                        <TextBlock
                                            x:Name="PART_CurVolt"
                                            FontSize="15"
                                            FontWeight="Bold"
                                            Foreground="{DynamicResource GcTextBrush}"
                                            Text="{Binding CurrentVoltage, RelativeSource={RelativeSource TemplatedParent}, StringFormat={}{0:0.0}V}" />
                                    </StackPanel>
                                    <Border
                                        Grid.Column="1"
                                        Width="1"
                                        Margin="10,0"
                                        Background="#D0D5DA" />
                                    <StackPanel Grid.Column="2">
                                        <TextBlock
                                            FontSize="8"
                                            Foreground="{DynamicResource GcTextSecondaryBrush}"
                                            Text="当前电流" />
                                        <TextBlock
                                            x:Name="PART_CurCurr"
                                            FontSize="15"
                                            FontWeight="Bold"
                                            Foreground="{DynamicResource GcTextBrush}"
                                            Text="{Binding CurrentCurrent, RelativeSource={RelativeSource TemplatedParent}, StringFormat={}{0:0.0}A}" />
                                    </StackPanel>
                                    <Border
                                        Grid.Column="3"
                                        Width="1"
                                        Margin="10,0"
                                        Background="#D0D5DA" />
                                </Grid>
                            </Border>

                            <!--  电压报警行  -->
                            <Grid Grid.Row="3" Margin="0,6,0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Grid.Column="0"
                                    Margin="0,0,6,0"
                                    VerticalAlignment="Center"
                                    FontSize="9.5"
                                    Foreground="{DynamicResource GcTextSecondaryBrush}"
                                    Text="电压报警" />
                                <StackPanel
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal">
                                    <controls:GcNumericBox
                                        Width="52"
                                        Height="22"
                                        DecimalPlaces="0"
                                        Increment="1"
                                        Maximum="400"
                                        Minimum="0"
                                        Value="{Binding AlarmLowVoltage, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" />
                                    <TextBlock
                                        Margin="3,0"
                                        VerticalAlignment="Center"
                                        FontSize="9"
                                        Foreground="{DynamicResource GcTextSecondaryBrush}"
                                        Text="~" />
                                    <controls:GcNumericBox
                                        Width="52"
                                        Height="22"
                                        DecimalPlaces="0"
                                        Increment="1"
                                        Maximum="400"
                                        Minimum="0"
                                        Value="{Binding AlarmHighVoltage, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" />
                                </StackPanel>
                                <TextBlock
                                    Grid.Column="2"
                                    Margin="10,0,6,0"
                                    VerticalAlignment="Center"
                                    FontSize="9.5"
                                    Foreground="{DynamicResource GcTextSecondaryBrush}"
                                    Text="电流报警" />
                                <StackPanel
                                    Grid.Column="3"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal">
                                    <controls:GcNumericBox
                                        Width="52"
                                        Height="22"
                                        DecimalPlaces="0"
                                        Increment="0.5"
                                        Maximum="50"
                                        Minimum="0"
                                        Value="{Binding AlarmLowCurrent, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" />
                                    <TextBlock
                                        Margin="3,0"
                                        VerticalAlignment="Center"
                                        FontSize="9"
                                        Foreground="{DynamicResource GcTextSecondaryBrush}"
                                        Text="~" />
                                    <controls:GcNumericBox
                                        Width="52"
                                        Height="22"
                                        DecimalPlaces="0"
                                        Increment="0.5"
                                        Maximum="50"
                                        Minimum="0"
                                        Value="{Binding AlarmHighCurrent, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" />
                                </StackPanel>
                            </Grid>

                            <!--  开关行  -->
                            <Grid Grid.Row="4" Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Grid.Column="0"
                                    Margin="0,0,8,0"
                                    VerticalAlignment="Center"
                                    FontSize="9.5"
                                    Foreground="{DynamicResource GcTextSecondaryBrush}"
                                    Text="整流器开关" />
                                <ToggleButton
                                    Grid.Column="1"
                                    Width="52"
                                    Height="24"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Cursor="Hand"
                                    IsChecked="{Binding IsOn, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border
                                                x:Name="Track"
                                                Background="#DDE1E5"
                                                BorderBrush="#C6CBD1"
                                                BorderThickness="1"
                                                CornerRadius="12">
                                                <Grid>
                                                    <TextBlock
                                                        x:Name="Txt"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        FontSize="8"
                                                        FontWeight="Bold"
                                                        Foreground="{DynamicResource GcTextSecondaryBrush}"
                                                        Text="OFF" />
                                                    <Ellipse
                                                        x:Name="Knob"
                                                        Width="18"
                                                        Height="18"
                                                        Margin="3,0,0,0"
                                                        HorizontalAlignment="Left"
                                                        Fill="#FFFFFF" />
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="Track" Property="Background" Value="#35D07F" />
                                                    <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                                                    <Setter TargetName="Txt" Property="Text" Value="ON" />
                                                    <Setter TargetName="Txt" Property="Foreground" Value="#FFFFFF" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                                <TextBlock
                                    x:Name="PART_StatusText"
                                    Grid.Column="2"
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center"
                                    FontSize="9.5"
                                    Foreground="{DynamicResource GcTextSecondaryBrush}"
                                    Text="已停止" />
                            </Grid>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsOn" Value="True">
                            <Setter TargetName="PART_PowerDot" Property="Fill" Value="#35D07F" />
                            <Setter TargetName="PART_StatusText" Property="Text" Value="运行中" />
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="PowerGlow">
                                    <Storyboard AutoReverse="True" RepeatBehavior="Forever">
                                        <DoubleAnimation
                                            Storyboard.TargetName="PART_PowerDot"
                                            Storyboard.TargetProperty="Opacity"
                                            From="1"
                                            To="0.55"
                                            Duration="0:0:0.9" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <StopStoryboard BeginStoryboardName="PowerGlow" />
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsAlarm" Value="True">
                            <Setter TargetName="PART_AlarmDot" Property="Fill" Value="#E84949" />
                            <Setter TargetName="PART_CurVolt" Property="Foreground" Value="#D93838" />
                            <Setter TargetName="PART_CurCurr" Property="Foreground" Value="#D93838" />
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="AlarmBlink">
                                    <Storyboard AutoReverse="True" RepeatBehavior="Forever">
                                        <DoubleAnimation
                                            Storyboard.TargetName="PART_AlarmDot"
                                            Storyboard.TargetProperty="Opacity"
                                            From="1"
                                            To="0.2"
                                            Duration="0:0:0.4" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <StopStoryboard BeginStoryboardName="AlarmBlink" />
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
