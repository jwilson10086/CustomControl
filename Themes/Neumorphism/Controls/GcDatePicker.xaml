<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:GeneralControl.Controls">

    <!--  拟物 DatePicker：结构与 Glass 完全一致  -->
    <Style TargetType="controls:GcDatePicker">
        <Setter Property="Width" Value="170" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:GcDatePicker">
                    <Grid>
                        <Border
                            x:Name="Root"
                            Background="{DynamicResource GcControlBrush}"
                            BorderBrush="{DynamicResource GcBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                            <Grid Margin="12,0,10,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    x:Name="PART_DisplayText"
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    FontSize="13"
                                    Foreground="{DynamicResource GcTextBrush}" />
                                <Canvas
                                    Grid.Column="1"
                                    Width="14"
                                    Height="14"
                                    VerticalAlignment="Center"
                                    Opacity="0.7">
                                    <Rectangle
                                        Canvas.Left="1"
                                        Canvas.Top="2.5"
                                        Width="12"
                                        Height="10.5"
                                        RadiusX="2"
                                        RadiusY="2"
                                        Stroke="{DynamicResource GcTextSecondaryBrush}"
                                        StrokeThickness="1.3" />
                                    <Line
                                        Stroke="{DynamicResource GcTextSecondaryBrush}"
                                        StrokeThickness="1.2"
                                        X1="1"
                                        X2="13"
                                        Y1="6"
                                        Y2="6" />
                                    <Line
                                        Stroke="{DynamicResource GcTextSecondaryBrush}"
                                        StrokeThickness="1.3"
                                        X1="4"
                                        X2="4"
                                        Y1="0.8"
                                        Y2="4" />
                                    <Line
                                        Stroke="{DynamicResource GcTextSecondaryBrush}"
                                        StrokeThickness="1.3"
                                        X1="10"
                                        X2="10"
                                        Y1="0.8"
                                        Y2="4" />
                                </Canvas>
                            </Grid>
                        </Border>
                        <ToggleButton
                            x:Name="PART_Toggle"
                            Cursor="Hand"
                            Focusable="False"
                            IsHitTestVisible="True"
                            Opacity="0" />
                        <Popup
                            x:Name="PART_Popup"
                            AllowsTransparency="True"
                            Placement="Bottom"
                            PlacementTarget="{Binding ElementName=PART_Toggle}"
                            PopupAnimation="Fade"
                            StaysOpen="False">
                            <Border
                                Margin="0,4,8,8"
                                Background="#F0F3F7"
                                BorderBrush="{DynamicResource GcBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10">
                                <Border.Effect>
                                    <DropShadowEffect
                                        BlurRadius="9"
                                        Opacity="0.25"
                                        ShadowDepth="2"
                                        Color="#A0A0A8" />
                                </Border.Effect>
                                <Calendar
                                    x:Name="PART_Calendar"
                                    Margin="6"
                                    Background="Transparent"
                                    BorderThickness="0" />
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource GcBorderHoverBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
