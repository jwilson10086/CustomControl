<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:GeneralControl.Controls">

    <!--
        ================================================================
        文件说明：Themes\Steel\Controls\Pump.xaml
        Pump 工业泵样式（涡壳 + 叶轮符号）。
        
        【几何基准】（所有坐标以控件中心为基准，杜绝偏心）
        涡壳圆心 = 控件中心 (24,24)，半径 18（圆占 x/y 6~42）。
        吸入喇叭口与出口锥管均为连续曲线路径：
        管口端面齐平控件左右边缘（x=0 / x=48），出口端面 y21~27（管宽 6）与 Pipe 对齐；
        根部均延伸进涡壳内侧、绘制在涡壳下层，被壳体压住实现无缝衔接。
        出口锥管：壳缘 (40.2,16.2)/(40.2,31.8) 平滑收缩到管口 (48,21)/(48,27)。
        叶轮：五片根细头宽的叶形直叶（径向、无方向性），
        叶根藏入中心毂下，叶尖留出涡壳间隙。
        
        【端口衔接】
        吸入喇叭口与出口锥管都由 PART_Inlet / PART_Outlet 承载，
        分别绕涡壳圆心 (24,24) 旋转到 0/90/180/270（InletDirection 默认 180 朝左）；
        管口端面画到控件边缘，相邻 Pipe 端点稍微伸入即可无缝搭接。
        
        【状态模型】
        - IsRunning=true：叶轮持续旋转，SpinDirection 决定正/反转；
        （ExitActions 停止故事板——否则停泵后动画不会停）
        - IsFault=true：红色警示；
        - OutletDirection：旋转 PART_Outlet 到 0/90/180/270 度。
        ================================================================
    -->

    <Style TargetType="controls:GcPump">
        <Setter Property="Width" Value="48" />
        <Setter Property="Height" Value="48" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:GcPump">
                    <!--
                        Stretch=Fill：Width/Height 直接控制内容长宽（组态编辑时拖宽拖高即时生效）；
                        Uniform 会等比限制，编辑器中"拉宽"看起来无效
                    -->
                    <Viewbox
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Stretch="Fill">
                        <Canvas Width="48" Height="48">

                            <!--
                                吸入喇叭口组：整体绕涡壳圆心 (24,24) 旋转（默认朝左）。
                                绘制在涡壳下层：根部藏进壳体内侧，衔接无缝
                            -->
                            <Canvas
                                x:Name="PART_Inlet"
                                Width="48"
                                Height="48">
                                <Canvas.RenderTransform>
                                    <RotateTransform Angle="180" CenterX="24" CenterY="24" />
                                </Canvas.RenderTransform>
                                <!--
                                    喇叭口（朝左基准位）：管口 x=0 端面宽 6，
                                    壁面向外微张成喇叭，根部伸入壳体被压住
                                -->
                                <Path Data="M 0 21 L 7 21 L 7 27 L 0 27 Z" Fill="#33334155" />
                            </Canvas>

                            <!--
                                叶轮组：五片根细头宽的叶形直叶 + 中心毂 + 轴心点，
                                径向对称、无方向性，SpinDirection 正/反转观感一致；
                                全部绕涡壳圆心 (24,24) 旋转
                            -->
                            <Canvas
                                x:Name="PART_Impeller"
                                Width="48"
                                Height="48"
                                Opacity="0.45">
                                <Canvas.RenderTransform>
                                    <RotateTransform Angle="0" CenterX="24" CenterY="24" />
                                </Canvas.RenderTransform>
                                <!--
                                    叶片（朝上基准位）：叶根 r≈3.2 藏入毂下、宽 1.7，
                                    叶尖 r≈14 留出涡壳间隙、宽 4.5，二次曲线收出圆头
                                -->
                                <Path Data="M 23.15,20.8 L 21.75,10.6 Q 24,8.6 26.25,10.6 L 24.85,20.8 Z" Fill="#475569" />
                                <!--
                                    旋转副本包一层同尺寸画布，使局部坐标与外层重合，
                                    RotateTransform 的 CenterX/CenterY 才是涡壳圆心 (24,24)；五叶间隔 72°
                                -->
                                <Canvas Width="48" Height="48">
                                    <Canvas.RenderTransform>
                                        <RotateTransform Angle="72" CenterX="24" CenterY="24" />
                                    </Canvas.RenderTransform>
                                    <Path Data="M 23.15,20.8 L 21.75,10.6 Q 24,8.6 26.25,10.6 L 24.85,20.8 Z" Fill="#475569" />
                                </Canvas>
                                <Canvas Width="48" Height="48">
                                    <Canvas.RenderTransform>
                                        <RotateTransform Angle="144" CenterX="24" CenterY="24" />
                                    </Canvas.RenderTransform>
                                    <Path Data="M 23.15,20.8 L 21.75,10.6 Q 24,8.6 26.25,10.6 L 24.85,20.8 Z" Fill="#475569" />
                                </Canvas>
                                <Canvas Width="48" Height="48">
                                    <Canvas.RenderTransform>
                                        <RotateTransform Angle="216" CenterX="24" CenterY="24" />
                                    </Canvas.RenderTransform>
                                    <Path Data="M 23.15,20.8 L 21.75,10.6 Q 24,8.6 26.25,10.6 L 24.85,20.8 Z" Fill="#475569" />
                                </Canvas>
                                <Canvas Width="48" Height="48">
                                    <Canvas.RenderTransform>
                                        <RotateTransform Angle="288" CenterX="24" CenterY="24" />
                                    </Canvas.RenderTransform>
                                    <Path Data="M 23.15,20.8 L 21.75,10.6 Q 24,8.6 26.25,10.6 L 24.85,20.8 Z" Fill="#475569" />
                                </Canvas>
                                <!--  中心毂最后绘制，盖住三处叶根，衔接无缝；轴心点增强立体感  -->
                                <Ellipse
                                    Canvas.Left="20.5"
                                    Canvas.Top="20.5"
                                    Width="7"
                                    Height="7"
                                    Fill="#475569" />
                                <Ellipse
                                    Canvas.Left="22.7"
                                    Canvas.Top="22.7"
                                    Width="2.6"
                                    Height="2.6"
                                    Fill="#73000000" />
                            </Canvas>

                            <!--
                                排出口组：锥形出口管（连续曲线），整体绕涡壳圆心 (24,24) 旋转（默认朝右）。
                                绘制在涡壳下层：根部藏进壳体内侧，衔接无缝
                            -->
                            <Canvas
                                x:Name="PART_Outlet"
                                Width="48"
                                Height="48">
                                <Canvas.RenderTransform>
                                    <RotateTransform Angle="0" CenterX="24" CenterY="24" />
                                </Canvas.RenderTransform>
                                <!--
                                    锥管：底边两点精确落在壳缘圆周上（r=18，±26°），
                                    两侧贝塞尔曲线平滑收缩到管宽 6，管口端面 x=48 齐平右缘
                                -->
                                <Path
                                    Data="M 40.2,16.2 C 44.5,16.9 46.8,18.6 48,21                                              L 48,27                                              C 46.8,29.4 44.5,31.1 40.2,31.8 Z"
                                    Fill="#3D334155"
                                    Stroke="{DynamicResource GcEdgeHighlightBrush}"
                                    StrokeThickness="1" />
                            </Canvas>

                            <!--  涡壳：外圈玻璃圆，圆心 = 控件中心 (24,24)；最后绘制压住出口锥颈底边  -->
                            <Ellipse
                                x:Name="Volute"
                                Canvas.Left="6"
                                Canvas.Top="6"
                                Width="36"
                                Height="36"
                                Fill="#1F334155"
                                Stroke="{DynamicResource GcEdgeHighlightBrush}"
                                StrokeThickness="1.6" />
                        </Canvas>
                    </Viewbox>
                    <ControlTemplate.Triggers>
                        <!--  ===== 排出口方向：绕涡壳圆心 (24,24) 旋转出口组 =====  -->
                        <Trigger Property="OutletDirection" Value="Down">
                            <Setter TargetName="PART_Outlet" Property="RenderTransform">
                                <Setter.Value>
                                    <RotateTransform Angle="90" CenterX="24" CenterY="24" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="OutletDirection" Value="Left">
                            <Setter TargetName="PART_Outlet" Property="RenderTransform">
                                <Setter.Value>
                                    <RotateTransform Angle="180" CenterX="24" CenterY="24" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="OutletDirection" Value="Up">
                            <Setter TargetName="PART_Outlet" Property="RenderTransform">
                                <Setter.Value>
                                    <RotateTransform Angle="270" CenterX="24" CenterY="24" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>

                        <!--  ===== 吸入口方向：绕涡壳圆心 (24,24) 旋转吸入组 =====  -->
                        <Trigger Property="InletDirection" Value="Right">
                            <Setter TargetName="PART_Inlet" Property="RenderTransform">
                                <Setter.Value>
                                    <RotateTransform Angle="0" CenterX="24" CenterY="24" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="InletDirection" Value="Down">
                            <Setter TargetName="PART_Inlet" Property="RenderTransform">
                                <Setter.Value>
                                    <RotateTransform Angle="90" CenterX="24" CenterY="24" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <!--  Left 为默认值（Angle=180），无需触发器  -->
                        <Trigger Property="InletDirection" Value="Up">
                            <Setter TargetName="PART_Inlet" Property="RenderTransform">
                                <Setter.Value>
                                    <RotateTransform Angle="270" CenterX="24" CenterY="24" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>

                        <!--
                            ===== 运行：叶轮旋转（按 SpinDirection 选故事板，
                            ExitActions 必须停止，否则停泵后仍在转） =====
                        -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsRunning" Value="True" />
                                <Condition Property="SpinDirection" Value="Clockwise" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="PART_Impeller" Property="Opacity" Value="1" />
                            <MultiTrigger.EnterActions>
                                <BeginStoryboard x:Name="SpinClockwise">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation
                                            Storyboard.TargetName="PART_Impeller"
                                            Storyboard.TargetProperty="RenderTransform.Angle"
                                            From="0"
                                            To="360"
                                            Duration="0:0:1.6" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiTrigger.EnterActions>
                            <MultiTrigger.ExitActions>
                                <StopStoryboard BeginStoryboardName="SpinClockwise" />
                            </MultiTrigger.ExitActions>
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsRunning" Value="True" />
                                <Condition Property="SpinDirection" Value="Counterclockwise" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="PART_Impeller" Property="Opacity" Value="1" />
                            <MultiTrigger.EnterActions>
                                <BeginStoryboard x:Name="SpinCounterClockwise">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation
                                            Storyboard.TargetName="PART_Impeller"
                                            Storyboard.TargetProperty="RenderTransform.Angle"
                                            From="0"
                                            To="-360"
                                            Duration="0:0:1.6" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiTrigger.EnterActions>
                            <MultiTrigger.ExitActions>
                                <StopStoryboard BeginStoryboardName="SpinCounterClockwise" />
                            </MultiTrigger.ExitActions>
                        </MultiTrigger>

                        <!--  故障：红色警示  -->
                        <Trigger Property="IsFault" Value="True">
                            <Setter TargetName="Volute" Property="Fill" Value="#33E85555" />
                            <Setter TargetName="Volute" Property="Stroke" Value="#FF8080" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>









