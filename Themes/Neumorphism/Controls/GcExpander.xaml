<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:GeneralControl.Controls">

    <!--  拟物 Expander：凸起头部 + 凹刻内容区  -->
    <Style TargetType="controls:GcExpander">
        <Setter Property="Foreground" Value="{DynamicResource GcTextBrush}" />
        <Setter Property="Background" Value="{DynamicResource GcControlBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="16,10" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:GcExpander">
                    <Grid SnapsToDevicePixels="True">
                        <!--  暗面  -->
                        <Border Background="Transparent" CornerRadius="14">
                            <Border.Effect>
                                <DropShadowEffect
                                    BlurRadius="5"
                                    Direction="315"
                                    Opacity="0.4"
                                    RenderingBias="Quality"
                                    ShadowDepth="2"
                                    Color="#A0A0A8" />
                            </Border.Effect>
                        </Border>
                        <!--  亮面  -->
                        <Border Background="Transparent" CornerRadius="14">
                            <Border.Effect>
                                <DropShadowEffect
                                    BlurRadius="5"
                                    Direction="135"
                                    Opacity="0.55"
                                    RenderingBias="Quality"
                                    ShadowDepth="2"
                                    Color="#FFFFFF" />
                            </Border.Effect>
                        </Border>
                        <!--  背景  -->
                        <Border
                            x:Name="BgBorder"
                            Background="{TemplateBinding Background}"
                            CornerRadius="14"
                            SnapsToDevicePixels="True" />
                        <Border
                            Background="{DynamicResource GcTopHighlightBrush}"
                            CornerRadius="14"
                            IsHitTestVisible="False"
                            SnapsToDevicePixels="True" />
                        <!--  内容  -->
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <!--  标题栏  -->
                            <Grid Grid.Row="0" Background="Transparent">
                                <ToggleButton
                                    x:Name="HeaderSite"
                                    Cursor="Hand"
                                    Focusable="False"
                                    IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                    Opacity="0" />
                                <ContentPresenter
                                    Margin="14,11"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Content="{TemplateBinding Header}"
                                    RecognizesAccessKey="True"
                                    SnapsToDevicePixels="True"
                                    TextElement.FontSize="13"
                                    TextElement.FontWeight="SemiBold"
                                    TextOptions.TextRenderingMode="ClearType" />
                                <Path
                                    x:Name="ChevronDown"
                                    Margin="0,0,14,0"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Data="M 1 1 L 5 5 L 9 1"
                                    SnapsToDevicePixels="True"
                                    Stroke="{DynamicResource GcTextSecondaryBrush}"
                                    StrokeEndLineCap="Round"
                                    StrokeStartLineCap="Round"
                                    StrokeThickness="1.8" />
                                <Path
                                    x:Name="ChevronUp"
                                    Margin="0,0,14,0"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Data="M 1 5 L 5 1 L 9 5"
                                    SnapsToDevicePixels="True"
                                    Stroke="{DynamicResource GcTextSecondaryBrush}"
                                    StrokeEndLineCap="Round"
                                    StrokeStartLineCap="Round"
                                    StrokeThickness="1.8"
                                    Visibility="Collapsed" />
                            </Grid>
                            <!--  内容区  -->
                            <ContentPresenter
                                x:Name="ExpandSite"
                                Grid.Row="1"
                                Margin="14,0,14,14"
                                Focusable="False"
                                SnapsToDevicePixels="True"
                                TextOptions.TextRenderingMode="ClearType"
                                Visibility="Collapsed" />
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="True">
                            <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible" />
                            <Setter TargetName="ChevronDown" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="ChevronUp" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="HeaderSite" Property="Cursor" Value="Hand" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
