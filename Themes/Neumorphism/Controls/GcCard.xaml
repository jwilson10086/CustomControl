<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:GeneralControl.Controls">

    <Style TargetType="controls:GcCard">
        <Setter Property="Background" Value="{DynamicResource GcControlBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="20" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:GcCard">
                    <Grid Margin="2" SnapsToDevicePixels="True">
                        <!--  静态壳（阴影/背景/高光）整层位图缓存：特效只算一次，滚动不重算  -->
                        <Grid CacheMode="BitmapCache">
                            <!--  暗面阴影  -->
                            <Border Background="Transparent" CornerRadius="14">
                                <Border.Effect>
                                    <DropShadowEffect
                                        BlurRadius="9"
                                        Direction="315"
                                        Opacity="0.5"
                                        RenderingBias="Quality"
                                        ShadowDepth="3"
                                        Color="#A0A0A8" />
                                </Border.Effect>
                            </Border>
                            <!--  背景  -->
                            <Border
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="14" />
                            <!--  高光  -->
                            <Border
                                Background="{DynamicResource GcTopHighlightBrush}"
                                CornerRadius="14"
                                IsHitTestVisible="False" />
                        </Grid>
                        <!--  内容（动态区，不缓存，动画照常）  -->
                        <ContentPresenter
                            Margin="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True"
                            TextOptions.TextRenderingMode="ClearType" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
