<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:GeneralControl.Controls">

    <Style TargetType="controls:GcToggleSwitch">
        <Setter Property="Foreground" Value="{DynamicResource GcTextBrush}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:GcToggleSwitch">
                    <Grid
                        x:Name="Root"
                        RenderTransformOrigin="0.5,0.5"
                        SnapsToDevicePixels="True">
                        <Grid.RenderTransform>
                            <ScaleTransform x:Name="TgScale" ScaleX="1" ScaleY="1" />
                        </Grid.RenderTransform>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!--  轨道背景层：凹刻渐变  -->
                        <Border
                            x:Name="TrackBg"
                            Grid.Column="0"
                            Width="48"
                            Height="26"
                            CornerRadius="13"
                            SnapsToDevicePixels="True">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="1,1" EndPoint="0,0">
                                    <GradientStop Offset="0" Color="#DDDDE2" />
                                    <GradientStop Offset="1" Color="#E8E8EC" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <!--  暗面  -->
                        <Border
                            Grid.Column="0"
                            Width="48"
                            Height="26"
                            Background="Transparent"
                            CornerRadius="13"
                            SnapsToDevicePixels="True">
                            <Border.Effect>
                                <DropShadowEffect
                                    BlurRadius="5"
                                    Direction="315"
                                    Opacity="0.5"
                                    RenderingBias="Quality"
                                    ShadowDepth="2"
                                    Color="#A0A0A8" />
                            </Border.Effect>
                        </Border>
                        <!--  亮面  -->
                        <Border
                            Grid.Column="0"
                            Width="48"
                            Height="26"
                            Background="Transparent"
                            CornerRadius="13"
                            SnapsToDevicePixels="True">
                            <Border.Effect>
                                <DropShadowEffect
                                    BlurRadius="5"
                                    Direction="135"
                                    Opacity="0.7"
                                    RenderingBias="Quality"
                                    ShadowDepth="2"
                                    Color="#FFFFFF" />
                            </Border.Effect>
                        </Border>

                        <!--  滑块  -->
                        <Border
                            x:Name="Thumb"
                            Grid.Column="0"
                            Width="22"
                            Height="22"
                            Margin="3,0,0,0"
                            HorizontalAlignment="Left"
                            CornerRadius="11"
                            SnapsToDevicePixels="True">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Offset="0" Color="#F5F5F8" />
                                    <GradientStop Offset="1" Color="#E8E8EC" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.Effect>
                                <DropShadowEffect
                                    BlurRadius="3"
                                    Direction="315"
                                    Opacity="0.4"
                                    RenderingBias="Quality"
                                    ShadowDepth="1"
                                    Color="#909098" />
                            </Border.Effect>
                        </Border>

                        <!--  文字  -->
                        <ContentPresenter
                            Grid.Column="2"
                            Margin="{TemplateBinding Padding}"
                            VerticalAlignment="Center"
                            RecognizesAccessKey="True"
                            SnapsToDevicePixels="True"
                            TextOptions.TextFormattingMode="Display"
                            TextOptions.TextRenderingMode="ClearType" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                            <Setter TargetName="Thumb" Property="Margin" Value="0,0,3,0" />
                            <Setter TargetName="TrackBg" Property="Background">
                                <Setter.Value>
                                    <LinearGradientBrush StartPoint="1,1" EndPoint="0,0">
                                        <GradientStop Offset="0" Color="#A8C8F0" />
                                        <GradientStop Offset="1" Color="#88AAE0" />
                                    </LinearGradientBrush>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <!--  按下缩放 150ms  -->
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetName="TgScale"
                                            Storyboard.TargetProperty="ScaleX"
                                            To="0.95"
                                            Duration="0:0:0.15" />
                                        <DoubleAnimation
                                            Storyboard.TargetName="TgScale"
                                            Storyboard.TargetProperty="ScaleY"
                                            To="0.95"
                                            Duration="0:0:0.15" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetName="TgScale"
                                            Storyboard.TargetProperty="ScaleX"
                                            To="1"
                                            Duration="0:0:0.15" />
                                        <DoubleAnimation
                                            Storyboard.TargetName="TgScale"
                                            Storyboard.TargetProperty="ScaleY"
                                            To="1"
                                            Duration="0:0:0.15" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
