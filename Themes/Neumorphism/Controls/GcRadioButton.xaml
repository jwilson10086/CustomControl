<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:GeneralControl.Controls">

    <Style TargetType="controls:GcRadioButton">
        <Setter Property="Foreground" Value="{DynamicResource GcTextBrush}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:GcRadioButton">
                    <Grid
                        x:Name="Root"
                        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                        VerticalAlignment="Center"
                        RenderTransformOrigin="0.5,0.5"
                        SnapsToDevicePixels="True">
                        <Grid.RenderTransform>
                            <ScaleTransform x:Name="RadioScale" ScaleX="1" ScaleY="1" />
                        </Grid.RenderTransform>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!--  圆形背景层  -->
                        <Border
                            x:Name="CircleBg"
                            Grid.Column="0"
                            Width="22"
                            Height="22"
                            Background="{DynamicResource GcControlBrush}"
                            CornerRadius="11"
                            SnapsToDevicePixels="True" />
                        <!--  暗面  -->
                        <Border
                            Grid.Column="0"
                            Width="22"
                            Height="22"
                            Background="Transparent"
                            CornerRadius="11"
                            SnapsToDevicePixels="True">
                            <Border.Effect>
                                <DropShadowEffect
                                    BlurRadius="5"
                                    Direction="315"
                                    Opacity="0.5"
                                    RenderingBias="Quality"
                                    ShadowDepth="2"
                                    Color="#A0A0A8" />
                            </Border.Effect>
                        </Border>
                        <!--  亮面  -->
                        <Border
                            Grid.Column="0"
                            Width="22"
                            Height="22"
                            Background="Transparent"
                            CornerRadius="11"
                            SnapsToDevicePixels="True">
                            <Border.Effect>
                                <DropShadowEffect
                                    BlurRadius="5"
                                    Direction="135"
                                    Opacity="0.7"
                                    RenderingBias="Quality"
                                    ShadowDepth="2"
                                    Color="#FFFFFF" />
                            </Border.Effect>
                        </Border>

                        <!--  选中点（凹刻）  -->
                        <Border
                            x:Name="Dot"
                            Grid.Column="0"
                            Width="10"
                            Height="10"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="{DynamicResource GcAccentBrush}"
                            CornerRadius="5"
                            SnapsToDevicePixels="True"
                            Visibility="Collapsed" />

                        <!--  文字  -->
                        <ContentPresenter
                            Grid.Column="2"
                            Margin="{TemplateBinding Padding}"
                            VerticalAlignment="Center"
                            RecognizesAccessKey="True"
                            SnapsToDevicePixels="True"
                            TextOptions.TextFormattingMode="Display"
                            TextOptions.TextRenderingMode="ClearType" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="CircleBg" Property="Background" Value="{DynamicResource GcControlHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="CircleBg" Property="Background" Value="{DynamicResource GcControlPressedBrush}" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetName="RadioScale"
                                            Storyboard.TargetProperty="ScaleX"
                                            To="0.92"
                                            Duration="0:0:0.15" />
                                        <DoubleAnimation
                                            Storyboard.TargetName="RadioScale"
                                            Storyboard.TargetProperty="ScaleY"
                                            To="0.92"
                                            Duration="0:0:0.15" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetName="RadioScale"
                                            Storyboard.TargetProperty="ScaleX"
                                            To="1"
                                            Duration="0:0:0.15" />
                                        <DoubleAnimation
                                            Storyboard.TargetName="RadioScale"
                                            Storyboard.TargetProperty="ScaleY"
                                            To="1"
                                            Duration="0:0:0.15" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
