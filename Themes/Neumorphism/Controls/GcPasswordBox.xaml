<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:GeneralControl.Controls">

    <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />

    <!--  拟物密码框：结构与 Glass 完全一致  -->
    <Style x:Key="PasswordBoxStyle" TargetType="PasswordBox">
        <Setter Property="Background" Value="{DynamicResource GcControlBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource GcBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource GcTextBrush}" />
        <Setter Property="CaretBrush" Value="{DynamicResource GcTextBrush}" />
        <Setter Property="SelectionBrush" Value="#5EA8C8F0" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Border
                        x:Name="Root"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="9">
                        <Grid>
                            <ScrollViewer
                                x:Name="PART_ContentHost"
                                Margin="{TemplateBinding Padding}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                Focusable="False" />
                            <TextBox
                                x:Name="PART_PlainTextBox"
                                Padding="0"
                                Background="Transparent"
                                BorderThickness="0"
                                CaretBrush="{DynamicResource GcTextBrush}"
                                Focusable="False"
                                FontSize="13"
                                Foreground="{DynamicResource GcTextBrush}"
                                IsHitTestVisible="False"
                                SelectionBrush="#5EA8C8F0"
                                SnapsToDevicePixels="True"
                                Visibility="Collapsed" />
                            <TextBlock
                                x:Name="PART_Watermark"
                                Margin="{TemplateBinding Padding}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                FontSize="{TemplateBinding FontSize}"
                                Foreground="{Binding (controls:GcPasswordBox.PlaceholderBrush), RelativeSource={RelativeSource TemplatedParent}}"
                                IsHitTestVisible="False"
                                Text="{Binding (controls:GcPasswordBox.Placeholder), RelativeSource={RelativeSource TemplatedParent}}"
                                TextTrimming="CharacterEllipsis" />
                            <Button
                                x:Name="PART_TogglePasswordButton"
                                Width="28"
                                Height="28"
                                Margin="0,0,8,0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Background="Transparent"
                                BorderThickness="0"
                                Cursor="Hand"
                                Focusable="False"
                                ToolTip="显示/隐藏密码"
                                Visibility="{Binding (controls:GcPasswordBox.IsPasswordVisible), RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BoolToVisibilityConverter}}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border
                                            x:Name="EyeBorder"
                                            Padding="4"
                                            Background="Transparent"
                                            CornerRadius="6">
                                            <Canvas
                                                Width="18"
                                                Height="12"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center">
                                                <Ellipse
                                                    Canvas.Left="0"
                                                    Canvas.Top="0"
                                                    Width="18"
                                                    Height="11"
                                                    Stroke="{DynamicResource GcTextSecondaryBrush}"
                                                    StrokeThickness="1.2" />
                                                <Ellipse
                                                    Canvas.Left="6"
                                                    Canvas.Top="2.5"
                                                    Width="6"
                                                    Height="6"
                                                    Fill="{DynamicResource GcTextSecondaryBrush}" />
                                                <Ellipse
                                                    Canvas.Left="7.8"
                                                    Canvas.Top="4"
                                                    Width="2"
                                                    Height="2"
                                                    Fill="White"
                                                    Opacity="0.9" />
                                            </Canvas>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="EyeBorder" Property="Background" Value="#15000000" />
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="EyeBorder" Property="Background" Value="#25000000" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource GcBorderHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource GcAccentBrush}" />
                            <Setter TargetName="Root" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect
                                        BlurRadius="7"
                                        Opacity="0.35"
                                        ShadowDepth="1"
                                        Color="#88AAE0" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <DataTrigger Binding="{Binding Password.Length, RelativeSource={RelativeSource TemplatedParent}}" Value="0">
                            <Setter TargetName="PART_Watermark" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Password.Length, RelativeSource={RelativeSource TemplatedParent}}" Value="1">
                            <Setter TargetName="PART_Watermark" Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="PART_Watermark" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
