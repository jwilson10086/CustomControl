<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:GeneralControl.Controls">

    <!--  拟物 InputDialog：结构与 Glass 一致  -->
    <Style TargetType="controls:GcInputDialog">
        <Setter Property="Background" Value="{DynamicResource GcControlBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource GcTextBrush}" />
        <Setter Property="MinWidth" Value="340" />
        <Setter Property="MaxWidth" Value="480" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:GcInputDialog">
                    <Border
                        Padding="24"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{DynamicResource GcBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="16">
                        <Border.Effect>
                            <DropShadowEffect
                                BlurRadius="9"
                                Opacity="0.35"
                                ShadowDepth="3"
                                Color="#A0A0A8" />
                        </Border.Effect>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock
                                Grid.Row="0"
                                Margin="0,0,0,8"
                                FontSize="18"
                                FontWeight="Bold"
                                Text="{TemplateBinding Title}" />
                            <TextBlock
                                Grid.Row="1"
                                Margin="0,0,0,16"
                                FontSize="13"
                                Foreground="{DynamicResource GcTextSecondaryBrush}"
                                Text="{TemplateBinding Message}"
                                TextWrapping="Wrap" />
                            <Border
                                Grid.Row="2"
                                Margin="0,0,0,20"
                                Padding="2"
                                Background="#0A000000"
                                CornerRadius="10">
                                <Grid>
                                    <TextBox
                                        x:Name="PART_InputBox"
                                        Padding="12,10"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        CaretBrush="{DynamicResource GcAccentBrush}"
                                        FontSize="15"
                                        Foreground="{DynamicResource GcTextBrush}"
                                        MaxLength="200" />
                                    <TextBlock
                                        x:Name="PART_Watermark"
                                        Margin="14,10,12,10"
                                        VerticalAlignment="Center"
                                        FontSize="15"
                                        Foreground="#50000000"
                                        IsHitTestVisible="False"
                                        Text="{TemplateBinding InputPlaceholder}"
                                        TextTrimming="CharacterEllipsis">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding Text.Length, ElementName=PART_InputBox}" Value="0" />
                                                            <Condition Binding="{Binding IsKeyboardFocused, ElementName=PART_InputBox}" Value="False" />
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Border>
                            <Grid Grid.Row="3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button
                                    x:Name="PART_CancelButton"
                                    Grid.Column="1"
                                    Margin="0,0,12,0"
                                    Content="{TemplateBinding CancelText}"
                                    Style="{DynamicResource GcDialogButtonStyle}" />
                                <Button
                                    x:Name="PART_ConfirmButton"
                                    Grid.Column="2"
                                    Content="{TemplateBinding ConfirmText}"
                                    Style="{DynamicResource GcDialogConfirmStyle}" />
                            </Grid>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
