<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:GeneralControl.Controls">

    <!--  拟物 Clock：凸起背景 + 凹刻时间显示  -->
    <Style TargetType="controls:GcClock">
        <Setter Property="Background" Value="{DynamicResource GcControlBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource GcTextBrush}" />
        <Setter Property="MinWidth" Value="118" />
        <Setter Property="MinHeight" Value="64" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:GcClock">
                    <Grid
                        x:Name="Root"
                        RenderTransformOrigin="0.5,0.5"
                        SnapsToDevicePixels="True">
                        <Grid.RenderTransform>
                            <ScaleTransform x:Name="ClockScale" ScaleX="1" ScaleY="1" />
                        </Grid.RenderTransform>
                        <!--  静态壳（阴影/背景/高光）整层位图缓存：每秒刷新文字不重算特效  -->
                        <Grid CacheMode="BitmapCache">
                            <!--  暗面  -->
                            <Border Background="Transparent" CornerRadius="16">
                                <Border.Effect>
                                    <DropShadowEffect
                                        BlurRadius="9"
                                        Direction="315"
                                        Opacity="0.45"
                                        RenderingBias="Quality"
                                        ShadowDepth="3"
                                        Color="#A0A0A8" />
                                </Border.Effect>
                            </Border>
                            <!--  背景  -->
                            <Border
                                Background="{TemplateBinding Background}"
                                CornerRadius="16"
                                SnapsToDevicePixels="True" />
                            <Border
                                Background="{DynamicResource GcTopHighlightBrush}"
                                CornerRadius="16"
                                IsHitTestVisible="False"
                                SnapsToDevicePixels="True" />
                        </Grid>
                        <!--  时间内容（代码后置刷新 PART_TimeText / PART_DateText）  -->
                        <StackPanel
                            Margin="16,10"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                            <TextBlock
                                x:Name="PART_TimeText"
                                FontSize="26"
                                FontWeight="Bold"
                                Foreground="{TemplateBinding Foreground}"
                                SnapsToDevicePixels="True"
                                TextAlignment="Center"
                                TextOptions.TextRenderingMode="ClearType" />
                            <TextBlock
                                x:Name="PART_DateText"
                                Margin="0,4,0,0"
                                FontSize="11"
                                Foreground="{DynamicResource GcTextSecondaryBrush}"
                                TextAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
