<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:GeneralControl.Controls">

    <!--
        ================================================================
        文件说明：Themes\Steel\Controls\Pipe.xaml
        Pipe 工业管路样式（直管 / 拐弯管 + 流动虚线动画）。
        
        依赖：Brushes.xaml（画刷资源）。
        结构：Grid → [PART_Path 管体(双层描边成玻璃管) + PART_FlowPath 流动虚线]
        
        【几何来源】
        Data 由代码后置生成（Pipe.Rebuild）：
        - 直管模式：横穿控件、两端外伸 3px，搭进邻居端口下方消除接缝；
        - 拐弯模式：按 Points 中心线生成，内角二次贝塞尔圆弧弯头。
        
        【流动方向】
        虚线沿路径从起点流向终点；StrokeDashOffset 从 7（虚线周期 4+3）
        动画到 0 无缝循环。反向流动把 Points 倒过来写即可。
        ================================================================
    -->

    <Style TargetType="controls:GcPipe">
        <!--  MinHeight 而非 Height：拐弯模式需按 Points 包围盒自适应高度  -->
        <Setter Property="MinHeight" Value="16" />
        <Setter Property="MinWidth" Value="24" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:GcPipe">
                    <Grid>
                        <!--  管壁：亮色外圈  -->
                        <Path
                            x:Name="PART_Path"
                            Stroke="#66334155"
                            StrokeEndLineCap="Round"
                            StrokeLineJoin="Round"
                            StrokeStartLineCap="Round"
                            StrokeThickness="8" />

                        <!--  管腔：暗色内芯叠在壁内，形成玻璃管层次（粗细由代码后置按 PipeWidth 缩放）  -->
                        <Path
                            x:Name="PART_InnerPath"
                            Data="{Binding Data, ElementName=PART_Path}"
                            Stroke="#26334155"
                            StrokeEndLineCap="Round"
                            StrokeLineJoin="Round"
                            StrokeStartLineCap="Round"
                            StrokeThickness="5.5" />

                        <!--  流动指示虚线：默认透明  -->
                        <Path
                            x:Name="PART_FlowPath"
                            Opacity="0"
                            Stroke="{DynamicResource GcAccentBrush}"
                            StrokeDashArray="4 3"
                            StrokeDashCap="Round"
                            StrokeDashOffset="0"
                            StrokeThickness="3" />

                        <!--  编辑模式顶点手柄层（IsEditing 时由代码后置填充）  -->
                        <Canvas x:Name="PART_EditLayer" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!--  流动中（正向）：显示虚线并从起点流向终点  -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsFlowing" Value="True" />
                                <Condition Property="Direction" Value="Forward" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="PART_FlowPath" Property="Opacity" Value="0.95" />
                            <MultiTrigger.EnterActions>
                                <BeginStoryboard x:Name="FlowForwardStoryboard">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation
                                            Storyboard.TargetName="PART_FlowPath"
                                            Storyboard.TargetProperty="StrokeDashOffset"
                                            From="7"
                                            To="0"
                                            Duration="0:0:0.6" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiTrigger.EnterActions>
                            <MultiTrigger.ExitActions>
                                <StopStoryboard BeginStoryboardName="FlowForwardStoryboard" />
                            </MultiTrigger.ExitActions>
                        </MultiTrigger>

                        <!--  流动中（反向）：偏移反走，虚线从终点流向起点  -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsFlowing" Value="True" />
                                <Condition Property="Direction" Value="Reverse" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="PART_FlowPath" Property="Opacity" Value="0.95" />
                            <MultiTrigger.EnterActions>
                                <BeginStoryboard x:Name="FlowReverseStoryboard">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation
                                            Storyboard.TargetName="PART_FlowPath"
                                            Storyboard.TargetProperty="StrokeDashOffset"
                                            From="0"
                                            To="7"
                                            Duration="0:0:0.6" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiTrigger.EnterActions>
                            <MultiTrigger.ExitActions>
                                <StopStoryboard BeginStoryboardName="FlowReverseStoryboard" />
                            </MultiTrigger.ExitActions>
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <!--  编辑模式：恢复命中测试以便拖拽顶点，光标提示可编辑  -->
            <Trigger Property="IsEditing" Value="True">
                <Setter Property="IsHitTestVisible" Value="True" />
                <Setter Property="Cursor" Value="Cross" />
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>









