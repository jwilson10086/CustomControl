<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:GeneralControl.Controls">

    <!--
        ================================================================
        文件说明：Themes\Glass\Controls\TextBox.xaml
        TextBox 文本输入框样式。

        依赖：Brushes.xaml（画刷资源）。
        ================================================================
    -->

    <!--
        ===================== 文本输入框样式 =====================
        TextBox：毛玻璃主题的文本输入框。
        特性：
        - 半透明背景 + 焦点时蓝色边框 + 蓝色投影
        - 占位符文本（Placeholder）：输入为空时显示提示文字
        - 键盘图标按钮（PART_KeyboardIcon）：可选的触屏键盘触发按钮
        - CaretBrush 蓝色光标，与主题色调一致
        - SelectionBrush 蓝色文字选中高亮

        模板结构：
        Border(根) → Grid(两列) → [ScrollViewer(输入内容) + TextBlock(占位符) + Button(键盘图标)]

        注意：PART_ContentHost 是 TextBox 模板的约定部件名，
        WPF 会将用户的输入内容渲染到这个 ScrollViewer 中。
    -->
    <Style TargetType="controls:GcTextBox">
        <Setter Property="Background" Value="{DynamicResource GcControlBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource GcBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource GcTextBrush}" />
        <!-- CaretBrush：输入光标的颜色 -->
        <Setter Property="CaretBrush" Value="#C0FFFFFF" />
        <!-- SelectionBrush：选中文字的高亮背景色 -->
        <Setter Property="SelectionBrush" Value="#5E42BDFF" />
        <!-- SelectionOpacity：选中高亮的不透明度 -->
        <Setter Property="SelectionOpacity" Value="0.6" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <!-- PlaceholderBrush：占位符文字颜色 -->
        <Setter Property="PlaceholderBrush" Value="#78FFFFFF" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:GcTextBox">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="9"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <!-- 输入内容列：占据主要空间 -->
                                <ColumnDefinition Width="*" />
                                <!-- 键盘图标列：自适应宽度 -->
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <!--
                                PART_ContentHost：TextBox 的约定部件
                                WPF 框架会将用户输入的文本渲染到这个 ScrollViewer 中。
                                Focusable="False" 防止 ScrollViewer 抢夺焦点。
                                隐藏滚动条（输入框通常不需要滚动条）。
                            -->
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Grid.Column="0"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden" />
                            <!--
                                PART_Watermark：占位符文本（水印文字）
                                当输入为空时显示提示文字（如"请输入内容"）。
                                实现原理：通过 DataTrigger 监听 Text.Length，
                                长度为0时显示，否则隐藏。
                                IsHitTestVisible="False" 让点击穿透到下层的输入框。
                                TextTrimming="CharacterEllipsis" 超长时用省略号截断。
                            -->
                            <TextBlock x:Name="PART_Watermark"
                                       Grid.Column="0"
                                       Margin="{TemplateBinding Padding}"
                                       Text="{Binding Placeholder, RelativeSource={RelativeSource TemplatedParent}}"
                                       Foreground="#78FFFFFF"
                                       FontSize="{TemplateBinding FontSize}"
                                       VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                       IsHitTestVisible="False"
                                       TextTrimming="CharacterEllipsis">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <!-- 默认隐藏占位符 -->
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <!--
                                                DataTrigger：绑定表达式触发器
                                                当 Text.Length == 0 时，占位符可见。
                                                这是 WPF 中实现占位符的标准方式。
                                            -->
                                            <DataTrigger Binding="{Binding Text.Length, RelativeSource={RelativeSource TemplatedParent}}" Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <!--
                                PART_KeyboardIcon：触屏键盘图标按钮
                                默认隐藏（Visibility="Collapsed"），
                                代码中可根据需要显示（如触屏设备）。
                                &#x2328; 是 Unicode 字符 ⌨（键盘图标）。
                            -->
                            <Button x:Name="PART_KeyboardIcon"
                                    Grid.Column="1"
                                    Content="&#x2328;"
                                    Width="28" Height="28"
                                    Margin="0,0,6,0"
                                    FontSize="16"
                                    Foreground="#90FFFFFF"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    FocusVisualStyle="{x:Null}"
                                    Visibility="Collapsed"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- 悬停：边框变亮 -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource GcBorderHoverBrush}" />
                        </Trigger>
                        <!--
                            获得键盘焦点时：
                            1. 边框变为蓝色强调色
                            2. 背景略微加深（#12000000，极浅的黑色）
                            3. 添加蓝色投影，聚焦效果更明显
                            4. 隐藏占位符文字
                            多重视觉反馈确保用户清楚知道当前输入位置。
                        -->
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource GcAccentBrush}" />
                            <Setter TargetName="Root" Property="Background" Value="#12000000" />
                            <Setter TargetName="Root" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect BlurRadius="10" ShadowDepth="1" Opacity="0.4" Color="#4D6FE8" />
                                </Setter.Value>
                            </Setter>
                            <Setter TargetName="PART_Watermark" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <!-- 禁用：降低透明度 -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>









