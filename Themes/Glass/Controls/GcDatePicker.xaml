<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:GeneralControl.Controls">

    <!--
        ================================================================
        文件说明：Themes\Glass\Controls\GcDatePicker.xaml
        日历日期选择控件：玻璃输入框 + 弹出日历（用于日期筛选）。
        ================================================================
    -->

    <Style TargetType="controls:GcDatePicker">
        <Setter Property="Width" Value="170" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:GcDatePicker">
                    <Grid>
                        <!-- 输入框本体 -->
                        <Border x:Name="Root"
                                CornerRadius="8"
                                Background="{DynamicResource GlassControlBrush}"
                                BorderBrush="{DynamicResource GlassBorderBrush}"
                                BorderThickness="1">
                            <Grid Margin="12,0,10,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="PART_DisplayText"
                                           Grid.Column="0"
                                           VerticalAlignment="Center"
                                           FontSize="13"
                                           Foreground="{DynamicResource GlassTextBrush}" />
                                <!-- 日历图标 -->
                                <Canvas Grid.Column="1" Width="14" Height="14" VerticalAlignment="Center" Opacity="0.7">
                                    <Rectangle Canvas.Left="1" Canvas.Top="2.5" Width="12" Height="10.5"
                                               RadiusX="2" RadiusY="2"
                                               Stroke="{DynamicResource GlassTextSecondaryBrush}" StrokeThickness="1.3" />
                                    <Line X1="1" Y1="6" X2="13" Y2="6" Stroke="{DynamicResource GlassTextSecondaryBrush}" StrokeThickness="1.2" />
                                    <Line X1="4" Y1="0.8" X2="4" Y2="4" Stroke="{DynamicResource GlassTextSecondaryBrush}" StrokeThickness="1.3" />
                                    <Line X1="10" Y1="0.8" X2="10" Y2="4" Stroke="{DynamicResource GlassTextSecondaryBrush}" StrokeThickness="1.3" />
                                </Canvas>
                            </Grid>
                        </Border>

                        <!-- 命中开关（透明铺满） -->
                        <ToggleButton x:Name="PART_Toggle" Opacity="0" Focusable="False" Cursor="Hand" IsHitTestVisible="True" />

                        <!-- 日历弹层 -->
                        <Popup x:Name="PART_Popup"
                               PlacementTarget="{Binding ElementName=PART_Toggle}"
                               Placement="Bottom"
                               AllowsTransparency="True"
                               StaysOpen="False"
                               PopupAnimation="Fade">
                            <Border CornerRadius="10"
                                    Background="{DynamicResource GlassBackdropBrush}"
                                    BorderBrush="{DynamicResource GlassBorderBrush}"
                                    BorderThickness="1"
                                    Margin="0,4,8,8">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.25" Color="#000000" />
                                </Border.Effect>
                                <Calendar x:Name="PART_Calendar"
                                          Margin="6"
                                          Background="Transparent"
                                          BorderThickness="0" />
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource GlassBorderHoverBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
