<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:GeneralControl.Controls">

    <!--
        ================================================================
        文件说明：Themes\Glass\Controls\Card.xaml
        Card 卡片样式。
        特性：
        - 半透明渐变背景 + 边缘高光边框
        - 可选的"凸起"效果（IsElevated 属性），悬停时阴影增强
        - 支持 Header 标题，无标题时自动隐藏
        - ClipToBounds="True" 防止高光溢出圆角边界

        层级结构：
        Border(根) → Grid(裁剪) → [高光层 Border + 内容 Grid]
        高光层叠加在内容之上，但 IsHitTestVisible="False" 不影响交互。

        依赖：Brushes.xaml（画刷资源）。
        ================================================================
    -->

    <!--
        ===================== Card 卡片样式 =====================
        Card：毛玻璃卡片控件，用于内容分组和容器。
    -->
    <Style TargetType="controls:GcCard">
        <Setter Property="Background" Value="{DynamicResource GcBackdropBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource GcEdgeHighlightBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource GcTextBrush}" />
        <!-- Focusable="False"：卡片本身不获取焦点，焦点传递给内部子控件 -->
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Padding" Value="20" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:GcCard">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            SnapsToDevicePixels="True">
                        <Grid ClipToBounds="True">
                            <!--
                                顶部高光层：叠加 TopHighlightBrush
                                模拟光线从顶部照射到玻璃表面的高光效果
                                IsHitTestVisible="False" 确保点击穿透到下层内容
                            -->
                            <Border x:Name="TopHighlight"
                                    CornerRadius="{TemplateBinding CornerRadius}"
                                    IsHitTestVisible="False"
                                    Background="{DynamicResource GcTopHighlightBrush}" />
                            <!-- 内容区域：带 Padding 的 Grid -->
                            <Grid Margin="{TemplateBinding Padding}">
                                <Grid.RowDefinitions>
                                    <!-- Auto 行：标题高度由文字撑开 -->
                                    <RowDefinition Height="Auto" />
                                    <!-- * 行：内容区域占据剩余空间 -->
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <!--
                                    HeaderText：卡片标题
                                    15号半粗体白色文字
                                    绑定 TemplateBinding Header，由控件的 Header 属性提供
                                -->
                                <TextBlock x:Name="HeaderText"
                                           Grid.Row="0"
                                           Text="{TemplateBinding Header}"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource GcTextBrush}"
                                           Margin="0,0,0,10" />
                                <!-- ContentPresenter：显示卡片的主要内容 -->
                                <ContentPresenter Grid.Row="1"
                                                  Content="{TemplateBinding Content}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                            </Grid>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!--
                            Trigger 1：IsElevated = True（凸起状态）
                            添加 DropShadowEffect 投影，使卡片视觉上"浮起"。
                            ShadowDepth=5 表示投影偏移5像素，Direction=270 表示光源在正上方。
                            使用深蓝色投影（#000814）而非纯黑，与主题色调协调。
                        -->
                        <Trigger Property="IsElevated" Value="True">
                            <Setter TargetName="Root" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect BlurRadius="18"
                                                      ShadowDepth="5"
                                                      Direction="270"
                                                      Opacity="0.55"
                                                      Color="#000814" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <!--
                            MultiTrigger：同时满足多个条件时生效
                            条件1：IsMouseOver = True（鼠标悬停）
                            条件2：IsElevated = True（凸起状态）
                            两个条件同时满足时：
                            - 增大投影（BlurRadius=18→30, ShadowDepth=5→14），卡片进一步"浮起"
                            - 替换边框为更亮的渐变，模拟悬停时边缘光增强
                            这种复合条件触发是 WPF Trigger 的强大之处。
                        -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsElevated" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Root" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect BlurRadius="30"
                                                      ShadowDepth="14"
                                                      Direction="270"
                                                      Opacity="0.55"
                                                      Color="#000814" />
                                </Setter.Value>
                            </Setter>
                            <Setter TargetName="Root" Property="BorderBrush">
                                <Setter.Value>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#9AFFFFFF" Offset="0" />
                                        <GradientStop Color="#30FFFFFF" Offset="0.4" />
                                        <GradientStop Color="#30E0F6FF" Offset="0.7" />
                                        <GradientStop Color="#7AFFFFFF" Offset="1" />
                                    </LinearGradientBrush>
                                </Setter.Value>
                            </Setter>
                        </MultiTrigger>
                        <!--
                            Trigger 3：Header 为空字符串时
                            隐藏标题 TextBlock，节省空间。
                            Visibility="Collapsed" 完全移除元素（不占空间），
                            与 Hidden（占空间但不可见）不同。
                        -->
                        <Trigger Property="Header" Value="">
                            <Setter TargetName="HeaderText" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>









