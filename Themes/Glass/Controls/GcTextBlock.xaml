<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:GeneralControl.Controls">

    <!--
        ================================================================
        文件说明：Themes\Glass\Controls\TextBlock.xaml
        TextBlock 文本块样式（半透明白色正文）。

        依赖：Brushes.xaml（画刷资源）。
        ================================================================
    -->

    <Style TargetType="controls:GcTextBlock">
        <Setter Property="Foreground" Value="{DynamicResource GcTextSecondaryBrush}" />
        <Setter Property="FontSize" Value="13" />
    </Style>

</ResourceDictionary>







