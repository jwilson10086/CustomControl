<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:GeneralControl.Controls">

    <!--
        ================================================================
        文件说明：Themes\Glass\Controls\GcScaraRobot.xaml
        SCARA 机械手（俯视图）：基座 → 肩关节大臂 → 肘关节小臂 → 末端吸盘。

        【角度】ShoulderAngle/ElbowAngle 相对父级，顺时针为正，
        通过 TemplateBinding 驱动 RotateTransform.Angle。
        HoldingWafer 控制末端晶圆显隐；IsServoOn 控制基座伺服指示灯。
        ================================================================
    -->

    <Style TargetType="controls:GcScaraRobot">
        <Setter Property="Width" Value="120" />
        <Setter Property="Height" Value="120" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:GcScaraRobot">
                    <Viewbox Stretch="Uniform">
                        <Canvas Width="240" Height="240">

                            <!-- 地面投影 -->
                            <Ellipse Canvas.Left="18" Canvas.Top="98"
                                     Width="150" Height="150"
                                     Fill="#0DFFFFFF" />

                            <!-- 基座 -->
                            <Ellipse Canvas.Left="30" Canvas.Top="80"
                                     Width="80" Height="80"
                                     Fill="#1FFFFFFF"
                                     Stroke="{DynamicResource GcEdgeHighlightBrush}"
                                     StrokeThickness="1.6" />
                            <!-- 伺服指示灯 -->
                            <Ellipse x:Name="PART_ServoDot"
                                     Canvas.Left="62" Canvas.Top="88"
                                     Width="8" Height="8" Fill="#35D07F" />

                            <!-- ============ 大臂（肩关节） ============ -->
                            <Canvas Canvas.Left="70" Canvas.Top="120">
                                <Canvas.RenderTransform>
                                    <RotateTransform Angle="{TemplateBinding ShoulderAngle}" />
                                </Canvas.RenderTransform>

                                <!-- 大臂主体：沿 +X 方向长 92 -->
                                <Rectangle Canvas.Left="14" Canvas.Top="-12"
                                           Width="86" Height="24"
                                           RadiusX="12" RadiusY="12">
                                    <Rectangle.Fill>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Offset="0" Color="#FFE4EAF0" />
                                            <GradientStop Offset="1" Color="#FF9AA8B5" />
                                        </LinearGradientBrush>
                                    </Rectangle.Fill>
                                    <Rectangle.Stroke>
                                        <SolidColorBrush Color="#88FFFFFF" />
                                    </Rectangle.Stroke>
                                </Rectangle>

                                <!-- 肘关节容器 -->
                                <Canvas Canvas.Left="92" Canvas.Top="0">
                                    <Canvas.RenderTransform>
                                        <RotateTransform Angle="{TemplateBinding ElbowAngle}" />
                                    </Canvas.RenderTransform>
                                    <!-- 肘关节圆 -->
                                    <Ellipse Canvas.Left="-11" Canvas.Top="-11"
                                             Width="22" Height="22"
                                             Fill="#B5C2CB" Stroke="#88FFFFFF" StrokeThickness="1" />
                                    <!-- 小臂主体：沿 +X 长 88 -->
                                    <Rectangle Canvas.Left="8" Canvas.Top="-10"
                                               Width="82" Height="20"
                                               RadiusX="10" RadiusY="10">
                                        <Rectangle.Fill>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Offset="0" Color="#FFDDE4EC" />
                                                <GradientStop Offset="1" Color="#FF93A2B1" />
                                            </LinearGradientBrush>
                                        </Rectangle.Fill>
                                        <Rectangle.Stroke>
                                            <SolidColorBrush Color="#88FFFFFF" />
                                        </Rectangle.Stroke>
                                    </Rectangle>
                                    <!-- 末端吸盘座 -->
                                    <Ellipse Canvas.Left="82" Canvas.Top="-16"
                                             Width="32" Height="32"
                                             Fill="#B5C2CB" Stroke="#99FFFFFF" StrokeThickness="1.2" />
                                    <Ellipse Canvas.Left="90" Canvas.Top="-8"
                                             Width="16" Height="16"
                                             Fill="#66FFFFFF" />
                                    <!-- 吸附的晶圆 -->
                                    <Ellipse x:Name="PART_Wafer"
                                             Canvas.Left="68" Canvas.Top="-32"
                                             Width="64" Height="64"
                                             Fill="#33FFFFFF"
                                             Stroke="{DynamicResource GlassTextSecondaryBrush}"
                                             StrokeThickness="1.5"
                                             Opacity="0.9" />
                                </Canvas>

                                <!-- 肩关节盖板（压住大臂根部） -->
                                <Ellipse Canvas.Left="-26" Canvas.Top="-26"
                                         Width="52" Height="52"
                                         Fill="#B5C2CB"
                                         Stroke="{DynamicResource GcEdgeHighlightBrush}"
                                         StrokeThickness="1.4" />
                                <Ellipse Canvas.Left="-9" Canvas.Top="-9"
                                         Width="18" Height="18"
                                         Fill="#66FFFFFF" />
                            </Canvas>
                        </Canvas>
                    </Viewbox>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HoldingWafer" Value="False">
                            <Setter TargetName="PART_Wafer" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsServoOn" Value="False">
                            <Setter TargetName="PART_ServoDot" Property="Fill" Value="#44FFFFFF" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
