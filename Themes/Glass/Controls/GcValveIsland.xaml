<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:GeneralControl.Controls">

    <!--
        ================================================================
        文件说明：Themes\Glass\Controls\GcValveIsland.xaml
        阀岛本体：一条铝制汇流板，N 片等宽阀位并排卡在上面，底部一条
        DIN 导轨底座。

        视觉风格：iOS 扁平化。
        扁平化只去掉拟物感（斜切、浮雕、写实高光、纹理），圆角、柔和投影、
        极浅渐变、层次这些都保留——这正是 iOS 的质感来源：
          · 汇流板是一个大圆角面，带一层很轻的投影，暗示它浮在导轨之上；
          · 板面用上亮下暗的极浅渐变表达厚度，不做金属拉丝；
          · 阀位之间零间隙，靠各自的卡缝自然分隔，连成一条整体；
          · 底部导轨底座独立一层，做出"板压在轨上"的两段高度。

        结构：Grid → 汇流板面(带投影) 与 PART_ValveRow 同层叠放，导轨底座单独一行
              行/列由 GcValveIsland 依 Orientation 设置：
              横向 Rows=1 / Columns=0（一行排开），纵向 Rows=0 / Columns=1。

        【数量】由 ValveCount 决定（1~64），控件在 OnApplyTemplate 时
        自动生成阀位，ValveCount 变化会重建。
        【状态】阀位开关状态存于 GcValveIsland.States（可绑定），
        每次切换抛出 ValveToggled 事件。
        ================================================================
    -->

    <Style TargetType="controls:GcValveIsland">
        <Setter Property="Height" Value="60" />
        <Setter Property="MinWidth" Value="52" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:GcValveIsland">
                    <Grid>
                        <Grid.RowDefinitions>
                            <!-- 汇流板面自适应，导轨底座固定 10px -->
                            <RowDefinition Height="*" />
                            <RowDefinition Height="10" />
                        </Grid.RowDefinitions>

                        <!--
                            汇流板面。投影挂在这个纯色 Border 上，而不是整棵视觉树，
                            避免把阀位里的文字和 LED 一起栅格化导致发虚。
                        -->
                        <Border x:Name="PART_Bar"
                                Grid.Row="0"
                                BorderBrush="#3DFFFFFF"
                                BorderThickness="1"
                                CornerRadius="11">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="14"
                                                  Direction="270"
                                                  ShadowDepth="3"
                                                  Color="#FF000000"
                                                  Opacity="0.22" />
                            </Border.Effect>
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#2BFFFFFF" Offset="0" />
                                    <GradientStop Color="#17FFFFFF" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>

                        <UniformGrid x:Name="PART_ValveRow" Grid.Row="0" />

                        <!-- DIN 导轨底座：比板面短一点、颜色更深，做出两级高度 -->
                        <Border x:Name="PART_Rail"
                                Grid.Row="1"
                                Margin="7,1,7,0"
                                Background="#14FFFFFF"
                                CornerRadius="4" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
