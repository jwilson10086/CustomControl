<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:GeneralControl.Controls">

    <!--
        ================================================================
        文件说明：Themes\Glass\Controls\Dialog.xaml
        列表选择对话框样式，并定义弹窗通用按钮样式：
        - DialogButtonStyle：弹窗普通按钮（如"取消"）
        - DialogConfirmStyle：弹窗确认按钮（蓝色主色调）
        这两个按钮样式同时被 InputDialog 和 KeyboardPopup
        的模板引用（跨文件处使用 DynamicResource）。

        依赖：Brushes.xaml（画刷资源）。
        ================================================================
    -->

    <!--
        ===================== 弹窗按钮样式 =====================
        DialogButtonStyle：弹窗中普通按钮的样式（如"取消"按钮）。
        与键盘按键样式类似，但尺寸更小（字体14号），内边距更大（24,10），
        圆角略大（9px），更符合弹窗按钮的视觉比例。
    -->
    <Style x:Key="GcDialogButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="#25FFFFFF" />
        <Setter Property="BorderBrush" Value="#25FFFFFF" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="#E0FFFFFF" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <!-- Padding：水平24px、垂直10px的内边距，让按钮有舒适的点击区域 -->
        <Setter Property="Padding" Value="24,10" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="9"
                            SnapsToDevicePixels="True">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- 悬停：背景和边框稍微变亮 -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="#35FFFFFF" />
                            <Setter TargetName="Root" Property="BorderBrush" Value="#40FFFFFF" />
                        </Trigger>
                        <!-- 按下：蓝色调背景 + 缩放96%的物理反馈（比键盘按键缩放略小，因为弹窗按钮更宽大） -->
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="#504FB6FF" />
                            <Setter TargetName="Root" Property="RenderTransform" Value="0.96,0,0,0.96,0,0" />
                            <Setter TargetName="Root" Property="RenderTransformOrigin" Value="0.5,0.5" />
                        </Trigger>
                        <!-- 禁用：降低透明度 -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        ===================== 弹窗确认按钮（蓝色主色调） =====================
        DialogConfirmStyle：继承自上方 DialogButtonStyle（同文件 StaticResource），
        仅将背景和边框改为蓝色调，用于弹窗中的"确认"等主要操作。
        与普通弹窗按钮形成主次对比，引导用户视线。
    -->
    <Style x:Key="GcDialogConfirmStyle" TargetType="Button"
           BasedOn="{StaticResource GcDialogButtonStyle}">
        <Setter Property="Background" Value="#4FB6FF" />
        <Setter Property="BorderBrush" Value="#6FC8FF" />
        <Setter Property="Foreground" Value="White" />
    </Style>

    <!--
        ===================== 列表对话框 =====================
        Dialog：用于显示列表选择的对话框。
        布局结构（从上到下）：
        1. 标题（Title）
        2. 内容区域（Content）—— 可放置说明文字等
        3. 列表区域（ListBox）—— 带滚动的选项列表
        4. 底部按钮（取消 + 确认）

        隐式样式，自动应用于所有 Dialog 控件。
        支持自定义属性：Title、Items、CancelText、ConfirmText。
    -->
    <Style TargetType="controls:GcDialog">
        <Setter Property="Background" Value="#E81A1A2E" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="MinWidth" Value="340" />
        <Setter Property="MaxWidth" Value="480" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:GcDialog">
                    <!--
                        外层 Border：深色毛玻璃外观
                        Padding="24" 比键盘弹窗更大，因为对话框内容更丰富
                    -->
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="16"
                            Padding="24"
                            BorderBrush="#30FFFFFF"
                            BorderThickness="1">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.5" Color="#000" />
                        </Border.Effect>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!--
                                Row 0：标题文本
                                绑定 TemplateBinding Title，由控件的 Title 属性提供
                                18号粗体白色文字，底部16px间距
                            -->
                            <TextBlock Grid.Row="0"
                                       Text="{TemplateBinding Title}"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Margin="0,0,0,16" />

                            <!--
                                Row 1：内容区域
                                ContentPresenter 显示控件的 Content 属性内容
                                可以放置描述文字、图标等任意内容
                            -->
                            <ContentPresenter Grid.Row="1" Margin="0,0,0,12" />

                            <!--
                                Row 2：列表区域
                                外层 Border 提供半透明背景和圆角，作为列表的容器
                                MaxHeight="300" 限制列表最大高度，防止弹窗过大
                            -->
                            <Border Grid.Row="2"
                                    Background="#15FFFFFF"
                                    CornerRadius="10"
                                    Padding="4"
                                    Margin="0,0,0,16"
                                    MaxHeight="300">
                                <!--
                                    ListBox：显示选项列表
                                    ItemsSource 绑定到控件的 Items 属性
                                    ScrollViewer 禁用水平滚动，内容过长时垂直滚动
                                -->
                                <ListBox x:Name="PART_ListBox"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         ItemsSource="{TemplateBinding Items}"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <!--
                                        ItemContainerStyle：列表项的自定义样式
                                        每个 ListBoxItem 使用自定义模板：
                                        - 悬停时显示半透明白色背景
                                        - 选中时显示蓝色背景（与主题色调一致）
                                        - 圆角8px，保持整体风格统一
                                    -->
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Padding" Value="12,10" />
                                            <Setter Property="Foreground" Value="#E0FFFFFF" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <Border x:Name="Bd"
                                                                Background="Transparent"
                                                                CornerRadius="8"
                                                                Padding="{TemplateBinding Padding}"
                                                                Margin="2">
                                                            <ContentPresenter />
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <!-- 悬停：显示微弱白色背景 -->
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Bd" Property="Background" Value="#20FFFFFF" />
                                                            </Trigger>
                                                            <!-- 选中：显示蓝色背景，明确标识当前选择 -->
                                                            <Trigger Property="IsSelected" Value="True">
                                                                <Setter TargetName="Bd" Property="Background" Value="#304FB6FF" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                </ListBox>
                            </Border>

                            <!--
                                Row 3：底部按钮区
                                三列布局：第一列(*)空列占位，第二列取消，第三列确认
                                这种布局使按钮右对齐，符合常见的对话框按钮位置习惯
                            -->
                            <Grid Grid.Row="3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button x:Name="PART_CancelButton"
                                        Grid.Column="1"
                                        Content="{TemplateBinding CancelText}"
                                        Style="{StaticResource GcDialogButtonStyle}"
                                        Margin="0,0,12,0" />
                                <Button x:Name="PART_ConfirmButton"
                                        Grid.Column="2"
                                        Content="{TemplateBinding ConfirmText}"
                                        Style="{StaticResource GcDialogConfirmStyle}" />
                            </Grid>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>









