<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:GeneralControl.Controls">

    <!-- Glass 整流器面板样式 -->
    <Style TargetType="controls:GcRectifier">
        <Setter Property="Width" Value="260" />
        <Setter Property="Height" Value="226" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:GcRectifier">
                    <Border CornerRadius="12"
                            Background="#1FFFFFFF"
                            BorderBrush="{DynamicResource GcEdgeHighlightBrush}"
                            BorderThickness="1.4"
                            Padding="12,10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- 标题行 -->
                            <Grid Grid.Row="0" Margin="2,0,2,8">
                                <TextBlock Text="整流器 RECTIFIER" FontSize="12" FontWeight="Bold"
                                           Foreground="{DynamicResource GcTextBrush}"
                                           VerticalAlignment="Center" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Ellipse x:Name="PART_AlarmDot" Width="9" Height="9"
                                             Fill="#3F8F8F8F" Margin="0,0,5,0" />
                                    <TextBlock Text="报警" FontSize="8.5" Foreground="{DynamicResource GcTextSecondaryBrush}"
                                               Margin="0,0,10,0" />
                                    <Ellipse x:Name="PART_PowerDot" Width="9" Height="9" Fill="#3F8F8F8F" />
                                    <TextBlock Text="电源" FontSize="8.5" Foreground="{DynamicResource GcTextSecondaryBrush}"
                                               Margin="2,0,0,0" />
                                </StackPanel>
                            </Grid>

                            <!-- 设定行 -->
                            <Grid Grid.Row="1" Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="设定电压" FontSize="9.5"
                                           Foreground="{DynamicResource GcTextSecondaryBrush}"
                                           VerticalAlignment="Center" Margin="0,0,6,0" />
                                <controls:GcNumericBox Grid.Column="1" Height="24"
                                           Minimum="0" Maximum="400" Increment="1" DecimalPlaces="1"
                                           Value="{Binding SetVoltage, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" />
                                <TextBlock Grid.Column="2" Text="设定电流" FontSize="9.5"
                                           Foreground="{DynamicResource GcTextSecondaryBrush}"
                                           VerticalAlignment="Center" Margin="10,0,6,0" />
                                <controls:GcNumericBox Grid.Column="3" Height="24"
                                           Minimum="0" Maximum="50" Increment="0.5" DecimalPlaces="1"
                                           Value="{Binding SetCurrent, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" />
                            </Grid>

                            <!-- 当前值行 -->
                            <Border Grid.Row="2" Margin="0,6,0,2" CornerRadius="6" Background="#14FFFFFF"
                                    BorderBrush="#1FFFFFFF" BorderThickness="1" Padding="8,5">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="当前电压" FontSize="8" Foreground="{DynamicResource GcTextSecondaryBrush}" />
                                        <TextBlock x:Name="PART_CurVolt" FontSize="15" FontWeight="Bold"
                                                   Foreground="{DynamicResource GcTextBrush}"
                                                   Text="{Binding CurrentVoltage, RelativeSource={RelativeSource TemplatedParent}, StringFormat={}{0:0.0}V}" />
                                    </StackPanel>
                                    <Border Grid.Column="1" Width="1" Margin="10,0" Background="#22FFFFFF" />
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="当前电流" FontSize="8" Foreground="{DynamicResource GcTextSecondaryBrush}" />
                                        <TextBlock x:Name="PART_CurCurr" FontSize="15" FontWeight="Bold"
                                                   Foreground="{DynamicResource GcTextBrush}"
                                                   Text="{Binding CurrentCurrent, RelativeSource={RelativeSource TemplatedParent}, StringFormat={}{0:0.0}A}" />
                                    </StackPanel>
                                    <Border Grid.Column="3" Width="1" Margin="10,0" Background="#22FFFFFF" />
                                </Grid>
                            </Border>

                            <!-- 电压报警行 -->
                            <Grid Grid.Row="3" Margin="0,6,0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="电压报警" FontSize="9.5"
                                           Foreground="{DynamicResource GcTextSecondaryBrush}"
                                           VerticalAlignment="Center" Margin="0,0,6,0" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <controls:GcNumericBox Width="52" Height="22"
                                               Minimum="0" Maximum="400" Increment="1" DecimalPlaces="0"
                                               Value="{Binding AlarmLowVoltage, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" />
                                    <TextBlock Text="~" FontSize="9" Foreground="{DynamicResource GcTextSecondaryBrush}"
                                               VerticalAlignment="Center" Margin="3,0" />
                                    <controls:GcNumericBox Width="52" Height="22"
                                               Minimum="0" Maximum="400" Increment="1" DecimalPlaces="0"
                                               Value="{Binding AlarmHighVoltage, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="电流报警" FontSize="9.5"
                                           Foreground="{DynamicResource GcTextSecondaryBrush}"
                                           VerticalAlignment="Center" Margin="10,0,6,0" />
                                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                    <controls:GcNumericBox Width="52" Height="22"
                                               Minimum="0" Maximum="50" Increment="0.5" DecimalPlaces="0"
                                               Value="{Binding AlarmLowCurrent, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" />
                                    <TextBlock Text="~" FontSize="9" Foreground="{DynamicResource GcTextSecondaryBrush}"
                                               VerticalAlignment="Center" Margin="3,0" />
                                    <controls:GcNumericBox Width="52" Height="22"
                                               Minimum="0" Maximum="50" Increment="0.5" DecimalPlaces="0"
                                               Value="{Binding AlarmHighCurrent, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" />
                                </StackPanel>
                            </Grid>

                            <!-- 开关行 -->
                            <Grid Grid.Row="4" Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="整流器开关" FontSize="9.5"
                                           Foreground="{DynamicResource GcTextSecondaryBrush}"
                                           VerticalAlignment="Center" Margin="0,0,8,0" />
                                <ToggleButton Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center"
                                              IsChecked="{Binding IsOn, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                              Width="52" Height="24" Cursor="Hand">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border x:Name="Track" CornerRadius="12" Background="#22FFFFFF"
                                                    BorderBrush="{DynamicResource GcEdgeHighlightBrush}" BorderThickness="1">
                                                <Grid>
                                                    <TextBlock x:Name="Txt" Text="OFF" FontSize="8" FontWeight="Bold"
                                                               Foreground="{DynamicResource GcTextSecondaryBrush}"
                                                               VerticalAlignment="Center" HorizontalAlignment="Center" />
                                                    <Ellipse x:Name="Knob" Width="18" Height="18" Fill="#B8FFFFFF"
                                                             HorizontalAlignment="Left" Margin="3,0,0,0" />
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="Track" Property="Background" Value="#35D07F" />
                                                    <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                                                    <Setter TargetName="Txt" Property="Text" Value="ON" />
                                                    <Setter TargetName="Txt" Property="Foreground" Value="#0A0A0A" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                                <TextBlock Grid.Column="2" x:Name="PART_StatusText" Text="已停止" FontSize="9.5"
                                           Foreground="{DynamicResource GcTextSecondaryBrush}"
                                           VerticalAlignment="Center" Margin="8,0,0,0" />
                            </Grid>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- 电源开：绿灯亮起 + 微光 -->
                        <Trigger Property="IsOn" Value="True">
                            <Setter TargetName="PART_PowerDot" Property="Fill" Value="#35D07F" />
                            <Setter TargetName="PART_StatusText" Property="Text" Value="运行中" />
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="PowerGlow">
                                    <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                        <DoubleAnimation Storyboard.TargetName="PART_PowerDot"
                                                         Storyboard.TargetProperty="Opacity"
                                                         From="1" To="0.55" Duration="0:0:0.9" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <StopStoryboard BeginStoryboardName="PowerGlow" />
                            </Trigger.ExitActions>
                        </Trigger>
                        <!-- 报警：红灯呼吸闪烁 + 当前值变红 -->
                        <Trigger Property="IsAlarm" Value="True">
                            <Setter TargetName="PART_AlarmDot" Property="Fill" Value="#FF5555" />
                            <Setter TargetName="PART_CurVolt" Property="Foreground" Value="#FF7A7A" />
                            <Setter TargetName="PART_CurCurr" Property="Foreground" Value="#FF7A7A" />
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="AlarmBlink">
                                    <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                        <DoubleAnimation Storyboard.TargetName="PART_AlarmDot"
                                                         Storyboard.TargetProperty="Opacity"
                                                         From="1" To="0.2" Duration="0:0:0.4" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <StopStoryboard BeginStoryboardName="AlarmBlink" />
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
