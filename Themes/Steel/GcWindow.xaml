<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:GeneralControl.Controls">

    <!-- 窗体投影效果 -->
    <DropShadowEffect x:Key="WindowShadowEffect"
                      BlurRadius="24"
                      ShadowDepth="4"
                      Direction="270"
                      Opacity="0.35"
                      Color="#000814" />

    <!-- 窗体边缘高光（玻璃边缘反光） -->
    <LinearGradientBrush x:Key="GcFrameHighlightBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#70334155" Offset="0" />
        <GradientStop Color="#18334155" Offset="0.35" />
        <GradientStop Color="#183CB82E" Offset="0.65" />
        <GradientStop Color="#5A334155" Offset="1" />
    </LinearGradientBrush>

    <!-- 窗体玻璃底色（模拟模式的占位背景，代码会根据模式替换） -->
    <LinearGradientBrush x:Key="WindowBackdropBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#38334155" Offset="0" />
        <GradientStop Color="#2A334155" Offset="0.45" />
        <GradientStop Color="#1E334155" Offset="1" />
    </LinearGradientBrush>

    <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />

    <!-- 自定义标题栏按钮（毛玻璃圆形） -->
    <Style x:Key="GcCaptionButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Margin" Value="4,0" />
        <Setter Property="Background" Value="#26334155" />
        <Setter Property="BorderBrush" Value="#33334155" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="#E0FFFFFF" />
        <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="15">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="#44334155" />
                            <Setter TargetName="Root" Property="BorderBrush" Value="#66334155" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="#66334155" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 关闭按钮（悬停变红） -->
    <Style x:Key="GcCaptionCloseButtonStyle" TargetType="Button" BasedOn="{StaticResource GcCaptionButtonStyle}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="15">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="#E8423A" />
                            <Setter TargetName="Root" Property="BorderBrush" Value="#E8423A" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="#C43832" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================= Window 窗体模板 ================= -->
    <Style x:Key="GcWindowStyle" TargetType="controls:GcWindow">
        <Setter Property="WindowStyle" Value="None" />
        <Setter Property="AllowsTransparency" Value="True" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="ResizeMode" Value="CanResize" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:GcWindow">
                    <Border x:Name="ShadowHost"
                            Margin="16"
                            Background="Transparent">
                        <Border.Effect>
                            <DynamicResource ResourceKey="WindowShadowEffect" />
                        </Border.Effect>

                        <Border x:Name="WindowFrame"
                                Background="{DynamicResource WindowBackdropBrush}"
                                BorderThickness="0"
                                ClipToBounds="True">

                            <Grid>
                                <!-- 液体玻璃着色器层（Glassy 模式由代码填充背景并在其上挂 GlassyEffect） -->
                                <Border x:Name="GlassyLayer"
                                        IsHitTestVisible="False"
                                        Background="Transparent"
                                        RenderOptions.BitmapScalingMode="NearestNeighbor" />

                                <!-- 内容区 -->
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <!-- 自定义标题栏 -->
                                    <Border x:Name="PART_CaptionBar"
                                            Grid.Row="0"
                                            Height="{TemplateBinding CaptionHeight}"
                                            Visibility="{Binding IsCaptionVisible, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BoolToVisibilityConverter}}"
                                            Background="Transparent">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- 品牌标识 -->
                                            <Border Grid.Column="0"
                                                    Width="26"
                                                    Height="26"
                                                    Margin="18,0,10,0"
                                                    CornerRadius="8"
                                                    VerticalAlignment="Center">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                        <GradientStop Color="#6EE7A0" Offset="0" />
                                                        <GradientStop Color="#189A4A" Offset="1" />
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                                <Border.Effect>
                                                    <DropShadowEffect BlurRadius="8"
                                                                      ShadowDepth="1"
                                                                      Opacity="0.5"
                                                                      Color="#6690BF" />
                                                </Border.Effect>
                                                <Path Data="M 6 15 L 12 9 L 15 12 L 9 18 Z"
                                                      Fill="#1F2937"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center" />
                                            </Border>

                                            <!-- 标题 -->
                                            <TextBlock Grid.Column="1"
                                                       Text="{TemplateBinding Title}"
                                                       Foreground="#334155"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" />

                                            <!-- 窗口控制按钮 -->
                                            <StackPanel Grid.Column="2"
                                                        Orientation="Horizontal"
                                                        Margin="0,0,14,0"
                                                        VerticalAlignment="Center"
                                                        Visibility="{Binding IsTitleBarButtonsVisible, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <Button x:Name="PART_MinButton"
                                                        Content="&#xE921;"
                                                        Style="{DynamicResource GcCaptionButtonStyle}"
                                                        ToolTip="最小化" />
                                                <Button x:Name="PART_MaxButton"
                                                        Content="&#xE922;"
                                                        Style="{DynamicResource GcCaptionButtonStyle}"
                                                        ToolTip="最大化" />
                                                <Button x:Name="PART_CloseButton"
                                                        Content="&#xE8BB;"
                                                        Style="{DynamicResource GcCaptionCloseButtonStyle}"
                                                        ToolTip="关闭" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- 页面/内容宿主
                                         必须包 AdornerDecorator：AdornerLayer 由它提供，
                                         否则 GetAdornerLayer 返回 null，编辑器选框/手柄、
                                         Badge 等装饰层全部失效 -->
                                    <AdornerDecorator Grid.Row="1">
                                        <ContentPresenter
                                            Content="{TemplateBinding Content}"
                                            ContentTemplate="{TemplateBinding ContentTemplate}" />
                                    </AdornerDecorator>
                                </Grid>

                                <!-- 底部玻璃着色渐变 -->
                                <Border IsHitTestVisible="False">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#00000000" Offset="0" />
                                            <GradientStop Color="#0A000000" Offset="0.7" />
                                            <GradientStop Color="#18000000" Offset="1" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>

                                <!-- 玻璃边缘高光 -->
                                <Border IsHitTestVisible="False"
                                        BorderThickness="1.2">
                                    <Border.BorderBrush>
                                        <DynamicResource ResourceKey="FrameHighlightBrush" />
                                    </Border.BorderBrush>
                                </Border>

                                <!-- 缩放手柄热区 -->
                                <Border x:Name="PART_ResizeBorder"
                                        BorderThickness="8"
                                        BorderBrush="Transparent" />
                            </Grid>
                        </Border>
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="WindowState" Value="Maximized">
                            <Setter TargetName="ShadowHost" Property="Margin" Value="0" />
                            <Setter TargetName="WindowFrame" Property="CornerRadius" Value="0" />
                        </Trigger>
                        <Trigger Property="IsCaptionVisible" Value="False">
                            <Setter TargetName="PART_CaptionBar" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsTitleBarButtonsVisible" Value="False">
                            <Setter TargetName="PART_MinButton" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PART_MaxButton" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PART_CloseButton" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="controls:GcWindow"
           BasedOn="{StaticResource GcWindowStyle}" />

</ResourceDictionary>










