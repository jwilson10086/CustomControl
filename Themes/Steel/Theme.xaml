<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        ================================================================
        文件说明：Themes\SteelTheme.xaml
        工业·拟物钢灰主题入口（Neumorphism / Industrial Steel）。
        风格依据 ui-ux-pro-max 设计系统引擎推荐：
        单色板岩灰、浮雕双向明暗、圆角 12-16、实色无透明、状态色绿/黄/红。

        与 Glass 主题完全对等的合并结构（被依赖者在前）：
        模板文件位于 Themes\Steel\Controls\，画刷位于 Brushes.xaml，
        资源键名与玻璃主题一致，可整体互换（App.xaml 改一行即切换主题）。
        ================================================================
    -->
    <ResourceDictionary.MergedDictionaries>
        <!-- 1. 画刷基础 -->
        <ResourceDictionary Source="Brushes.xaml" />
        <!-- 2. 窗体 -->
        <ResourceDictionary Source="GcWindow.xaml" />
        <!-- 3. 基础输入控件 -->
        <ResourceDictionary Source="Controls\GcButton.xaml" />
        <ResourceDictionary Source="Controls\GcToggleButton.xaml" />
        <ResourceDictionary Source="Controls\GcTextBox.xaml" />
        <ResourceDictionary Source="Controls\GcPasswordBox.xaml" />
        <!-- 4. 选择控件 -->
        <ResourceDictionary Source="Controls\GcCheckBox.xaml" />
        <ResourceDictionary Source="Controls\GcRadioButton.xaml" />
        <ResourceDictionary Source="Controls\GcToggleSwitch.xaml" />
        <ResourceDictionary Source="Controls\GcComboBoxItem.xaml" />
        <ResourceDictionary Source="Controls\GcComboBox.xaml" />
        <!-- 5. 数值/展示控件 -->
        <ResourceDictionary Source="Controls\GcSlider.xaml" />
        <ResourceDictionary Source="Controls\GcProgressBar.xaml" />
        <ResourceDictionary Source="Controls\GcTextBlock.xaml" />
        <ResourceDictionary Source="Controls\GcLabel.xaml" />
        <!-- 6. 容器控件 -->
        <ResourceDictionary Source="Controls\GcGroupBox.xaml" />
        <ResourceDictionary Source="Controls\GcSeparator.xaml" />
        <ResourceDictionary Source="Controls\GcExpander.xaml" />
        <ResourceDictionary Source="Controls\GcToolTip.xaml" />
        <!-- 7. 菜单/导航 -->
        <ResourceDictionary Source="Controls\GcMenuItem.xaml" />
        <ResourceDictionary Source="Controls\GcContextMenu.xaml" />
        <ResourceDictionary Source="Controls\GcListBoxItem.xaml" />
        <ResourceDictionary Source="Controls\GcListBox.xaml" />
        <ResourceDictionary Source="Controls\GcTabItem.xaml" />
        <ResourceDictionary Source="Controls\GcTabControl.xaml" />
        <!-- 8. 滚动/表格 -->
        <ResourceDictionary Source="Controls\GcScrollBar.xaml" />
        <ResourceDictionary Source="Controls\GcDataGrid.xaml" />
        <!-- 9. 卡片容器 -->
        <ResourceDictionary Source="Controls\GcCard.xaml" />
        <ResourceDictionary Source="Controls\GcPanel.xaml" />
        <!-- 10. 弹窗体系 -->
        <ResourceDictionary Source="Controls\GcDialog.xaml" />
        <ResourceDictionary Source="Controls\GcInputDialog.xaml" />
        <ResourceDictionary Source="Controls\GcKeyboardPopup.xaml" />
        <!-- 11. 扩展控件 -->
        <ResourceDictionary Source="Controls\GcTag.xaml" />
        <ResourceDictionary Source="Controls\GcNumericBox.xaml" />
        <ResourceDictionary Source="Controls\GcAvatar.xaml" />
        <!-- 12. 工业元件 -->
        <ResourceDictionary Source="Controls\GcValve.xaml" />
        <ResourceDictionary Source="Controls\GcPump.xaml" />
        <ResourceDictionary Source="Controls\GcTank.xaml" />
        <ResourceDictionary Source="Controls\GcPipe.xaml" />
        <ResourceDictionary Source="Controls\GcCylinder.xaml" />
        <ResourceDictionary Source="Controls\GcFlowMeter.xaml" />
        <ResourceDictionary Source="Controls\GcThermoController.xaml" />
        <ResourceDictionary Source="Controls\GcMotor.xaml" />
        <ResourceDictionary Source="Controls\GcRectifier.xaml" />
        <ResourceDictionary Source="Controls\GcSignalTower.xaml" />
        <ResourceDictionary Source="Controls\GcChiller.xaml" />
        <ResourceDictionary Source="Controls\GcDatePicker.xaml" />
        <ResourceDictionary Source="Controls\GcWaferRobot.xaml" />
        <ResourceDictionary Source="Controls\GcScaraRobot.xaml" />
        <ResourceDictionary Source="Controls\GcClock.xaml" />
        <ResourceDictionary Source="Controls\GcPlatingChamber.xaml" />
    </ResourceDictionary.MergedDictionaries>

</ResourceDictionary>













