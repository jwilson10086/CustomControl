<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:GeneralControl.Controls">

    <!-- Steel 流量计样式（Keyence 风格数显面板）
         结构：钢色面板 → [标题行 FLOW + RUN/AL 灯
                         + 读数行
                         + 量程条 PART_Bar
                         + 辅助行 SP(设定) / AL(报警%)，ShowSetpoint/ShowAlarm 控制显隐] -->
    <Style TargetType="controls:GcFlowMeter">
        <Setter Property="Width" Value="112" />
        <Setter Property="Height" Value="76" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:GcFlowMeter">
                    <Border CornerRadius="10"
                            Background="#14334155"
                            BorderBrush="{DynamicResource GcEdgeHighlightBrush}"
                            BorderThickness="1">
                        <Grid Margin="12,7,12,8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- 标题行 -->
                            <Grid Grid.Row="0">
                                <TextBlock x:Name="PART_TitleText"
                                           Text="FLOW" FontSize="9" FontWeight="SemiBold"
                                           Foreground="#475569" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Ellipse x:Name="PART_AlarmDot"
                                             Width="5" Height="5" Margin="0,0,5,0"
                                             Fill="#33FF8080" Opacity="0.3" />
                                    <Ellipse Width="5" Height="5" Fill="#33FF8080" />
                                    <Ellipse x:Name="PART_RunDot"
                                             Width="6" Height="6" Margin="4,0,0,0"
                                             Fill="#35D07F" Opacity="0.25" />
                                </StackPanel>
                            </Grid>

                            <!-- 读数行 -->
                            <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                                <TextBlock x:Name="PART_ValueText"
                                           FontSize="18" FontWeight="Bold" Foreground="#1F2937"
                                           VerticalAlignment="Bottom"
                                           Text="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, StringFormat={}{0:0.#}}" />
                                <TextBlock x:Name="PART_UnitText"
                                           Margin="2,0,0,1" FontSize="10" Foreground="#475569"
                                           VerticalAlignment="Bottom"
                                           Text="{TemplateBinding Unit}" />
                            </StackPanel>

                            <!-- 量程条 -->
                            <Border Grid.Row="2" Height="4" Margin="0,6,0,0"
                                    CornerRadius="2" Background="#1F334155">
                                <Rectangle x:Name="PART_Bar"
                                           Fill="{DynamicResource GcAccentBrush}"
                                           RadiusX="2" RadiusY="2"
                                           RenderTransformOrigin="0,0.5">
                                    <Rectangle.RenderTransform>
                                        <ScaleTransform ScaleX="0.02" />
                                    </Rectangle.RenderTransform>
                                </Rectangle>
                            </Border>

                            <!-- 辅助行：设定流量 + 报警百分比 -->
                            <Grid Grid.Row="3" Margin="0,3,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="PART_SetpointText" Grid.Column="0" Visibility="Collapsed"
                                           FontSize="7.5" Foreground="#475569" VerticalAlignment="Center">
                                    <Run Text="SP " /><Run x:Name="SetpointRun" Text="{Binding Setpoint, RelativeSource={RelativeSource TemplatedParent}, StringFormat={}{0:0.0}}" />
                                </TextBlock>
                                <TextBlock x:Name="PART_AlarmText" Grid.Column="1" Visibility="Collapsed"
                                           FontSize="7.5" Foreground="#475569" VerticalAlignment="Center">
                                    <Run Text="AL " /><Run x:Name="AlarmRun" Text="{Binding AlarmPercent, RelativeSource={RelativeSource TemplatedParent}, StringFormat={}{0:0}%}" />
                                </TextBlock>
                            </Grid>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- 流动中：RUN 灯呼吸闪烁 -->
                        <Trigger Property="IsFlowing" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="RunDotStoryboard">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="PART_RunDot"
                                                         Storyboard.TargetProperty="Opacity"
                                                         From="1" To="0.25"
                                                         AutoReverse="True"
                                                         Duration="0:0:0.8" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <StopStoryboard BeginStoryboardName="RunDotStoryboard" />
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="ShowSetpoint" Value="True">
                            <Setter TargetName="PART_SetpointText" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="ShowSetpoint" Value="False">
                            <Setter TargetName="PART_SetpointText" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="ShowAlarm" Value="True">
                            <Setter TargetName="PART_AlarmText" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="ShowAlarm" Value="False">
                            <Setter TargetName="PART_AlarmText" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsAlarm" Value="True">
                            <Setter TargetName="PART_AlarmDot" Property="Fill" Value="#FF5555" />
                            <Setter TargetName="PART_AlarmText" Property="Foreground" Value="#FF7A7A" />
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="AlarmStoryboard">
                                    <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                        <DoubleAnimation Storyboard.TargetName="PART_AlarmDot"
                                                         Storyboard.TargetProperty="Opacity"
                                                         From="1" To="0.2" Duration="0:0:0.4" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <StopStoryboard BeginStoryboardName="AlarmStoryboard" />
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
