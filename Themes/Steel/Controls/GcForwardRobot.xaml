<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:GeneralControl.Controls">

    <!-- 晶圆/指示灯显隐用；各主题 Brushes.xaml 中同名转换器在别的字典里，StaticResource 跨不到，固随样式自带一份 -->
    <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />

    <!--
        ================================================================
        外观配色：与演示区第一个机械手（WaferRobot）完全同源。
        渐变与色值逐条取自 Controls\WaferRobot\WaferRobot.xaml 的
        RobotArmGradient / RobotJointGradient / RobotBaseGradient / ToolFill，
        因此三套主题下本控件外观一致（WaferRobot 同样是自带视觉、不吃主题）。
        ================================================================
    -->
    <LinearGradientBrush x:Key="ForwardRobotArmBrush" StartPoint="0,0.5" EndPoint="1,0.5">
        <GradientStop Offset="0" Color="#FFD0D0D0" />
        <GradientStop Offset="0.5" Color="#FFF5F5F5" />
        <GradientStop Offset="1" Color="#FFF6F6F6" />
    </LinearGradientBrush>

    <RadialGradientBrush x:Key="ForwardRobotJointBrush">
        <GradientStop Offset="0" Color="#FFE9EEF2" />
        <GradientStop Offset="0.9" Color="#FFB5C2CB" />
        <GradientStop Offset="1" Color="#FF808080" />
    </RadialGradientBrush>

    <RadialGradientBrush x:Key="ForwardRobotBaseBrush" GradientOrigin="0.5,0.28">
        <GradientStop Offset="0" Color="#FFF0F3F6" />
        <GradientStop Offset="0.6" Color="#FFCBD2D9" />
        <GradientStop Offset="1" Color="#FFA0A0A0" />
    </RadialGradientBrush>

    <LinearGradientBrush x:Key="ForwardRobotToolBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#FFD6D6D6" />
        <GradientStop Offset="1" Color="#FFA8A8A8" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="ForwardRobotWaferBrush" StartPoint="0.2,0" EndPoint="0.8,1">
        <GradientStop Offset="0" Color="#FFF7FAFC" />
        <GradientStop Offset="0.55" Color="#FFE2E9F0" />
        <GradientStop Offset="1" Color="#FFC2CFDB" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="ForwardRobotStrokeBrush" Color="#FF666666" />
    <SolidColorBrush x:Key="ForwardRobotWaferStrokeBrush" Color="#FF8E9AA6" />
    <SolidColorBrush x:Key="ForwardRobotLedBrush" Color="#FF3FBF6F" />

    <!--
        ================================================================
        文件说明：Themes\Steel\Controls\GcForwardRobot.xaml
        前置搬送机械手（Forward Robot）：底座 → X1 主臂 → X2 从臂 → X3 / X4 叉手。
        移植自双层电镀上位机框架的 ccForwardRobot，串联运动链与 18 个预设姿态的
        角度表与原实现一致；外观沿用 WaferRobot 的工业银灰配色。

        【画布】314x214 是 18 个姿态实测并集包络（298x198）外扩 8 留白后
        的尺寸，整机在画布里居中，底座落在中下部，摆臂不会顶出控件框。

        【姿态】Pose 一个属性驱动 VisualStateManager，枚举成员名与 VisualState 名
        一一对应：X1Origin / X1Load1~3 / X1Align1~4 / X1Buffer 与 X2 系列。
        每段臂挂一个 RotateTransform，模板内为每个姿态配 VisualTransition
        （6 秒时长、SpeedRatio=6，约 1 秒走完）与 VisualState（停稳角度）。
        18 个姿态均给出 X1~X4 四段角度，保证任意姿态切换后四叉手一致到位。

        【夹片】X1HasWafer / X2HasWafer 控制两只叉手上的晶圆显隐；
        HasWafer 控制底座料仓指示灯。
        ================================================================
    -->

    <Style TargetType="controls:GcForwardRobot">
        <Setter Property="Width" Value="180" />
        <Setter Property="Height" Value="123" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:GcForwardRobot">
                    <Viewbox Stretch="Uniform"
                             Cursor="Hand"
                             ToolTip="右键浮出控制面板">
                        <Canvas Width="314" Height="214">

                            <!-- 机器人整体平移：并集包络 x[-129.3,168.3] y[-52.5,145.5] 居中后落在画布内 -->
                            <Canvas Canvas.Left="137.5" Canvas.Top="60.5">

                                <!--  底座  -->
                                <Path Fill="{StaticResource ForwardRobotBaseBrush}"
                                      Stroke="{StaticResource ForwardRobotStrokeBrush}"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      StrokeThickness="1">
                                    <Path.Data>
                                        <PathGeometry>
                                            <PathFigure IsClosed="True" StartPoint="0 6">
                                                <LineSegment Point="6 0" />
                                                <LineSegment Point="34 0" />
                                                <LineSegment Point="40 6" />
                                                <LineSegment Point="40 60" />
                                                <LineSegment Point="0 60" />
                                            </PathFigure>
                                        </PathGeometry>
                                    </Path.Data>
                                </Path>
                                <!--  底座顶面分模线  -->
                                <Path Data="M 0,6 L 40,6"
                                      Stroke="{StaticResource ForwardRobotStrokeBrush}"
                                      Opacity="0.45"
                                      StrokeThickness="0.6" />
                                <!--  底座正面铭牌  -->
                                <Rectangle Canvas.Left="8"
                                           Canvas.Top="34"
                                           Width="24"
                                           Height="7"
                                           RadiusX="1.5"
                                           RadiusY="1.5"
                                           Fill="{StaticResource ForwardRobotStrokeBrush}"
                                           Opacity="0.16" />
                                <!--  料仓指示灯  -->
                                <Ellipse x:Name="PART_MagazineDot"
                                         Canvas.Left="30.5"
                                         Canvas.Top="35.5"
                                         Width="6"
                                         Height="6"
                                         Fill="{StaticResource ForwardRobotLedBrush}"
                                         Stroke="#FF2A7A4E"
                                         StrokeThickness="0.6"
                                         Visibility="{Binding HasWafer, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BoolToVisibilityConverter}}" />

                                <!--  ============ X1 主臂（绕底座上端） ============  -->
                                <Canvas x:Name="RobotX1Arm"
                                        Canvas.Left="0"
                                        Canvas.Top="20"
                                        Width="40"
                                        Height="100"
                                        RenderTransformOrigin="0.5,0">
                                    <Canvas.RenderTransform>
                                        <TransformGroup>
                                            <RotateTransform x:Name="RobotX1ArmRotateAct" />
                                        </TransformGroup>
                                    </Canvas.RenderTransform>
                                    <Path Canvas.Left="0"
                                          Canvas.Top="0"
                                          Data="M 5,0 L 5,70 A 15,15 0 0 0 35,70 L 35,0 A 15,15 0 0 0 5,0 Z"
                                          Fill="{StaticResource ForwardRobotArmBrush}"
                                          Stroke="{StaticResource ForwardRobotStrokeBrush}"
                                          StrokeEndLineCap="Round"
                                          StrokeStartLineCap="Round"
                                          StrokeLineJoin="Round"
                                          StrokeThickness="1" />
                                    <!--  肩部关节（盖住臂根圆角）  -->
                                    <Ellipse Canvas.Left="12"
                                             Canvas.Top="-8"
                                             Width="16"
                                             Height="16"
                                             Fill="{StaticResource ForwardRobotJointBrush}"
                                             Stroke="{StaticResource ForwardRobotStrokeBrush}"
                                             StrokeThickness="1" />
                                    <Ellipse Canvas.Left="12"
                                             Canvas.Top="62"
                                             Width="16"
                                             Height="16"
                                             Fill="{StaticResource ForwardRobotJointBrush}"
                                             Stroke="{StaticResource ForwardRobotStrokeBrush}"
                                             StrokeThickness="1" />

                                    <!--  ============ X2 从臂（绕肘部） ============  -->
                                    <Canvas x:Name="RobotX2Arm"
                                            Canvas.Left="0"
                                            Canvas.Top="0"
                                            Width="40"
                                            Height="70"
                                            RenderTransformOrigin="0.5,1">
                                        <Canvas.RenderTransform>
                                            <TransformGroup>
                                                <RotateTransform x:Name="RobotX2ArmRotateAct" />
                                            </TransformGroup>
                                        </Canvas.RenderTransform>
                                        <Path Canvas.Left="0"
                                              Canvas.Top="0"
                                              Data="M 12,0 L 9,30 9,70  A 11,11 0 0 0 31,70 L 31,30 28,0 A 8,8 0 0 0 12,0 Z"
                                              Fill="{StaticResource ForwardRobotArmBrush}"
                                              RenderTransformOrigin="0.5,1"
                                              Stroke="{StaticResource ForwardRobotStrokeBrush}"
                                              StrokeEndLineCap="Round"
                                              StrokeStartLineCap="Round"
                                              StrokeLineJoin="Round"
                                              StrokeThickness="1" />
                                        <!--  腕部关节  -->
                                        <Ellipse Canvas.Left="13"
                                                 Canvas.Top="63"
                                                 Width="14"
                                                 Height="14"
                                                 Fill="{StaticResource ForwardRobotJointBrush}"
                                                 Stroke="{StaticResource ForwardRobotStrokeBrush}"
                                                 StrokeThickness="1" />

                                        <!--  ============ X3 叉手（X1 工位） ============  -->
                                        <Canvas x:Name="RobotX3Arm"
                                                Canvas.Left="0"
                                                Canvas.Top="0"
                                                Width="40"
                                                Height="110"
                                                RenderTransformOrigin="0.5,0">
                                            <Canvas.RenderTransform>
                                                <TransformGroup>
                                                    <RotateTransform x:Name="RobotX3ArmRotateAct" />
                                                </TransformGroup>
                                            </Canvas.RenderTransform>
                                            <Path Canvas.Left="0"
                                                  Canvas.Top="-5"
                                                  Data="M 9,30 L 9,70 13,70 13,62 A 7,7 0 0 1 27,62 L 27,70 31,70 31,30"
                                                  Fill="{StaticResource ForwardRobotToolBrush}"
                                                  Stroke="{StaticResource ForwardRobotStrokeBrush}"
                                                  StrokeEndLineCap="Round"
                                                  StrokeStartLineCap="Round"
                                                  StrokeThickness="0.8" />
                                            <Path Canvas.Left="0"
                                                  Canvas.Top="0"
                                                  Data="M 10,0 L 10,15 7,35 7,40 33,40 33,35 30,15 30,0  A 10,10 0 0 0 10,0 Z"
                                                  Fill="{StaticResource ForwardRobotToolBrush}"
                                                  RenderTransformOrigin="0.5,0.5"
                                                  Stroke="{StaticResource ForwardRobotStrokeBrush}"
                                                  StrokeEndLineCap="Round"
                                                  StrokeStartLineCap="Round"
                                                  StrokeLineJoin="Round"
                                                  StrokeThickness="1" />
                                            <Ellipse Canvas.Left="13"
                                                     Canvas.Top="-7"
                                                     Width="14"
                                                     Height="14"
                                                     Fill="{StaticResource ForwardRobotJointBrush}"
                                                     Stroke="{StaticResource ForwardRobotStrokeBrush}"
                                                     StrokeThickness="1" />
                                            <Ellipse Canvas.Left="10"
                                                     Canvas.Top="59"
                                                     Width="2"
                                                     Height="2"
                                                     Fill="{StaticResource ForwardRobotStrokeBrush}"
                                                     Opacity="0.5" />
                                            <Ellipse Canvas.Left="28"
                                                     Canvas.Top="59"
                                                     Width="2"
                                                     Height="2"
                                                     Fill="{StaticResource ForwardRobotStrokeBrush}"
                                                     Opacity="0.5" />
                                            <Ellipse Canvas.Left="19"
                                                     Canvas.Top="46"
                                                     Width="2"
                                                     Height="2"
                                                     Fill="{StaticResource ForwardRobotStrokeBrush}"
                                                     Opacity="0.5" />
                                            <!--  晶圆：平边 + 高光  -->
                                            <Canvas x:Name="PART_X1Wafer"
                                                    Canvas.Left="0"
                                                    Canvas.Top="0"
                                                    Width="40"
                                                    Height="110"
                                                    Visibility="{Binding X1HasWafer, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <Ellipse Canvas.Left="0.5"
                                                         Canvas.Top="37"
                                                         Width="40"
                                                         Height="40"
                                                         Fill="{StaticResource ForwardRobotWaferBrush}"
                                                         Stroke="{StaticResource ForwardRobotWaferStrokeBrush}"
                                                         StrokeThickness="0.6" />
                                                <Path Data="M 9,73 L 32,73"
                                                      Stroke="{StaticResource ForwardRobotWaferStrokeBrush}"
                                                      StrokeThickness="0.8" />
                                                <Ellipse Canvas.Left="7"
                                                         Canvas.Top="42"
                                                         Width="13"
                                                         Height="8"
                                                         Fill="White"
                                                         Opacity="0.45" />
                                            </Canvas>
                                        </Canvas>

                                        <!--  ============ X4 叉手（X2 工位） ============  -->
                                        <Canvas x:Name="RobotX4Arm"
                                                Canvas.Left="0"
                                                Canvas.Top="0"
                                                Width="40"
                                                Height="110"
                                                RenderTransformOrigin="0.5,0">
                                            <Canvas.RenderTransform>
                                                <TransformGroup>
                                                    <RotateTransform x:Name="RobotX4ArmRotateAct" />
                                                </TransformGroup>
                                            </Canvas.RenderTransform>
                                            <Path Canvas.Left="0"
                                                  Canvas.Top="-5"
                                                  Data="M 9,30 L 9,70 13,70 13,62 A 7,7 0 0 1 27,62 L 27,70 31,70 31,30"
                                                  Fill="{StaticResource ForwardRobotToolBrush}"
                                                  Stroke="{StaticResource ForwardRobotStrokeBrush}"
                                                  StrokeEndLineCap="Round"
                                                  StrokeStartLineCap="Round"
                                                  StrokeThickness="0.8" />
                                            <Path Canvas.Left="0"
                                                  Canvas.Top="0"
                                                  Data="M 10,0 L 10,15 7,35 7,40 33,40 33,35 30,15 30,0  A 10,10 0 0 0 10,0 Z"
                                                  Fill="{StaticResource ForwardRobotToolBrush}"
                                                  RenderTransformOrigin="0.5,0.5"
                                                  Stroke="{StaticResource ForwardRobotStrokeBrush}"
                                                  StrokeEndLineCap="Round"
                                                  StrokeStartLineCap="Round"
                                                  StrokeLineJoin="Round"
                                                  StrokeThickness="1" />
                                            <Ellipse Canvas.Left="13"
                                                     Canvas.Top="-7"
                                                     Width="14"
                                                     Height="14"
                                                     Fill="{StaticResource ForwardRobotJointBrush}"
                                                     Stroke="{StaticResource ForwardRobotStrokeBrush}"
                                                     StrokeThickness="1" />
                                            <Ellipse Canvas.Left="10"
                                                     Canvas.Top="59"
                                                     Width="2"
                                                     Height="2"
                                                     Fill="{StaticResource ForwardRobotStrokeBrush}"
                                                     Opacity="0.5" />
                                            <Ellipse Canvas.Left="28"
                                                     Canvas.Top="59"
                                                     Width="2"
                                                     Height="2"
                                                     Fill="{StaticResource ForwardRobotStrokeBrush}"
                                                     Opacity="0.5" />
                                            <Ellipse Canvas.Left="19"
                                                     Canvas.Top="46"
                                                     Width="2"
                                                     Height="2"
                                                     Fill="{StaticResource ForwardRobotStrokeBrush}"
                                                     Opacity="0.5" />
                                            <!--  晶圆：平边 + 高光  -->
                                            <Canvas x:Name="PART_X2Wafer"
                                                    Canvas.Left="0"
                                                    Canvas.Top="0"
                                                    Width="40"
                                                    Height="110"
                                                    Visibility="{Binding X2HasWafer, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <Ellipse Canvas.Left="0.5"
                                                         Canvas.Top="37"
                                                         Width="40"
                                                         Height="40"
                                                         Fill="{StaticResource ForwardRobotWaferBrush}"
                                                         Stroke="{StaticResource ForwardRobotWaferStrokeBrush}"
                                                         StrokeThickness="0.6" />
                                                <Path Data="M 9,73 L 32,73"
                                                      Stroke="{StaticResource ForwardRobotWaferStrokeBrush}"
                                                      StrokeThickness="0.8" />
                                                <Ellipse Canvas.Left="7"
                                                         Canvas.Top="42"
                                                         Width="13"
                                                         Height="8"
                                                         Fill="White"
                                                         Opacity="0.45" />
                                            </Canvas>
                                        </Canvas>
                                    </Canvas>
                                </Canvas>
                            </Canvas>
                        </Canvas>

                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup Name="ForwardRobotPoses">
                                <VisualStateGroup.Transitions>
                                    <VisualTransition To="X1Origin">
                                        <Storyboard FillBehavior="HoldEnd" SpeedRatio="6">
                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RobotX1ArmRotateAct" Storyboard.TargetProperty="Angle">
                                                <LinearDoubleKeyFrame KeyTime="0:0:6" Value="0" />
                                            </DoubleAnimationUsingKeyFrames>
                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RobotX2ArmRotateAct" Storyboard.TargetProperty="Angle">
                                                <LinearDoubleKeyFrame KeyTime="0:0:6" Value="0" />
                                            </DoubleAnimationUsingKeyFrames>
                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RobotX3ArmRotateAct" Storyboard.TargetProperty="Angle">
                                                <LinearDoubleKeyFrame KeyTime="0:0:6" Value="0" />
                                            </DoubleAnimationUsingKeyFrames>
                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RobotX4ArmRotateAct" Storyboard.TargetProperty="Angle">
                                                <LinearDoubleKeyFrame KeyTime="0:0:6" Value="0" />
                                            </DoubleAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualTransition>
                                    <VisualTransition To="X1Load1">
                                        <Storyboard FillBehavior="HoldEnd" SpeedRatio="6">
                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RobotX1ArmRotateAct" Storyboard.TargetProperty="Angle">
                                                <LinearDoubleKeyFrame KeyTime="0:0:6" Value="30" />
                                            </DoubleAnimationUsingKeyFrames>
                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RobotX2ArmRotateAct" Storyboard.TargetProperty="Angle">
                                                <LinearDoubleKeyFrame KeyTime="0:0:6" Value="-110" />
                                            </DoubleAnimationUsingKeyFrames>
                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RobotX3ArmRotateAct" Storyboard.TargetProperty="Angle">
                                                <LinearDoubleKeyFrame KeyTime="0:0:6" Value="80" />
                                            </DoubleAnimationUsingKeyFrames>
                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RobotX4ArmRotateAct" Storyboard.TargetProperty="Angle">
                                                <LinearDoubleKeyFrame KeyTime="0:0:6" Value="-30" />
                                            </DoubleAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualTransition>
                                    <VisualTransition To="X1Load2">
                                        <Storyboard FillBehavior="HoldEnd" SpeedRatio="6">
                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RobotX1ArmRotateAct" Storyboard.TargetProperty="Angle">
                                                <LinearDoubleKeyFrame KeyTime="0:0:6" Value="70" />
                                            </DoubleAnimationUsingKeyFrames>
                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RobotX2ArmRotateAct" Storyboard.TargetProperty="Angle">
                                                <LinearDoubleKeyFrame KeyTime="0:0:6" Value="40" />
                                            </DoubleAnimationUsingKeyFrames>
                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RobotX3ArmRotateAct" Storyboard.TargetProperty="Angle">
                                                <LinearDoubleKeyFrame KeyTime="0:0:6" Value="-110" />
                                            </DoubleAnimationUsingKeyFrames>
                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RobotX4ArmRotateAct" Storyboard.TargetProperty="Angle">
                                                <LinearDoubleKeyFrame KeyTime="0:0:6" Value="0" />
                                            </DoubleAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualTransition>
                                    <VisualTransition To="X1Load3">
                                        <Storyboard FillBehavior="HoldEnd" SpeedRatio="6">
                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RobotX1ArmRotateAct" Storyboard.TargetProperty="Angle">
                                                <LinearDoubleKeyFrame KeyTime="0:0:6" Value="-30" />
                                            </DoubleAnimationUsingKeyFrames>
                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RobotX2ArmRotateAct" Storyboard.TargetProperty="Angle">
                                                <LinearDoubleKeyFrame KeyTime="0:0:6" Value="110" />
                                            </DoubleAnimationUsingKeyFrames>
                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RobotX3ArmRotateAct" Storyboard.TargetProperty="Angle">
                                                <LinearDoubleKeyFrame KeyTime="0:0:6" Value="-80" />
                                            </DoubleAnimationUsingKeyFrames>
                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RobotX4ArmRotateAct" Storyboard.TargetProperty="Angle">
                                                <LinearDoubleKeyFrame KeyTime="0:0:6" Value="30" />
                                            </DoubleAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualTransition>
                                    <VisualTransition To="X1Align1">
                                        <Storyboard FillBehavior="HoldEnd" SpeedRatio="6">
                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RobotX1ArmRotateAct" Storyboard.TargetProperty="Angle">
                                                <LinearDoubleKeyFrame KeyTime="0:0:6" Value="65" />
                                            </DoubleAnimationUsingKeyFrames>
                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RobotX2ArmRotateAct" Storyboard.TargetProperty="Angle">
                                                <LinearDoubleKeyFrame KeyTime="0:0:6" Value="-134" />
                                            </DoubleAnimationUsingKeyFrames>
                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RobotX3ArmRotateAct" Storyboard.TargetProperty="Angle">
                                                <LinearDoubleKeyFrame KeyTime="0:0:6" Value="-111" />
                                            </DoubleAnimationUsingKeyFrames>
                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RobotX4ArmRotateAct" Storyboard.TargetProperty="Angle">
                                                <LinearDoubleKeyFrame KeyTime="0:0:6" Value="-10" />
                                            </DoubleAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualTransition>
                                    <VisualTransition To="X1Align2">
                                        <Storyboard FillBehavior="HoldEnd" SpeedRatio="6">
                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RobotX1ArmRotateAct" Storyboard.TargetProperty="Angle">
                                                <LinearDoubleKeyFrame KeyTime="0:0:6" Value="26" />
                                            </DoubleAnimationUsingKeyFrames>
                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RobotX2ArmRotateAct" Storyboard.TargetProperty="Angle">
                                                <LinearDoubleKeyFrame KeyTime="0:0:6" Value="-73" />
                                            </DoubleAnimationUsingKeyFrames>
                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RobotX3ArmRotateAct" Storyboard.TargetProperty="Angle">
                                                <LinearDoubleKeyFrame KeyTime="0:0:6" Value="-133" />
                                            </DoubleAnimationUsingKeyFrames>
                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RobotX4ArmRotateAct" Storyboard.TargetProperty="Angle">
                                                <LinearDoubleKeyFrame KeyTime="0:0:6" Value="-30" />
                                            </DoubleAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualTransition>
                                    <VisualTransition To="X1Align3">
                                        <Storyboard FillBehavior="HoldEnd" SpeedRatio="6">
                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RobotX1ArmRotateAct" Storyboard.TargetProperty="Angle">
                                                <LinearDoubleKeyFrame KeyTime="0:0:6" Value="-26" />
                                            </DoubleAnimationUsingKeyFrames>
                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RobotX2ArmRotateAct" Storyboard.TargetProperty="Angle">
                                                <LinearDoubleKeyFrame KeyTime="0:0:6" Value="73" />
                                            </DoubleAnimationUsingKeyFrames>
                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RobotX3ArmRotateAct" Storyboard.TargetProperty="Angle">
                                                <LinearDoubleKeyFrame KeyTime="0:0:6" Value="133" />
                                            </DoubleAnimationUsingKeyFrames>
                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RobotX4ArmRotateAct" Storyboard.TargetProperty="Angle">
                                                <LinearDoubleKeyFrame KeyTime="0:0:6" Value="30" />
                                            </DoubleAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualTransition>
                                    <VisualTransition To="X1Align4">
                                        <Storyboard FillBehavior="HoldEnd" SpeedRatio="6">
                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RobotX1ArmRotateAct" Storyboard.TargetProperty="Angle">
                                                <LinearDoubleKeyFrame KeyTime="0:0:6" Value="-65" />
                                            </DoubleAnimationUsingKeyFrames>
                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RobotX2ArmRotateAct" Storyboard.TargetProperty="Angle">
                                                <LinearDoubleKeyFrame KeyTime="0:0:6" Value="134" />
                                            </DoubleAnimationUsingKeyFrames>
                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RobotX3ArmRotateAct" Storyboard.TargetProperty="Angle">
                                                <LinearDoubleKeyFrame KeyTime="0:0:6" Value="111" />
                                            </DoubleAnimationUsingKeyFrames>
                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RobotX4ArmRotateAct" Storyboard.TargetProperty="Angle">
                                                <LinearDoubleKeyFrame KeyTime="0:0:6" Value="10" />
                                            </DoubleAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualTransition>
                                    <VisualTransition To="X1Buffer">
                                        <Storyboard FillBehavior="HoldEnd" SpeedRatio="6">
                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RobotX1ArmRotateAct" Storyboard.TargetProperty="Angle">
                                                <LinearDoubleKeyFrame KeyTime="0:0:6" Value="90" />
                                            </DoubleAnimationUsingKeyFrames>
                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RobotX2ArmRotateAct" Storyboard.TargetProperty="Angle">
                                                <LinearDoubleKeyFrame KeyTime="0:0:3" Value="50" />
                                                <LinearDoubleKeyFrame KeyTime="0:0:6" Value="5" />
                                            </DoubleAnimationUsingKeyFrames>
                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="RobotX3ArmRotateAct" Storyboard.TargetProperty="Angle">
                                                <LinearDoubleKeyFrame KeyTime="0:0:6" Value="85" />
