<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:GeneralControl.Controls">

    <!--
        ================================================================
        文件说明：Themes\Steel\Controls\Motor.xaml
        Motor 工业电机样式（P&ID 电机符号）。

        依赖：Brushes.xaml（画刷资源）。
        结构：Viewbox(等比缩放) → 48x48 画布
              → [底脚 + 轴伸 + 机壳(散热鳍) + PART_Rotor 转子虚线环 + M 标识]

        【PART_Rotor】RenderTransform 必须是 RotateTransform（圆心 24,26），
        IsRunning 时 0→360 循环；ExitActions 停止故事板。
        【状态】IsFault=true：机壳红色警示（Trigger 排最后）。
        ================================================================
    -->

    <Style TargetType="controls:GcMotor">
        <Setter Property="Width" Value="48" />
        <Setter Property="Height" Value="48" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:GcMotor">
                    <Viewbox Stretch="Uniform"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center">
                        <Canvas Width="48" Height="48">
                            <!-- 底脚 ×2 -->
                            <Rectangle Canvas.Left="10" Canvas.Top="41"
                                       Width="7" Height="3.5"
                                       RadiusX="1" RadiusY="1"
                                       Fill="#47334155" />
                            <Rectangle Canvas.Left="31" Canvas.Top="41"
                                       Width="7" Height="3.5"
                                       RadiusX="1" RadiusY="1"
                                       Fill="#47334155" />

                            <!-- 轴伸（右侧输出轴） -->
                            <Rectangle Canvas.Left="39" Canvas.Top="23.5"
                                       Width="6" Height="5"
                                       RadiusX="1" RadiusY="1"
                                       Fill="#475569" />

                            <!-- 机壳：玻璃圆 + 散热鳍 -->
                            <Ellipse x:Name="PART_Body"
                                     Canvas.Left="8" Canvas.Top="10"
                                     Width="32" Height="32"
                                     Fill="#1F334155"
                                     Stroke="{DynamicResource GcEdgeHighlightBrush}"
                                     StrokeThickness="1.6" />
                            <!-- 散热鳍 ×4（上下对称短弧块，简化为圆角短条） -->
                            <Rectangle Canvas.Left="12" Canvas.Top="7.2"
                                       Width="4.5" Height="3.2"
                                       RadiusX="1.4" RadiusY="1.4"
                                       Fill="#59334155" />
                            <Rectangle Canvas.Left="21.75" Canvas.Top="6.4"
                                       Width="4.5" Height="3.2"
                                       RadiusX="1.4" RadiusY="1.4"
                                       Fill="#59334155" />
                            <Rectangle Canvas.Left="31.5" Canvas.Top="7.2"
                                       Width="4.5" Height="3.2"
                                       RadiusX="1.4" RadiusY="1.4"
                                       Fill="#59334155" />
                            <Rectangle Canvas.Left="12" Canvas.Top="41.6"
                                       Width="4.5" Height="3.2"
                                       RadiusX="1.4" RadiusY="1.4"
                                       Fill="#59334155" />
                            <Rectangle Canvas.Left="21.75" Canvas.Top="42.4"
                                       Width="4.5" Height="3.2"
                                       RadiusX="1.4" RadiusY="1.4"
                                       Fill="#59334155" />
                            <Rectangle Canvas.Left="31.5" Canvas.Top="41.6"
                                       Width="4.5" Height="3.2"
                                       RadiusX="1.4" RadiusY="1.4"
                                       Fill="#59334155" />

                            <!-- 转子磁场环：虚线圆环，运行时旋转 -->
                            <Ellipse x:Name="PART_Rotor"
                                     Canvas.Left="12.5" Canvas.Top="14.5"
                                     Width="23" Height="23"
                                     Fill="#0F334155"
                                     Stroke="#475569"
                                     StrokeThickness="2.2"
                                     StrokeDashArray="3.2 2.2"
                                     RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform>
                                    <RotateTransform Angle="0" />
                                </Ellipse.RenderTransform>
                            </Ellipse>

                            <!-- M 标识 -->
                            <TextBlock x:Name="PART_MLabel"
                                       Canvas.Left="18.6" Canvas.Top="19.6"
                                       FontSize="13" FontWeight="Bold"
                                       Foreground="#1F2937"
                                       Text="M" />
                        </Canvas>
                    </Viewbox>
                    <ControlTemplate.Triggers>
                        <!-- 运行：转子环旋转 -->
                        <Trigger Property="IsRunning" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="SpinStoryboard">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="PART_Rotor"
                                                         Storyboard.TargetProperty="RenderTransform.Angle"
                                                         From="0" To="360"
                                                         Duration="0:0:1.4" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <StopStoryboard BeginStoryboardName="SpinStoryboard" />
                            </Trigger.ExitActions>
                        </Trigger>
                        <!-- 故障：红色警示（排最后） -->
                        <Trigger Property="IsFault" Value="True">
                            <Setter TargetName="PART_Body" Property="Fill" Value="#33E85555" />
                            <Setter TargetName="PART_Body" Property="Stroke" Value="#FF8080" />
                            <Setter TargetName="PART_MLabel" Property="Foreground" Value="#FFB3B3" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>











