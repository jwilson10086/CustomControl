<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:GeneralControl.Controls">

    <!--
        ================================================================
        文件说明：Themes\Steel\Controls\PasswordBox.xaml
        PasswordBoxStyle 密码框样式（Key 样式，供显式引用）。

        依赖：Brushes.xaml（画刷资源）。
        注意：本文件内本地定义了一份 BoolToVisibilityConverter，
        因为 Binding.Converter 只能接受 StaticResource 引用
        （不能使用 DynamicResource），无法跨文件依赖合并顺序。
        ================================================================
    -->

    <!-- 本地转换器：仅供本文件模板内的绑定使用 -->
    <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />

    <!--
        ===================== 密码框样式 =====================
        PasswordBoxStyle：毛玻璃主题的密码输入框。
        与 TextBox 的区别：
        - PasswordBox 是 WPF 原生控件（非自定义控件），所以用 Key 样式而非隐式样式
        - 没有 PART_ContentHost（PasswordBox 内部处理密码显示）
        - 占位符通过 Password.Length 判断是否显示
        - CaretBrush 直接设置为白色半透明
        - 选中效果使用 SelectionBrush

        安全性说明：
        PasswordBox 不支持 TemplateBinding Password 属性（出于安全考虑），
        占位符使用单独的 Placeholder 附加属性绑定。
    -->
    <Style x:Key="PasswordBoxStyle" TargetType="PasswordBox">
        <Setter Property="Background" Value="{DynamicResource GcControlBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource GcBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource GcTextBrush}" />
        <Setter Property="CaretBrush" Value="#475569" />
        <Setter Property="SelectionBrush" Value="#5E2FBF63" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="9">
                        <Grid>
                            <!--
                                PART_ContentHost：PasswordBox 的约定部件
                                用于显示密码掩码字符（如 ●●●●●●）
                            -->
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Focusable="False" />
                            <!--
                                PART_PlainTextBox：明文显示文本框
                                当用户点击眼睛图标时，密码框切换为明文显示。
                                初始隐藏，通过代码控制可见性。
                                注意：不设置任何背景/边框属性，完全依赖外层 Root Border 的视觉。
                            -->
                            <TextBox x:Name="PART_PlainTextBox"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Foreground="#1F2937"
                                     CaretBrush="#475569"
                                     FontSize="13"
                                     Padding="0"
                                     SnapsToDevicePixels="True"
                                     SelectionBrush="#5E2FBF63"
                                     Visibility="Collapsed"
                                     IsHitTestVisible="False"
                                     Focusable="False" />
                            <!--
                                PART_Watermark：密码框占位符
                                使用附加属性语法 (controls:GcPasswordBox.Placeholder) 绑定，
                                因为 PasswordBox 没有原生的 Placeholder 属性，
                                所以通过附加属性扩展功能。
                            -->
                            <TextBlock x:Name="PART_Watermark"
                                       Margin="{TemplateBinding Padding}"
                                       Text="{Binding (controls:GcPasswordBox.Placeholder), RelativeSource={RelativeSource TemplatedParent}}"
                                       Foreground="{Binding (controls:GcPasswordBox.PlaceholderBrush), RelativeSource={RelativeSource TemplatedParent}}"
                                       FontSize="{TemplateBinding FontSize}"
                                       VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                       IsHitTestVisible="False"
                                       TextTrimming="CharacterEllipsis" />
                            <!--
                                密码可见性切换按钮（小眼睛）：
                                当 IsPasswordVisible=True 时显示在密码框右侧。
                                点击后切换密码明文/密文显示。
                                使用附加属性 IsPasswordVisible 控制可见性。
                            -->
                            <Button x:Name="PART_TogglePasswordButton"
                                    Width="28" Height="28"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Margin="0,0,8,0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    Focusable="False"
                                    Visibility="{Binding (controls:GcPasswordBox.IsPasswordVisible),
                                        RelativeSource={RelativeSource TemplatedParent},
                Converter={StaticResource BoolToVisibilityConverter}}"
                                    ToolTip="显示/隐藏密码">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="EyeBorder"
                                                Background="Transparent"
                                                CornerRadius="6"
                                                Padding="4">
                                            <Grid>
                                                <!-- 眼睛图标（两个嵌套椭圆 + 中心瞳孔） -->
                                                <Canvas Width="18" Height="12" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <!-- 外眼眶 -->
                                                    <Ellipse Canvas.Left="0" Canvas.Top="0"
                                                             Width="18" Height="11"
                                                             Stroke="#475569" StrokeThickness="1.2" />
                                                    <!-- 内部渐变填充 -->
                                                    <Ellipse Canvas.Left="0" Canvas.Top="0"
                                                             Width="18" Height="11">
                                                        <Ellipse.Fill>
                                                            <RadialGradientBrush>
                                                                <GradientStop Color="#33334155" Offset="0" />
                                                                <GradientStop Color="#0A334155" Offset="1" />
                                                            </RadialGradientBrush>
                                                        </Ellipse.Fill>
                                                    </Ellipse>
                                                    <!-- 瞳孔 -->
                                                    <Ellipse Canvas.Left="6" Canvas.Top="2.5"
                                                             Width="6" Height="6"
                                                             Fill="#475569" />
                                                    <!-- 瞳孔高光 -->
                                                    <Ellipse Canvas.Left="7.8" Canvas.Top="4"
                                                             Width="2" Height="2"
                                                             Fill="#FFFFFF" Opacity="0.9" />
                                                </Canvas>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="EyeBorder" Property="Background" Value="#18334155" />
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="EyeBorder" Property="Background" Value="#25334155" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- 悬停：边框变亮 -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource GcBorderHoverBrush}" />
                        </Trigger>
                        <!-- 获得焦点：边框变蓝色 + 背景微调 -->
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource GcAccentBrush}" />
                            <Setter TargetName="Root" Property="Background" Value="#12000000" />
                        </Trigger>
                        <!--
                            占位符显示逻辑（两个 DataTrigger 配合）：
                            - Password.Length == 0 时显示占位符
                            - Password.Length == 1 时隐藏占位符
                            用 Length==1 而非 Length>0 是为了只触发一次隐藏，
                            避免每次输入字符都触发不必要的属性变更。
                        -->
                        <DataTrigger Binding="{Binding Password.Length, RelativeSource={RelativeSource TemplatedParent}}" Value="0">
                            <Setter TargetName="PART_Watermark" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Password.Length, RelativeSource={RelativeSource TemplatedParent}}" Value="1">
                            <Setter TargetName="PART_Watermark" Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <!-- 获得焦点时也隐藏占位符（即使密码为空） -->
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="PART_Watermark" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <!-- 禁用：降低透明度 -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>











