<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:GeneralControl.Controls">

    <!--
        ================================================================
        文件说明：Themes\Glass\Controls\GcClock.xaml
        实时时钟控件：时钟图标 + 时间大字 + 日期行。
        Format 控制时间格式，ShowDate 控制日期行显隐。
        ================================================================
    -->

    <Style TargetType="controls:GcClock">
        <Setter Property="Width" Value="190" />
        <Setter Property="Height" Value="56" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:GcClock">
                    <Border CornerRadius="10"
                            Background="{DynamicResource GlassBackdropBrush}"
                            BorderBrush="{DynamicResource GcEdgeHighlightBrush}"
                            BorderThickness="1">
                        <Grid Margin="14,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- 时钟图标 -->
                            <Canvas Grid.Column="0" Width="26" Height="26" VerticalAlignment="Center" Opacity="0.85">
                                <Ellipse Canvas.Left="1" Canvas.Top="1" Width="24" Height="24"
                                         Stroke="{DynamicResource GlassTextSecondaryBrush}" StrokeThickness="1.6" />
                                <Line X1="13" Y1="13" X2="13" Y2="5.5"
                                      Stroke="{DynamicResource GlassTextSecondaryBrush}"
                                      StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                <Line X1="13" Y1="13" X2="19" Y2="16.5"
                                      Stroke="{DynamicResource GcAccentBrush}"
                                      StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            </Canvas>

                            <!-- 时间 + 日期 -->
                            <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="PART_TimeText"
                                           Text="00:00:00"
                                           FontSize="18" FontWeight="SemiBold"
                                           Foreground="{DynamicResource GlassTextBrush}" />
                                <TextBlock x:Name="PART_DateText"
                                           Text=""
                                           FontSize="10.5"
                                           Foreground="{DynamicResource GlassTextSecondaryBrush}"
                                           Margin="1,1,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>

