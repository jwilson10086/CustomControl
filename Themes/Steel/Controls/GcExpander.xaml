<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:GeneralControl.Controls">

    <!--
        ================================================================
        文件说明：Themes\Glass\Controls\Expander.xaml
        Expander 折叠面板样式（标题栏 + 可展开内容区）。

        依赖：Brushes.xaml（画刷资源）。
        ================================================================
    -->

    <Style TargetType="controls:GcExpander">
        <Setter Property="Foreground" Value="{DynamicResource GcTextBrush}" />
        <Setter Property="Background" Value="{DynamicResource GcBackdropBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource GcEdgeHighlightBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:GcExpander">
                    <Border Background="Transparent"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="12">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <!--
                                标题栏：三层叠放
                                - ToggleButton(HeaderSite)：铺满整行的透明命中区，
                                  IsChecked 双向绑定控件 IsExpanded，点击即展开/折叠；
                                - ContentPresenter：直接 TemplateBinding 控件自身的
                                  Header（与开关解耦，避免依赖开关的 Header 属性）；
                                - 箭头：随 IsExpanded 翻转（触发器见模板尾部）。
                            -->
                            <Grid Grid.Row="0" Background="Transparent">
                                <ToggleButton x:Name="HeaderSite"
                                              Focusable="False"
                                              IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                              Opacity="0"
                                              Cursor="Hand" />
                                <ContentPresenter Content="{TemplateBinding Header}"
                                                  Margin="14,11"
                                                  HorizontalAlignment="Left"
                                                  VerticalAlignment="Center"
                                                  RecognizesAccessKey="True"
                                                  TextElement.FontWeight="SemiBold"
                                                  TextElement.FontSize="13" />
                                <Path x:Name="ChevronDown"
                                      Data="M 1 1 L 5 5 L 9 1"
                                      Stroke="{DynamicResource GcTextSecondaryBrush}"
                                      StrokeThickness="1.8"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      HorizontalAlignment="Right"
                                      VerticalAlignment="Center"
                                      Margin="0,0,14,0" />
                                <Path x:Name="ChevronUp"
                                      Data="M 1 5 L 5 1 L 9 5"
                                      Stroke="{DynamicResource GcTextSecondaryBrush}"
                                      StrokeThickness="1.8"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      HorizontalAlignment="Right"
                                      VerticalAlignment="Center"
                                      Margin="0,0,14,0"
                                      Visibility="Collapsed" />
                            </Grid>
                            <ContentPresenter x:Name="ExpandSite"
                                              Grid.Row="1"
                                              Margin="14,0,14,14"
                                              Visibility="Collapsed"
                                              Focusable="False" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="True">
                            <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible" />
                            <Setter TargetName="ChevronDown" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="ChevronUp" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="HeaderSite" Property="Cursor" Value="Hand" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>








