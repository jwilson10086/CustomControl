<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:GeneralControl.Controls">

    <!-- Steel 冰水机面板样式
         结构：机柜 + 双散热风扇 + 温度面板（设置温度/实际温度）+
              电源开关 -->
    <Style TargetType="controls:GcChiller">
        <Setter Property="Width" Value="250" />
        <Setter Property="Height" Value="208" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:GcChiller">
                    <Border CornerRadius="12"
                            Background="#1F1F2937"
                            BorderBrush="{DynamicResource GcEdgeHighlightBrush}"
                            BorderThickness="1.4"
                            Padding="12,10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- 标题行 -->
                            <Grid Grid.Row="0" Margin="2,0,2,6">
                                <TextBlock Text="冰水机 CHILLER" FontSize="12" FontWeight="Bold"
                                           Foreground="{DynamicResource GcTextBrush}"
                                           VerticalAlignment="Center" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Ellipse x:Name="PART_AlarmDot" Width="9" Height="9"
                                             Fill="#3F334155" Margin="0,0,5,0" />
                                    <TextBlock Text="报警" FontSize="8.5" Foreground="{DynamicResource GcTextSecondaryBrush}"
                                               Margin="0,0,10,0" />
                                    <Ellipse x:Name="PART_PowerDot" Width="9" Height="9" Fill="#3F334155" />
                                    <TextBlock Text="电源" FontSize="8.5" Foreground="{DynamicResource GcTextSecondaryBrush}"
                                               Margin="2,0,0,0" />
                                </StackPanel>
                            </Grid>

                            <!-- 双散热风扇 -->
                            <Canvas Grid.Row="1" Width="226" Height="52" HorizontalAlignment="Center">
                                <Ellipse Canvas.Left="18" Canvas.Top="8" Width="36" Height="36"
                                         Fill="#0F334155" Stroke="#59334155" StrokeThickness="1.2" />
                                <Canvas x:Name="PART_FanA" Canvas.Left="36" Canvas.Top="26" Opacity="0.75">
                                    <Canvas.RenderTransform><RotateTransform Angle="0" /></Canvas.RenderTransform>
                                    <Path Data="M0,-14 C5,-8 5,-3 0,0 C-5,-3 -5,-8 0,-14 Z" Fill="#5B6B7E" />
                                    <Path Data="M0,-14 C5,-8 5,-3 0,0 C-5,-3 -5,-8 0,-14 Z" Fill="#5B6B7E">
                                        <Path.RenderTransform><RotateTransform Angle="120" /></Path.RenderTransform>
                                    </Path>
                                    <Path Data="M0,-14 C5,-8 5,-3 0,0 C-5,-3 -5,-8 0,-14 Z" Fill="#5B6B7E">
                                        <Path.RenderTransform><RotateTransform Angle="240" /></Path.RenderTransform>
                                    </Path>
                                    <Ellipse Width="5" Height="5" Canvas.Left="-2.5" Canvas.Top="-2.5" Fill="#475569" />
                                </Canvas>
                                <Ellipse Canvas.Left="124" Canvas.Top="8" Width="36" Height="36"
                                         Fill="#0F334155" Stroke="#59334155" StrokeThickness="1.2" />
                                <Canvas x:Name="PART_FanB" Canvas.Left="142" Canvas.Top="26" Opacity="0.75">
                                    <Canvas.RenderTransform><RotateTransform Angle="0" /></Canvas.RenderTransform>
                                    <Path Data="M0,-14 C5,-8 5,-3 0,0 C-5,-3 -5,-8 0,-14 Z" Fill="#5B6B7E" />
                                    <Path Data="M0,-14 C5,-8 5,-3 0,0 C-5,-3 -5,-8 0,-14 Z" Fill="#5B6B7E">
                                        <Path.RenderTransform><RotateTransform Angle="120" /></Path.RenderTransform>
                                    </Path>
                                    <Path Data="M0,-14 C5,-8 5,-3 0,0 C-5,-3 -5,-8 0,-14 Z" Fill="#5B6B7E">
                                        <Path.RenderTransform><RotateTransform Angle="240" /></Path.RenderTransform>
                                    </Path>
                                    <Ellipse Width="5" Height="5" Canvas.Left="-2.5" Canvas.Top="-2.5" Fill="#475569" />
                                </Canvas>
                            </Canvas>

                            <!-- 温度行 -->
                            <Grid Grid.Row="2" Margin="0,6,0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="设置温度" FontSize="9.5"
                                           Foreground="{DynamicResource GcTextSecondaryBrush}"
                                           VerticalAlignment="Center" Margin="0,0,6,0" />
                                <controls:GcNumericBox Grid.Column="1" Height="24"
                                           Minimum="-10" Maximum="60" Increment="0.5" DecimalPlaces="1"
                                           Value="{Binding SetTemp, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" />
                                <TextBlock Grid.Column="2" Text="实际温度" FontSize="9.5"
                                           Foreground="{DynamicResource GcTextSecondaryBrush}"
                                           VerticalAlignment="Center" Margin="10,0,6,0" />
                                <Border Grid.Column="3" Height="24" CornerRadius="4" Background="#14334155"
                                        BorderBrush="#33334155" BorderThickness="1">
                                    <TextBlock x:Name="PART_ActualText" FontSize="13" FontWeight="Bold"
                                               Foreground="{DynamicResource GcTextBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Text="{Binding ActualTemp, RelativeSource={RelativeSource TemplatedParent}, StringFormat={}{0:0.0}°C}" />
                                </Border>
                            </Grid>

                            <!-- 控制行：电源开关 -->
                            <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,8,0,0">
                                <ToggleButton Cursor="Hand"
                                              IsChecked="{Binding IsRunning, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                              Width="52" Height="24">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border x:Name="Track" CornerRadius="12" Background="#22334155"
                                                        BorderBrush="{DynamicResource GcEdgeHighlightBrush}" BorderThickness="1">
                                                    <Grid>
                                                        <TextBlock x:Name="Txt" Text="OFF" FontSize="8" FontWeight="Bold"
                                                                   Foreground="{DynamicResource GcTextSecondaryBrush}"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        <Ellipse x:Name="Knob" Width="18" Height="18" Fill="#A8C0CB"
                                                                 HorizontalAlignment="Left" Margin="3,0,0,0" />
                                                    </Grid>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter TargetName="Track" Property="Background" Value="#35D07F" />
                                                        <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                                                        <Setter TargetName="Txt" Property="Text" Value="ON" />
                                                        <Setter TargetName="Txt" Property="Foreground" Value="#0A0A0A" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>
                                    <TextBlock x:Name="PART_StatusText" Text="已停止" FontSize="9.5"
                                               Foreground="{DynamicResource GcTextSecondaryBrush}"
                                               VerticalAlignment="Center" Margin="8,0,0,0" />
                                </StackPanel>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- 运行：电源灯亮 + 风扇旋转 + 状态 -->
                        <Trigger Property="IsRunning" Value="True">
                            <Setter TargetName="PART_PowerDot" Property="Fill" Value="#35D07F" />
                            <Setter TargetName="PART_StatusText" Property="Text" Value="运行中" />
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="FanStoryboard">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="PART_FanA"
                                                         Storyboard.TargetProperty="RenderTransform.Angle"
                                                         From="0" To="360" Duration="0:0:1.2" />
                                        <DoubleAnimation Storyboard.TargetName="PART_FanB"
                                                         Storyboard.TargetProperty="RenderTransform.Angle"
                                                         From="0" To="360" Duration="0:0:1.2" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <StopStoryboard BeginStoryboardName="FanStoryboard" />
                            </Trigger.ExitActions>
                        </Trigger>
                        <!-- 报警：红色警示 + 报警灯闪烁 -->
                        <Trigger Property="IsFault" Value="True">
                            <Setter TargetName="PART_AlarmDot" Property="Fill" Value="#FF5555" />
                            <Setter TargetName="PART_ActualText" Property="Foreground" Value="#FF7A7A" />
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="AlarmBlink">
                                    <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                        <DoubleAnimation Storyboard.TargetName="PART_AlarmDot"
                                                         Storyboard.TargetProperty="Opacity"
                                                         From="1" To="0.2" Duration="0:0:0.4" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <StopStoryboard BeginStoryboardName="AlarmBlink" />
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
