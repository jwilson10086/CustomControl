<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:GeneralControl.Controls">

    <!--
        ================================================================
        文件说明：Themes\Steel\Controls\TabItem.xaml
        TabItem 选项卡页样式（选中时蓝色强调 + 投影）。

        依赖：Brushes.xaml（画刷资源）。
        ================================================================
    -->

    <Style TargetType="controls:GcTabItem">
        <Setter Property="Foreground" Value="{DynamicResource GcTextSecondaryBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="controls:GcTabItem">
                    <Border x:Name="Root"
                            Background="Transparent"
                            CornerRadius="9"
                            Padding="16,8"
                            Margin="2,0">
                        <ContentPresenter ContentSource="Header"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="#1C334155" />
                            <Setter Property="Foreground" Value="{DynamicResource GcTextBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource GcAccentBrush}" />
                            <Setter TargetName="Root" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect BlurRadius="12"
                                                      ShadowDepth="2"
                                                      Opacity="0.5"
                                                      Color="#2FBF63" />
                                </Setter.Value>
                            </Setter>
                            <Setter Property="Foreground" Value="#1F2937" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>









