<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>CustomControl</RootNamespace>
    <AssemblyName>CustomControl</AssemblyName>
    <Version>1.0.0</Version>
    <Authors>CustomControl</Authors>
    <Description>毛玻璃 (Glassmorphism) 质感 WPF 控件库与演示：窗体、页面、按钮、输入框、复选框、标签、开关、数据表格等，支持液体玻璃着色器、系统亚克力/Mica 与 3D 倾斜效果。</Description>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Effects\GlassyEffect.ps" />
  </ItemGroup>

</Project>
