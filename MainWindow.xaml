                                    <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            Style="{StaticResource SampleTagStyle}"
                                            Text="升降" />
                                        <controls:GcSlider
                                            Width="150"
                                            Margin="8,0,0,0"
                                            VerticalAlignment="Center"
                                            Maximum="100"
                                            Minimum="0"
                                            Value="{Binding HeadLift, ElementName=DemoPlating, Mode=TwoWay}" />
