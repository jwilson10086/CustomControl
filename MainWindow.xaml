<controls:GcWindow
    x:Class="GeneralControl.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:GeneralControl.Controls"
    xmlns:effects="clr-namespace:GeneralControl.Effects"
    xmlns:wafers="clr-namespace:CustomControls.Controls"
    Title="GeneralControl · 毛玻璃控件库"
    Width="1280"
    Height="860"
    Backdrop="Simulated"
    GlassOpacity="0.24"
    WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!--  分区大标题  -->
        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource GcTextBrush}" />
            <Setter Property="Margin" Value="0,0,0,2" />
        </Style>
        <!--  分区说明文字  -->
        <Style x:Key="SectionDescStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="{DynamicResource GcTextSecondaryBrush}" />
            <Setter Property="Margin" Value="0,0,0,18" />
        </Style>
        <!--
            统一卡片：全宽、统一间距。
            必须基于隐式样式派生（BasedOn），否则显式样式会顶掉隐式样式，
            Card 将拿不到模板而渲染为空白。
        -->
        <Style
            x:Key="DemoCardStyle"
            BasedOn="{StaticResource {x:Type controls:GcCard}}"
            TargetType="controls:GcCard">
            <Setter Property="Margin" Value="0,0,0,16" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
        <!--  卡片内示例行  -->
        <Style x:Key="DemoRowStyle" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
        <!--  小标签（示例名）  -->
        <Style x:Key="SampleTagStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{DynamicResource GcTextSecondaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,14,0" />
        </Style>
    </Window.Resources>

    <Grid ClipToBounds="True">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="232" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!--  macOS 风格壁纸：离线预渲染位图（Assets/MacWallpaper.png），运行时仅一次贴图，无矢量/特效成本  -->
        <Image
            Grid.ColumnSpan="2"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Source="/Assets/MacWallpaper.png"
            Stretch="UniformToFill" />

        <!--  ================= 左侧导航栏 =================  -->
        <Border
            Grid.Column="0"
            Background="{DynamicResource GcBackdropBrush}"
            BorderBrush="{DynamicResource GcBorderBrush}"
            BorderThickness="0,0,1,0">
            <Grid Margin="16,18,16,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!--  Logo 区  -->
                <StackPanel Grid.Row="0" Margin="6,0,0,18">
                    <TextBlock
                        FontSize="19"
                        FontWeight="Bold"
                        Foreground="{DynamicResource GcTextBrush}"
                        Text="GeneralControl" />
                    <TextBlock
                        Margin="1,4,0,0"
                        FontSize="11.5"
                        Foreground="{DynamicResource GcTextSecondaryBrush}"
                        Text="毛玻璃控件库 · WPF" />
                </StackPanel>

                <!--  分类导航  -->
                <controls:GcListBox
                    x:Name="NavList"
                    Grid.Row="1"
                    Background="Transparent"
                    BorderThickness="0"
                    SelectionChanged="NavList_SelectionChanged">
                    <controls:GcListBoxItem Content="开始 Get Started" IsSelected="True" />
                    <controls:GcListBoxItem Content="按钮 Button" />
                    <controls:GcListBoxItem Content="输入 Input" />
                    <controls:GcListBoxItem Content="选择 Select" />
                    <controls:GcListBoxItem Content="滑杆与进度" />
                    <controls:GcListBoxItem Content="文本与容器" />
                    <controls:GcListBoxItem Content="导航 Navigation" />
                    <controls:GcListBoxItem Content="数据表格 DataGrid" />
                    <controls:GcListBoxItem Content="效果 Effects" />
                    <controls:GcListBoxItem Content="工业 Industrial" />
                    <controls:GcListBoxItem Content="提示与弹窗" />
                </controls:GcListBox>

                <!--  底部信息  -->
                <StackPanel Grid.Row="2" Margin="6,0,0,0">
                    <TextBlock
                        FontSize="11"
                        Foreground="{DynamicResource GcTextSecondaryBrush}"
                        Text=".NET 8 · WPF · v1.0.0" />
                </StackPanel>
            </Grid>
        </Border>

        <!--  ================= 右侧内容区 =================  -->
        <ScrollViewer
            Grid.Column="1"
            Padding="28,22,28,30"
            VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="SectionHost">

                <!--  ========== 0 开始 ==========  -->
                <StackPanel x:Name="SectionStart">
                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="开始 Get Started" />
                    <TextBlock Style="{StaticResource SectionDescStyle}" Text="窗口背景模式与全局玻璃参数。系统级材质 Acrylic / Mica 需独立窗口演示。" />

                    <controls:GcCard Header="窗口背景模式 (Window.Backdrop)" Style="{StaticResource DemoCardStyle}">
                        <StackPanel>
                            <WrapPanel>
                                <controls:GcButton
                                    Width="104"
                                    Margin="0,0,8,8"
                                    Click="BackdropAuto_Click"
                                    Content="自动 Auto" />
                                <controls:GcButton
                                    Width="104"
                                    Margin="0,0,8,8"
                                    Click="BackdropSimulated_Click"
                                    Content="模拟玻璃" />
                                <controls:GcButton
                                    Width="120"
                                    Margin="0,0,8,8"
                                    Click="BackdropGlassy_Click"
                                    Content="液体玻璃 Glassy"
                                    Style="{StaticResource GcPrimaryButtonStyle}" />
                                <controls:GcButton
                                    Width="104"
                                    Margin="0,0,8,8"
                                    Click="BackdropAcrylic_Click"
                                    Content="系统亚克力" />
                                <controls:GcButton
                                    Width="104"
                                    Margin="0,0,8,8"
                                    Click="BackdropMica_Click"
                                    Content="Mica" />
                            </WrapPanel>

                            <controls:GcSeparator Margin="0,10,0,12" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="52" />
                                </Grid.ColumnDefinitions>
                                <controls:GcTextBlock Grid.Column="0" Text="玻璃不透明度" />
                                <controls:GcSlider
                                    x:Name="OpacitySlider"
                                    Grid.Column="1"
                                    Maximum="0.5"
                                    Minimum="0.05"
                                    Value="{Binding GlassOpacity, RelativeSource={RelativeSource AncestorType=controls:GcWindow}, Mode=TwoWay}" />
                                <controls:GcTextBlock Grid.Column="2" Text="{Binding Value, ElementName=OpacitySlider, StringFormat={}{0:F2}}" />
                            </Grid>
                        </StackPanel>
                    </controls:GcCard>

                    <controls:GcCard Header="关于本库" Style="{StaticResource DemoCardStyle}">

                        <StackPanel>
                            <controls:GcTextBlock FontSize="13" Text="GeneralControl 是一套毛玻璃 (Glassmorphism) 质感的 WPF 控件库：支持液体玻璃着色器、系统亚克力 / Mica、模拟玻璃三种渲染路径，内置 25+ 控件与 3D 倾斜、鱼眼等附加效果。" />
                            <controls:GcSeparator Margin="0,12,0,12" />
                            <WrapPanel>
                                <controls:GcPanel
                                    Margin="0,0,8,8"
                                    Padding="10,5"
                                    CornerRadius="8">
                                    <controls:GcTextBlock FontSize="11.5" Text="液体玻璃 Glassy" />
                                </controls:GcPanel>
                                <controls:GcPanel
                                    Margin="0,0,8,8"
                                    Padding="10,5"
                                    CornerRadius="8">
                                    <controls:GcTextBlock FontSize="11.5" Text="系统亚克力 Acrylic" />
                                </controls:GcPanel>
                                <controls:GcPanel
                                    Margin="0,0,8,8"
                                    Padding="10,5"
                                    CornerRadius="8">
                                    <controls:GcTextBlock FontSize="11.5" Text="Mica" />
                                </controls:GcPanel>
                                <controls:GcPanel
                                    Margin="0,0,8,8"
                                    Padding="10,5"
                                    CornerRadius="8">
                                    <controls:GcTextBlock FontSize="11.5" Text="模拟玻璃 Simulated" />
                                </controls:GcPanel>
                            </WrapPanel>
                        </StackPanel>
                    </controls:GcCard>
                </StackPanel>

                <!--  ========== 1 按钮 ==========  -->
                <StackPanel x:Name="SectionButton" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="按钮 Button" />
                    <TextBlock Style="{StaticResource SectionDescStyle}" Text="按钮、可选中按钮与开关。悬停查看边框高光反馈。" />

                    <controls:GcCard Header="Button 按钮状态" Style="{StaticResource DemoCardStyle}">
                        <StackPanel>
                            <WrapPanel>
                                <controls:GcButton
                                    Width="110"
                                    Margin="0,0,10,8"
                                    Content="默认按钮" />
                                <controls:GcButton
                                    Width="110"
                                    Margin="0,0,10,8"
                                    Content="主要按钮"
                                    Style="{StaticResource GcPrimaryButtonStyle}" />
                                <controls:GcButton
                                    Width="110"
                                    Margin="0,0,10,8"
                                    Content="幽灵按钮"
                                    Style="{StaticResource GcGhostButtonStyle}" />
                                <controls:GcButton
                                    Width="110"
                                    Margin="0,0,10,8"
                                    Content="禁用按钮"
                                    IsEnabled="False" />
                            </WrapPanel>
                        </StackPanel>
                    </controls:GcCard>

                    <controls:GcCard Header="ToggleButton / ToggleSwitch 开关" Style="{StaticResource DemoCardStyle}">
                        <WrapPanel>
                            <controls:GcToggleButton
                                Width="160"
                                Margin="0,0,12,8"
                                Content="切换按钮（可选中）" />
                            <controls:GcToggleSwitch
                                Width="170"
                                Margin="0,0,12,8"
                                Content="开关 ToggleSwitch" />
                            <controls:GcToggleSwitch
                                Width="150"
                                Margin="0,0,12,8"
                                Content="默认开启"
                                IsChecked="True" />
                        </WrapPanel>
                    </controls:GcCard>

                    <controls:GcCard Header="Badge 徽标（附加属性，可贴任意控件右上角）" Style="{StaticResource DemoCardStyle}">
                        <StackPanel>
                            <StackPanel Style="{StaticResource DemoRowStyle}">
                                <controls:GcButton
                                    Width="96"
                                    Margin="0,0,24,8"
                                    controls:GcBadge.Badge="99+"
                                    Content="消息" />
                                <controls:GcButton
                                    Width="96"
                                    Margin="0,0,24,8"
                                    controls:GcBadge.Badge="5"
                                    controls:GcBadge.MaxCount="99"
                                    Content="待办" />
                                <controls:GcButton
                                    Width="96"
                                    Margin="0,0,24,8"
                                    controls:GcBadge.IsDot="True"
                                    Content="通知" />
                                <controls:GcAvatar
                                    VerticalAlignment="Center"
                                    controls:GcBadge.Background="#4FB6FF"
                                    controls:GcBadge.Badge="VIP"
                                    Diameter="40"
                                    Text="Z" />
                            </StackPanel>
                            <controls:GcTextBlock
                                FontSize="11.5"
                                Foreground="{DynamicResource GcTextSecondaryBrush}"
                                Text="用法：controls:GcBadge.Badge=&quot;内容&quot; / IsDot / MaxCount，支持自定义颜色。" />
                        </StackPanel>
                    </controls:GcCard>
                </StackPanel>

                <!--  ========== 2 输入 ==========  -->
                <StackPanel x:Name="SectionInput" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="输入 Input" />
                    <TextBlock Style="{StaticResource SectionDescStyle}" Text="文本框、密码框、下拉框与软键盘。点击带键盘图标的输入框会弹出屏幕键盘。" />

                    <controls:GcCard Header="TextBox / PasswordBox" Style="{StaticResource DemoCardStyle}">
                        <StackPanel>
                            <StackPanel Style="{StaticResource DemoRowStyle}">
                                <TextBlock Style="{StaticResource SampleTagStyle}" Text="文本框" />
                                <controls:GcTextBox
                                    Width="300"
                                    HorizontalAlignment="Left"
                                    Placeholder="请输入用户名 / 邮箱" />
                            </StackPanel>
                            <StackPanel Style="{StaticResource DemoRowStyle}">
                                <TextBlock Style="{StaticResource SampleTagStyle}" Text="密码框" />
                                <PasswordBox
                                    Width="300"
                                    HorizontalAlignment="Left"
                                    controls:GcPasswordBox.IsPasswordVisible="True"
                                    controls:GcPasswordBox.Placeholder="请输入密码"
                                    Style="{StaticResource PasswordBoxStyle}" />
                            </StackPanel>
                        </StackPanel>
                    </controls:GcCard>

                    <controls:GcCard Header="ComboBox 下拉选择框" Style="{StaticResource DemoCardStyle}">
                        <StackPanel>
                            <StackPanel Style="{StaticResource DemoRowStyle}">
                                <TextBlock Style="{StaticResource SampleTagStyle}" Text="下拉框" />
                                <controls:GcComboBox
                                    Width="300"
                                    HorizontalAlignment="Left"
                                    SelectedIndex="0">
                                    <controls:GcComboBoxItem Content="液体玻璃 Glassy" />
                                    <controls:GcComboBoxItem Content="系统亚克力 Acrylic" />
                                    <controls:GcComboBoxItem Content="Mica" />
                                    <controls:GcComboBoxItem Content="模拟玻璃 Simulated" />
                                </controls:GcComboBox>
                            </StackPanel>
                        </StackPanel>
                    </controls:GcCard>

                    <controls:GcCard Header="NumericBox 数字输入框" Style="{StaticResource DemoCardStyle}">
                        <StackPanel>
                            <StackPanel Style="{StaticResource DemoRowStyle}">
                                <TextBlock Style="{StaticResource SampleTagStyle}" Text="整数" />
                                <controls:GcNumericBox
                                    Width="160"
                                    Margin="0,0,24,8"
                                    HorizontalAlignment="Left"
                                    Maximum="10"
                                    Minimum="0"
                                    Value="5" />
                                <TextBlock Style="{StaticResource SampleTagStyle}" Text="小数（0.1 步进）" />
                                <controls:GcNumericBox
                                    Width="160"
                                    HorizontalAlignment="Left"
                                    DecimalPlaces="1"
                                    Increment="0.1"
                                    Maximum="10"
                                    Minimum="0"
                                    Value="0.5" />
                            </StackPanel>
                            <controls:GcTextBlock
                                FontSize="11.5"
                                Foreground="{DynamicResource GcTextSecondaryBrush}"
                                Text="支持直接输入（回车/失焦提交）、上下方向键与按住按钮连发；越界自动夹回区间。" />
                        </StackPanel>
                    </controls:GcCard>

                    <controls:GcCard Header="Keyboard 屏幕键盘（点击输入框自动弹出）" Style="{StaticResource DemoCardStyle}">
                        <StackPanel>
                            <StackPanel Style="{StaticResource DemoRowStyle}">
                                <TextBlock Style="{StaticResource SampleTagStyle}" Text="数字键盘" />
                                <controls:GcTextBox
                                    Width="300"
                                    HorizontalAlignment="Left"
                                    controls:GcKeyboard.DecimalPlaces="2"
                                    controls:GcKeyboard.KeyboardType="Numeric"
                                    controls:GcKeyboard.ShowKeyboard="True"
                                    Placeholder="点击此输入框弹出数字键盘" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource SampleTagStyle}" Text="全键盘" />
                                <controls:GcTextBox
                                    Width="300"
                                    HorizontalAlignment="Left"
                                    controls:GcKeyboard.KeyboardType="Full"
                                    controls:GcKeyboard.ShowKeyboard="True"
                                    Placeholder="点击此输入框弹出全键盘（26 键 QWERTY）" />
                            </StackPanel>
                        </StackPanel>
                    </controls:GcCard>
                </StackPanel>

                <!--  ========== 3 选择 ==========  -->
                <StackPanel x:Name="SectionSelect" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="选择 Select" />
                    <TextBlock Style="{StaticResource SectionDescStyle}" Text="复选框与单选框，含默认选中与禁用态。" />

                    <controls:GcCard Header="CheckBox 复选框" Style="{StaticResource DemoCardStyle}">
                        <StackPanel>
                            <controls:GcCheckBox Margin="0,0,0,8" Content="复选框 A（可选）" />
                            <controls:GcCheckBox
                                Margin="0,0,0,8"
                                Content="复选框 B（默认选中）"
                                IsChecked="True" />
                            <controls:GcCheckBox Content="复选框 C（禁用）" IsEnabled="False" />
                        </StackPanel>
                    </controls:GcCard>

                    <controls:GcCard Header="RadioButton 单选框" Style="{StaticResource DemoCardStyle}">
                        <StackPanel Orientation="Horizontal">
                            <controls:GcRadioButton
                                Margin="0,0,18,0"
                                Content="单选框 1"
                                GroupName="g1"
                                IsChecked="True" />
                            <controls:GcRadioButton
                                Margin="0,0,18,0"
                                Content="单选框 2"
                                GroupName="g1" />
                            <controls:GcRadioButton Content="单选框 3" GroupName="g1" />
                        </StackPanel>
                    </controls:GcCard>
                </StackPanel>

                <!--  ========== 4 滑杆与进度 ==========  -->
                <StackPanel x:Name="SectionProgress" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="滑杆与进度 Slider &amp; Progress" />
                    <TextBlock Style="{StaticResource SectionDescStyle}" Text="拖动滑杆同步进度条；下方为忙碌（不确定进度）形态。" />

                    <controls:GcCard Header="Slider / ProgressBar 联动" Style="{StaticResource DemoCardStyle}">
                        <StackPanel>
                            <controls:GcSlider
                                x:Name="ProgressSlider"
                                Maximum="100"
                                Minimum="0"
                                Value="66" />
                            <controls:GcTextBlock
                                Margin="0,4,0,10"
                                FontSize="12"
                                Text="进度同步演示" />
                            <controls:GcProgressBar Height="8" Value="{Binding Value, ElementName=ProgressSlider}" />
                        </StackPanel>
                    </controls:GcCard>

                    <controls:GcCard Header="不确定进度（忙碌指示）" Style="{StaticResource DemoCardStyle}">
                        <controls:GcProgressBar Height="8" IsIndeterminate="True" />
                    </controls:GcCard>
                </StackPanel>

                <!--  ========== 5 文本与容器 ==========  -->
                <StackPanel x:Name="SectionContainer" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="文本与容器 Text &amp; Container" />
                    <TextBlock Style="{StaticResource SectionDescStyle}" Text="标签、文本、分隔线、分组框、折叠面板与通用玻璃面板。" />

                    <controls:GcCard Header="Label / TextBlock 文本" Style="{StaticResource DemoCardStyle}">
                        <StackPanel>
                            <StackPanel Style="{StaticResource DemoRowStyle}">
                                <controls:GcLabel Content="Label 标签" />
                                <controls:GcTextBlock
                                    Margin="18,0,0,0"
                                    VerticalAlignment="Center"
                                    Text="TextBlock 文本" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <controls:GcLabel Content="水平 0°" />
                                <controls:GcLabel
                                    Margin="28,0,0,0"
                                    Angle="90"
                                    Content="旋转 90°（垂直标签）" />
                                <controls:GcLabel
                                    Margin="30,0,0,0"
                                    Angle="30"
                                    Content="倾斜 30°" />
                            </StackPanel>
                        </StackPanel>
                    </controls:GcCard>

                    <controls:GcCard Header="GroupBox / Expander / Separator / Panel 容器" Style="{StaticResource DemoCardStyle}">
                        <StackPanel>
                            <controls:GcGroupBox
                                Margin="0,0,0,10"
                                Padding="12,8"
                                Header="GroupBox 分组">
                                <controls:GcTextBlock FontSize="12.5" Text="组内的内容也会呈现毛玻璃质感" />
                            </controls:GcGroupBox>
                            <controls:GcExpander Margin="0,0,0,10" Header="Expander 折叠面板（点击展开）">
                                <controls:GcTextBlock
                                    Margin="0,8,0,0"
                                    FontSize="12.5"
                                    Text="展开后的内容区域" />
                            </controls:GcExpander>
                            <controls:GcSeparator Margin="0,0,0,10" />
                            <controls:GcPanel Padding="12,8" CornerRadius="10">
                                <controls:GcTextBlock FontSize="12.5" Text="Panel 玻璃面板（可作为任意容器使用）" />
                            </controls:GcPanel>
                        </StackPanel>
                    </controls:GcCard>

                    <controls:GcCard Header="Tag 标签（可关闭）" Style="{StaticResource DemoCardStyle}">
                        <StackPanel>
                            <WrapPanel>
                                <controls:GcTag Margin="0,0,8,8" Content="毛玻璃" />
                                <controls:GcTag Margin="0,0,8,8" Content="WPF" />
                                <controls:GcTag Margin="0,0,8,8" Content=".NET 8" />
                                <controls:GcTag
                                    Margin="0,0,8,8"
                                    Content="可关闭 ×"
                                    IsClosable="True" />
                                <controls:GcTag Margin="0,0,8,8" IsClosable="True">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse
                                            Width="7"
                                            Height="7"
                                            Margin="0,0,6,0"
                                            VerticalAlignment="Center"
                                            Fill="#4CD964" />
                                        <TextBlock FontSize="12.5" Text="在线" />
                                    </StackPanel>
                                </controls:GcTag>
                            </WrapPanel>
                            <controls:GcTextBlock
                                FontSize="11.5"
                                Foreground="{DynamicResource GcTextSecondaryBrush}"
                                Text="点击 × 关闭标签；IsClosable 控制关闭按钮，Closed 路由事件可供父容器监听。" />
                        </StackPanel>
                    </controls:GcCard>

                    <controls:GcCard Header="Avatar 头像（图片 / 文字缩写 / 状态点）" Style="{StaticResource DemoCardStyle}">
                        <StackPanel Orientation="Horizontal">
                            <controls:GcAvatar
                                Margin="0,0,14,0"
                                Diameter="44"
                                Text="张" />
                            <controls:GcAvatar
                                Margin="0,0,14,0"
                                Diameter="44"
                                IsStatusVisible="True"
                                Text="HC" />
                            <controls:GcAvatar
                                Margin="0,0,14,0"
                                CornerRadius="10"
                                Diameter="44"
                                IsStatusVisible="True"
                                StatusBrush="#F2B33C"
                                Text="OK" />
                            <controls:GcTextBlock
                                VerticalAlignment="Center"
                                FontSize="11.5"
                                Foreground="{DynamicResource GcTextSecondaryBrush}"
                                Text="圆形 / 圆角方形，右下角状态点颜色可自定义（黄=离开）" />
                        </StackPanel>
                    </controls:GcCard>
                </StackPanel>

                <!--  ========== 6 导航 ==========  -->
                <StackPanel x:Name="SectionNavigation" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource SectionTitleStyle}" Text="导航 Navigation" />
                    <TextBlock Style="{StaticResource SectionDescStyle}" Text="选项卡、列表与内嵌玻璃页面。左侧分类栏本身就是 ListBox。" />

                    <controls:GcCard Header="TabControl / ListBox / Page" Style="{StaticResource DemoCardStyle}">
                        <controls:GcTabControl>
                            <controls:GcTabItem Header="页面一">
                                <StackPanel Margin="12">
