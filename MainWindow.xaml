                    <controls:GcCard Header="PlatingChamber 水平电镀腔（升降/旋转/开合/液位/感应器）" Style="{StaticResource DemoCardStyle}">
                        <StackPanel>
                            <StackPanel VerticalAlignment="Top" Orientation="Horizontal">
                                <controls:GcPlatingChamber
                                    x:Name="DemoPlating"
                                    Width="170"
                                    Height="240"
                                    controls:GcEditor.Editing="True"
                                    HasWafer="true"
                                    HeadLift="75"
                                    Level="46"
