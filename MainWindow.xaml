                                        <TextBlock
                                            VerticalAlignment="Center"
                                            Style="{StaticResource SampleTagStyle}"
                                            Text="倾斜" />
                                        <controls:GcSlider
                                            Width="150"
                                            Margin="8,0,0,0"
                                            VerticalAlignment="Center"
                                            Maximum="20"
                                            Minimum="0"
                                            Value="{Binding Tilt, ElementName=DemoPlating, Mode=TwoWay}" />
