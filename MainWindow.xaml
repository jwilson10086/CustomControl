                                            Width="48"
                                            Margin="8,0,0,0"
                                            Click="PlatingTiltLeft_Click"
                                            Content="左倾" />
                                        <controls:GcButton
                                            Width="48"
                                            Margin="8,0,0,0"
                                            Click="PlatingTiltRight_Click"
                                            Content="右倾" />
