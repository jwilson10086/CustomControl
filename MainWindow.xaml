                                            Width="48"
                                            Margin="8,0,0,0"
                                            Click="PlatingTiltReset_Click"
                                            Content="回正" />
                                    </StackPanel>

                                    <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            Style="{StaticResource SampleTagStyle}"
                                            Text="液位" />
                                        <controls:GcSlider
                                            Width="150"
                                            Margin="8,0,0,0"
                                            VerticalAlignment="Center"
                                            Maximum="100"
                                            Minimum="0"
                                            Value="{Binding Level, ElementName=DemoPlating, Mode=TwoWay}" />
                                        <controls:GcToggleSwitch
                                            x:Name="DemoPlatingRotate"
                                            Margin="12,0,0,0"
                                            VerticalAlignment="Center"
                                            Checked="PlatingRotate_Changed"
                                            Content="旋转"
                                            Unchecked="PlatingRotate_Changed" />
                                        <controls:GcToggleSwitch
                                            x:Name="DemoPlatingOpen"
                                            Margin="12,0,0,0"
                                            VerticalAlignment="Center"
                                            Checked="PlatingOpen_Changed"
                                            Content="开合"
                                            Unchecked="PlatingOpen_Changed" />
                                    </StackPanel>

