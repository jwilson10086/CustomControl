                                <StackPanel
                                    Width="330"
                                    Margin="16,0,0,0"
                                    VerticalAlignment="Top">
                                    <StackPanel Margin="0,0,0,10" Orientation="Horizontal">
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            Style="{StaticResource SampleTagStyle}"
                                            Text="自动模拟" />
                                        <controls:GcToggleSwitch
                                            x:Name="DemoPlatingAuto"
                                            VerticalAlignment="Center"
                                            Checked="PlatingAuto_Checked"
                                            Content="盖下→下降→旋转下降→回正→旋转5秒→边转边升→停转开盖"
                                            Unchecked="PlatingAuto_Unchecked" />
