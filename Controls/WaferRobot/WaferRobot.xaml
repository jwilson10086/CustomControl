<local:ComponentBase
    x:Class="CustomControls.Controls.WaferRobot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:CustomControls.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:Name="root"
    mc:Ignorable="d">

    <local:ComponentBase.Resources>
        <BooleanToVisibilityConverter x:Key="b2v" />

        <Style x:Key="DeleteButtonStyle" TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            Name="root"
                            Background="#55000000"
                            CornerRadius="11">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="root" Property="Background" Value="#88000000" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <LinearGradientBrush x:Key="RobotArmGradient" StartPoint="0,0.5" EndPoint="1,0.5">
            <GradientStop Offset="0" Color="#FFD0D0D0" />
            <GradientStop Offset="0.5" Color="#FFF5F5F5" />
            <GradientStop Offset="1" Color="#F6F6F6" />
        </LinearGradientBrush>

        <RadialGradientBrush x:Key="RobotBaseGradient">
            <GradientStop Offset="0" Color="#E4E7EB" />
            <GradientStop Offset="1" Color="#FFA0A0A0" />
        </RadialGradientBrush>

        <RadialGradientBrush x:Key="RobotJointGradient">
            <GradientStop Offset="0.0" Color="#FFE9EEF2" />
            <GradientStop Offset="0.9" Color="#FFB5C2CB" />
            <GradientStop Offset="1" Color="#FF808080" />
        </RadialGradientBrush>

        <SolidColorBrush x:Key="ToolFill" Color="#C0C0C0" />
    </local:ComponentBase.Resources>

    <Grid MouseRightButtonUp="OnRobotRightClick">
        <Viewbox Stretch="Uniform">
            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                <Canvas
                    Width="240"
                    Height="255"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">

                    <Canvas
                        x:Name="BaseRotationContainer"
                        Canvas.Left="120"
                        Canvas.Top="127.5">
                        <Canvas.RenderTransform>
                            <TransformGroup>
                                <TranslateTransform />
                                <ScaleTransform />
                                <RotateTransform x:Name="BaseRotate" Angle="{Binding BaseAngle, ElementName=root}" />
                            </TransformGroup>
                        </Canvas.RenderTransform>

                        <Ellipse
                            Canvas.Left="-50"
                            Canvas.Top="-50"
                            Width="100"
                            Height="100"
                            Fill="{StaticResource RobotBaseGradient}" />

                        <!--  ====== LEFT ARM (Arm1) ======  -->
                        <Canvas
                            x:Name="Arm1_1"
                            Canvas.Left="-34"
                            Canvas.Top="0"
                            Panel.ZIndex="1"
                            RenderTransformOrigin="0,0">
                            <Canvas.RenderTransform>
                                <TransformGroup>
                                    <TranslateTransform />
                                    <ScaleTransform />
                                    <RotateTransform Angle="75" />
                                    <RotateTransform x:Name="Arm1_1_Rotate" Angle="{Binding Arm1_1Angle, ElementName=root}" />
                                </TransformGroup>
                            </Canvas.RenderTransform>

                            <Ellipse
                                Canvas.Left="-34"
                                Canvas.Top="-34"
                                Width="68"
                                Height="68"
                                Fill="{StaticResource RobotJointGradient}"
                                Stroke="#FF666666"
                                StrokeThickness="1" />

                            <Path
                                Data="M 34 0 L 28 200 L -28 200 L -34 0 A 34 34 -270 0 1 34 0 Z"
                                Fill="{StaticResource RobotArmGradient}"
                                Stroke="#FF666666"
                                StrokeLineJoin="Round"
                                StrokeThickness="1" />

                            <Canvas
                                x:Name="Arm1_2"
                                Canvas.Left="0"
                                Canvas.Top="200"
                                Panel.ZIndex="10"
                                RenderTransformOrigin="0,0">
                                <Canvas.RenderTransform>
                                    <TransformGroup>
                                        <TranslateTransform />
                                        <ScaleTransform />
                                        <RotateTransform Angle="-150" />
                                        <RotateTransform x:Name="Arm1_2_Rotate" Angle="{Binding Arm1_2Angle, ElementName=root}" />
                                    </TransformGroup>
                                </Canvas.RenderTransform>

                                <Ellipse
                                    Canvas.Left="-28"
                                    Canvas.Top="-28"
                                    Width="56"
                                    Height="56"
                                    Fill="{StaticResource RobotJointGradient}"
                                    Stroke="#FF666666"
                                    StrokeThickness="1" />

                                <Path
                                    Data="M 28 0 L 28 234 L -28 234 L -28 0 A 28 28 90 0 1 28 0 Z"
                                    Fill="{StaticResource RobotArmGradient}"
                                    Stroke="#FF666666"
                                    StrokeLineJoin="Round"
                                    StrokeThickness="1" />

                                <Canvas
                                    x:Name="Arm1_3"
                                    Canvas.Left="0"
                                    Canvas.Top="236"
                                    Panel.ZIndex="20"
                                    RenderTransformOrigin="0,0">
                                    <Canvas.RenderTransform>
                                        <TransformGroup>
                                            <TranslateTransform />
                                            <ScaleTransform />
                                            <RotateTransform Angle="75" />
                                            <RotateTransform x:Name="Arm1_3_Rotate" Angle="{Binding Arm1_3Angle, ElementName=root}" />
                                        </TransformGroup>
                                    </Canvas.RenderTransform>

                                    <Path
                                        Data="M 38 -80 L -38 -80 L -38 0 A 38 38 270 0 0 38 1 Z"
                                        Fill="{StaticResource RobotArmGradient}"
                                        Stroke="#FF666666"
                                        StrokeThickness="1" />
                                    <Ellipse
                                        Canvas.Left="-15"
                                        Canvas.Top="-15"
                                        Width="30"
                                        Height="30"
                                        Fill="{StaticResource RobotJointGradient}" />
                                    <Path
                                        Canvas.Left="0"
                                        Canvas.Top="-80"
                                        Data="M -20 0 L -20 -120 L -30 -140 L -30 -220 L -20 -220 L -10 -180 L 10 -180 L 20 -220 L 30 -220 L 30 -140 L 20 -120 L 20 0 Z"
                                        Fill="{StaticResource ToolFill}"
                                        Stroke="#FF666666"
                                        StrokeThickness="1" />
                                    <local:WaferControl
                                        x:Name="WaferCtrl_Lower"
                                        Canvas.Left="-60"
                                        Canvas.Top="-300"
                                        Width="120"
                                        Height="120"
                                        FontColor="Black"
                                        Status="Fail"
                                        WaferFontFamily="Consolas"
                                        WaferFontSize="18"
                                        WaferFontWeight="Bold"
                                        WaferLabel="LOT234-25"
                                        WaferVisible="True" />
                                </Canvas>
                            </Canvas>
                        </Canvas>

                        <!--  ====== RIGHT ARM (Arm2) — mirror container ======  -->
                        <Canvas Canvas.Left="0" Panel.ZIndex="1">
                            <Canvas.RenderTransform>
                                <ScaleTransform ScaleX="-1" />
                            </Canvas.RenderTransform>

                            <Canvas
                                x:Name="Arm2_1"
                                Canvas.Left="-34"
                                Canvas.Top="0"
                                Panel.ZIndex="1"
                                RenderTransformOrigin="0,0">
                                <Canvas.RenderTransform>
                                    <TransformGroup>
                                        <TranslateTransform />
                                        <ScaleTransform />
                                        <RotateTransform Angle="75" />
                                        <RotateTransform x:Name="Arm2_1_Rotate" Angle="{Binding Arm2_1Angle, ElementName=root}" />
                                    </TransformGroup>
                                </Canvas.RenderTransform>

                                <Ellipse
                                    Canvas.Left="-34"
                                    Canvas.Top="-34"
                                    Width="68"
                                    Height="68"
                                    Fill="{StaticResource RobotJointGradient}"
                                    Stroke="#FF666666"
                                    StrokeThickness="1" />

                                <Path
                                    Data="M 34 0 L 28 200 L -28 200 L -34 0 A 34 34 -270 0 1 34 0 Z"
                                    Fill="{StaticResource RobotArmGradient}"
                                    Stroke="#FF666666"
                                    StrokeLineJoin="Round"
                                    StrokeThickness="1" />

                                <Canvas
                                    x:Name="Arm2_2"
                                    Canvas.Left="0"
                                    Canvas.Top="200"
                                    Panel.ZIndex="10"
                                    RenderTransformOrigin="0,0">
                                    <Canvas.RenderTransform>
                                        <TransformGroup>
                                            <TranslateTransform />
                                            <ScaleTransform />
                                            <RotateTransform Angle="-150" />
                                            <RotateTransform x:Name="Arm2_2_Rotate" Angle="{Binding Arm2_2Angle, ElementName=root}" />
                                        </TransformGroup>
                                    </Canvas.RenderTransform>

                                    <Ellipse
                                        Canvas.Left="-28"
                                        Canvas.Top="-28"
                                        Width="56"
                                        Height="56"
                                        Fill="{StaticResource RobotJointGradient}"
                                        Stroke="#FF666666"
                                        StrokeThickness="1" />

                                    <Path
                                        Data="M 28 0 L 28 234 L -28 234 L -28 0 A 28 28 90 0 1 28 0 Z"
                                        Fill="{StaticResource RobotArmGradient}"
                                        Stroke="#FF666666"
                                        StrokeLineJoin="Round"
                                        StrokeThickness="1" />

                                    <Canvas
                                        x:Name="Arm2_3"
                                        Canvas.Left="0"
                                        Canvas.Top="236"
                                        Panel.ZIndex="20"
                                        RenderTransformOrigin="0,0">
                                        <Canvas.RenderTransform>
                                            <TransformGroup>
                                                <TranslateTransform />
                                                <ScaleTransform />
                                                <RotateTransform Angle="75" />
                                                <RotateTransform x:Name="Arm2_3_Rotate" Angle="{Binding Arm2_3Angle, ElementName=root}" />
                                            </TransformGroup>
                                        </Canvas.RenderTransform>

                                        <Path
                                            Data="M 38 -80 L -38 -80 L -38 0 A 38 38 270 0 0 38 1 Z"
                                            Fill="{StaticResource RobotArmGradient}"
                                            Stroke="#FF666666"
                                            StrokeThickness="1" />
                                        <Ellipse
                                            Canvas.Left="-15"
                                            Canvas.Top="-15"
                                            Width="30"
                                            Height="30"
                                            Fill="{StaticResource RobotJointGradient}" />
                                        <Path
                                            Canvas.Left="0"
                                            Canvas.Top="-80"
                                            Data="M -20 0 L -20 -120 L -30 -140 L -30 -220 L -20 -220 L -10 -180 L 10 -180 L 20 -220 L 30 -220 L 30 -140 L 20 -120 L 20 0 Z"
                                            Fill="{StaticResource ToolFill}"
                                            Stroke="#FF666666"
                                            StrokeThickness="1" />
                                        <local:WaferControl
                                            x:Name="WaferCtrl_Upper"
                                            Canvas.Left="-60"
                                            Canvas.Top="-300"
                                            Width="120"
                                            Height="120"
                                            FontColor="Black"
                                            Status="Completed"
                                            WaferFontFamily="Consolas"
                                            WaferFontSize="18"
                                            WaferFontWeight="Bold"
                                            WaferLabel="LOT123-25"
                                            WaferVisible="True" />
                                    </Canvas>
                                </Canvas>
                            </Canvas>
                        </Canvas>

                    </Canvas>
                </Canvas>
            </Grid>
        </Viewbox>

        <Border
            Margin="4"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Bottom"
            Background="#30000000"
            CornerRadius="4">
            <TextBlock
                x:Name="AnglesText"
                Padding="2,2"
                FontFamily="Consolas"
                FontSize="10"
                Foreground="#B0FFFFFF"
                Text="J1:0  J2:0  J3:0  J4:0  J5:0  J6:0  J7:0  J8:0"
                TextAlignment="Center" />
        </Border>

        <Grid Visibility="{Binding IsSelected, Converter={StaticResource b2v}, ElementName=root}">
            <Rectangle
                RadiusX="5"
                RadiusY="5"
                Stroke="#AAA"
                StrokeDashArray="3,3" />
            <Ellipse
                Width="10"
                Height="10"
                Margin="-5"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Cursor="SizeWE"
                Fill="White"
                MouseLeftButtonDown="Ellipse_MouseLeftButtonDown"
                MouseLeftButtonUp="Ellipse_MouseLeftButtonUp"
                MouseMove="Ellipse_MouseMove"
                Stroke="#AAA" />
            <Ellipse
                Width="10"
                Height="10"
                Margin="-5"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Cursor="SizeNS"
                Fill="White"
                MouseLeftButtonDown="Ellipse_MouseLeftButtonDown"
                MouseLeftButtonUp="Ellipse_MouseLeftButtonUp"
                MouseMove="Ellipse_MouseMove"
                Stroke="#AAA" />
        </Grid>

        <Button
            Width="22"
            Height="22"
            Margin="0,0,-25,0"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Click="Button_Click"
            Style="{StaticResource DeleteButtonStyle}"
            Visibility="{Binding IsSelected, Converter={StaticResource b2v}, ElementName=root}">
            <Grid Width="12" Height="12">
                <Path
                    Data="M0 0 10 10M10 0 0 10"
                    Stretch="Fill"
                    Stroke="Red"
                    StrokeThickness="1" />
            </Grid>
        </Button>
    </Grid>

</local:ComponentBase>
