<Window x:Class="GeneralControl.Controls.GcForwardRobotPanel"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="268"
        SizeToContent="Height"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStyle="None">

    <!--
        ================================================================
        GcForwardRobot 右键浮出控制面板。
        参照演示区第一个机械手 WaferRobot 的 FloatingPanel：独立置顶浮窗、
        工业风配色、可拖动。因为是独立浮窗拿不到主题字典，本文件自带一套
        控件样式（下方 Window.Resources），不依赖 Gc* 资源。

        面板内容：
        - 姿态下拉：18 个预设姿态，与 Pose 枚举一一对应；
        - 夹片开关：底座料仓 / X1 叉手 / X2 叉手；
        - 快捷位：原点、取片、对位、缓存；
        - 实时读数：X1~X4 四段关节角（过渡动画中连续变化）。
        ================================================================
    -->

    <Window.Resources>

        <!--  面板阴影  -->
        <DropShadowEffect x:Key="PanelShadow"
                          BlurRadius="18"
                          Direction="270"
                          Opacity="0.22"
                          ShadowDepth="3" />

        <!--  主按钮：蓝底白字  -->
        <Style x:Key="PanelBtn" TargetType="Button">
            <Setter Property="Background" Value="#2F6FB5" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3E86D6" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#215C99" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  次按钮：浅底描边  -->
        <Style x:Key="PanelBtnGhost"
               BasedOn="{StaticResource PanelBtn}"
               TargetType="Button">
            <Setter Property="Background" Value="#EDF1F5" />
            <Setter Property="Foreground" Value="#33414F" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="#C3CCD5"
                                BorderThickness="1"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#DCE6EF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#C7D6E4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  姿态下拉  -->
        <Style x:Key="PanelCombo" TargetType="ComboBox">
            <Setter Property="Height" Value="30" />
            <Setter Property="Margin" Value="0,3" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="#26313C" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#C3CCD5" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="26" />
                            </Grid.ColumnDefinitions>

                            <Border x:Name="Bd"
                                    Grid.ColumnSpan="2"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="5" />

                            <ContentPresenter Margin="8,0,26,0"
                                              VerticalAlignment="Center"
                                              Content="{TemplateBinding SelectionBoxItem}" />

                            <Path Grid.Column="1"
                                  Margin="0,0,9,0"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Data="M0 0 L5 5 L10 0 Z"
                                  Fill="#5A6875" />

                            <ToggleButton Grid.ColumnSpan="2"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          ClickMode="Press"
                                          Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}" />

                            <Popup AllowsTransparency="True"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   PopupAnimation="Fade">
                                <Border Margin="0,3,0,0"
                                        Padding="3"
                                        Background="#FFFFFF"
                                        BorderBrush="#C3CCD5"
                                        BorderThickness="1"
                                        CornerRadius="5">
                                    <ScrollViewer MaxHeight="260">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#2F6FB5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  下拉项  -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="#26313C" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd"
                                Padding="{TemplateBinding Padding}"
                                Background="Transparent">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E8F0F8" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2F6FB5" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  复选框  -->
        <Style x:Key="PanelCheck" TargetType="CheckBox">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="#33414F" />
            <Setter Property="Margin" Value="0,5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="Box"
                                    Width="15"
                                    Height="15"
                                    VerticalAlignment="Center"
                                    Background="#FFFFFF"
                                    BorderBrush="#9AA7B2"
                                    BorderThickness="1.2"
                                    CornerRadius="3">
                                <Path x:Name="Tick"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Data="M0 0 L3.2 3.4 L7.6 -3.4"
                                      Stroke="#FFFFFF"
                                      StrokeEndLineCap="Round"
                                      StrokeStartLineCap="Round"
                                      StrokeThickness="1.8"
                                      Visibility="Collapsed" />
                            </Border>
                            <ContentPresenter Margin="7,0,0,0"
                                              VerticalAlignment="Center" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="#2F6FB5" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="#2F6FB5" />
                                <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="#2F6FB5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Border Margin="8"
            Background="#FAFAFB"
            BorderBrush="#3C4650"
            BorderThickness="1.2"
            CornerRadius="10"
            Effect="{StaticResource PanelShadow}">

        <StackPanel Margin="14">

            <!--  标题栏：按住可拖动面板  -->
            <Grid x:Name="PART_DragBar"
                  Margin="-14,-14,-14,10"
                  Background="Transparent"
                  Cursor="SizeAll"
                  MouseLeftButtonDown="OnDragBarMouseDown">
                <TextBlock Margin="14,12,14,10"
                           FontSize="15"
                           FontWeight="Bold"
                           Foreground="#2B3540"
                           Text="ForwardRobot 控制面板" />
            </Grid>

            <!--  姿态  -->
            <TextBlock FontSize="12"
                       FontWeight="SemiBold"
                       Foreground="#5A6875"
                       Text="姿态" />
            <ComboBox x:Name="CmbPose"
                      Style="{StaticResource PanelCombo}"
                      SelectionChanged="OnPoseSelected" />

            <Separator Margin="0,10,0,8" />

            <!--  夹片  -->
            <TextBlock FontSize="12"
                       FontWeight="SemiBold"
                       Foreground="#5A6875"
                       Text="夹片状态" />
            <CheckBox x:Name="ChkMagazine"
                      Content="底座料仓有料"
                      Style="{StaticResource PanelCheck}"
                      Click="OnWaferToggled" />
            <CheckBox x:Name="ChkX1"
                      Content="X1 叉手夹持"
                      Style="{StaticResource PanelCheck}"
                      Click="OnWaferToggled" />
            <CheckBox x:Name="ChkX2"
                      Content="X2 叉手夹持"
                      Style="{StaticResource PanelCheck}"
                      Click="OnWaferToggled" />

            <Separator Margin="0,8,0,8" />

            <!--  快捷位  -->
            <TextBlock FontSize="12"
                       FontWeight="SemiBold"
                       Foreground="#5A6875"
                       Text="快捷位" />
            <UniformGrid Margin="-2,4,0,0" Columns="2">
                <Button x:Name="BtnOrigin"
                        Content="原点"
                        Tag="X1Origin"
                        Style="{StaticResource PanelBtnGhost}"
                        Click="OnQuickPose" />
                <Button x:Name="BtnLoad"
                        Content="取片"
                        Tag="X1Load1"
                        Style="{StaticResource PanelBtnGhost}"
                        Click="OnQuickPose" />
                <Button x:Name="BtnAlign"
                        Content="对位"
                        Tag="X1Align1"
                        Style="{StaticResource PanelBtnGhost}"
                        Click="OnQuickPose" />
                <Button x:Name="BtnBuffer"
                        Content="缓存"
                        Tag="X1Buffer"
                        Style="{StaticResource PanelBtnGhost}"
                        Click="OnQuickPose" />
            </UniformGrid>

            <Separator Margin="0,10,0,8" />

            <!--  实时关节角  -->
            <TextBlock FontSize="12"
                       FontWeight="SemiBold"
                       Foreground="#5A6875"
                       Text="实时关节角" />
            <UniformGrid Margin="0,5,0,0" Columns="4">
                <TextBlock HorizontalAlignment="Center"
                           FontSize="11"
                           Foreground="#8A97A3"
                           Text="X1" />
                <TextBlock HorizontalAlignment="Center"
                           FontSize="11"
                           Foreground="#8A97A3"
                           Text="X2" />
                <TextBlock HorizontalAlignment="Center"
                           FontSize="11"
                           Foreground="#8A97A3"
                           Text="X3" />
                <TextBlock HorizontalAlignment="Center"
                           FontSize="11"
                           Foreground="#8A97A3"
                           Text="X4" />
            </UniformGrid>
            <UniformGrid Margin="0,1,0,0" Columns="4">
                <TextBlock x:Name="TxtX1"
                           HorizontalAlignment="Center"
                           FontFamily="Consolas"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="#1E7A46"
                           Text="0.0°" />
                <TextBlock x:Name="TxtX2"
                           HorizontalAlignment="Center"
                           FontFamily="Consolas"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="#1E7A46"
                           Text="0.0°" />
                <TextBlock x:Name="TxtX3"
                           HorizontalAlignment="Center"
                           FontFamily="Consolas"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="#1E7A46"
                           Text="0.0°" />
                <TextBlock x:Name="TxtX4"
                           HorizontalAlignment="Center"
                           FontFamily="Consolas"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="#1E7A46"
                           Text="0.0°" />
            </UniformGrid>

            <Button Margin="0,12,0,0"
                    Content="关闭面板"
                    Style="{StaticResource PanelBtnGhost}"
                    Click="OnCloseClicked" />
        </StackPanel>
    </Border>
</Window>
